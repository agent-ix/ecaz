    { "kind": "latency", "name": "latency-dprune-off-100k", "tags": ["dense-prune-ab", "prune-off", "ec_real_100k"], "prefix": "attr_dprune_100k", "profile": "ec_ivf", "k": 10, "sweep": [8, 16, 32, 64, 128, 200], "concurrency": 1, "cache_state": "post_recall_warm", "session_gucs": ["ec_ivf.posting_bound_prune=off"] },
    { "kind": "recall", "name": "recall-dprune-on-100k", "tags": ["dense-prune-ab", "prune-on", "ec_real_100k"], "prefix": "attr_dprune_100k", "profile": "ec_ivf", "k": 10, "sweep": [8, 16, 32, 64, 128, 200], "session_gucs": ["ec_ivf.posting_bound_prune=on"] },
    { "kind": "latency", "name": "latency-dprune-on-100k", "tags": ["dense-prune-ab", "prune-on", "ec_real_100k"], "prefix": "attr_dprune_100k", "profile": "ec_ivf", "k": 10, "sweep": [8, 16, 32, 64, 128, 200], "concurrency": 1, "cache_state": "post_recall_warm", "session_gucs": ["ec_ivf.posting_bound_prune=on"] },
