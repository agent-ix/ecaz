{
  "name": "task51-local-ivf-rabitq-sidecar",
  "schema_version": 1,
  "artifact_dir": "benchmarks/task51-local-ivf-rabitq-sidecar/artifacts",
  "defaults": {
    "pg": 18,
    "socket_dir": "/home/peter/.pgrx",
    "bits": 4,
    "seed": 42,
    "queries_limit": 200,
    "force_index": true
  },
  "steps": [
    {
      "kind": "load",
      "name": "load-50k-rabitq1-n128-rerank-off",
      "tags": ["load", "ec_real_50k", "ivf", "rabitq", "sidecar", "nlists128"],
      "prefix": "task51_local_50k_ivf_rabitq1_n128_sidecar_off",
      "profile": "ec_ivf",
      "bits": 4,
      "storage_format": "rabitq",
      "corpus_file": "target/real-corpus/staged-task50/ec_real_50k_corpus.tsv",
      "queries_file": "target/real-corpus/staged-task50/ec_real_50k_queries.tsv",
      "manifest_file": "target/real-corpus/staged-task50/ec_real_50k_manifest.json",
      "allow_manifest_mismatch": true,
      "reloptions": [
        "nlists=128",
        "nprobe=128",
        "training_sample_rows=10000",
        "quant_bits=1",
        "rerank=off"
      ],
      "log_file": "benchmarks/task51-local-ivf-rabitq-sidecar/artifacts/load-50k-rabitq1-n128-rerank-off.log"
    },
    {
      "kind": "sidecar-rerank",
      "name": "sidecar-50k-rabitq1-n128-k50",
      "tags": ["sidecar", "ec_real_50k", "ivf", "rabitq", "nlists128"],
      "prefix": "task51_local_50k_ivf_rabitq1_n128_sidecar_off",
      "profile": "ec_ivf",
      "k": 10,
      "candidate_k": 50,
      "sweep": [32, 64, 96, 128],
      "variants": ["f32", "f16", "rabitq8"],
      "force_index": true,
      "log_output": "benchmarks/task51-local-ivf-rabitq-sidecar/artifacts/sidecar-50k-rabitq1-n128-k50.log"
    },
    {
      "kind": "storage",
      "name": "storage-50k-rabitq1-n128-rerank-off",
      "tags": ["storage", "ec_real_50k", "ivf", "rabitq", "sidecar", "nlists128"],
      "prefix": "task51_local_50k_ivf_rabitq1_n128_sidecar_off",
      "log_file": "benchmarks/task51-local-ivf-rabitq-sidecar/artifacts/storage-50k-rabitq1-n128-rerank-off.log"
    }
  ]
}
