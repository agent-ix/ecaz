{
  "name": "task59-aws-diskann-frontier-heap",
  "schema_version": 1,
  "artifact_dir": "benchmarks/task59-aws-diskann-frontier-heap/artifacts",
  "defaults": {
    "pg": 18,
    "socket_dir": "/var/run/postgresql",
    "profile": "ec_diskann",
    "seed": 42,
    "queries_limit": 200,
    "iterations": 200,
    "force_index": true
  },
  "steps": [
    {
      "kind": "raw",
      "name": "precheck-host",
      "tags": ["aws", "precheck", "graviton", "task59"],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "postgres",
        "--socket-dir",
        "/var/run/postgresql",
        "--raw",
        "--sql",
        "SELECT now() AS captured_at, version() AS postgres_version, current_setting('shared_buffers') AS shared_buffers, current_setting('work_mem') AS work_mem, current_setting('maintenance_work_mem') AS maintenance_work_mem; SELECT left(pg_read_file('/proc/cpuinfo', 0, 20000), 20000) AS cpuinfo_prefix;",
        "--log-output",
        "benchmarks/task59-aws-diskann-frontier-heap/artifacts/precheck-host.log"
      ],
      "expected_artifacts": [
        "benchmarks/task59-aws-diskann-frontier-heap/artifacts/precheck-host.log"
      ]
    },
    {
      "kind": "recall",
      "name": "recall-10k-diskann-default",
      "tags": ["aws", "recall", "ec_real_10k", "diskann", "default", "task59"],
      "prefix": "task55_real_10k_diskann",
      "profile": "ec_diskann",
      "k": 10,
      "sweep": [64, 128, 200, 400, 800],
      "queries_limit": 200,
      "force_index": true,
      "truth_cache_file": "benchmarks/task59-aws-diskann-frontier-heap/artifacts/truth-10k-k10.json",
      "log_output": "benchmarks/task59-aws-diskann-frontier-heap/artifacts/recall-10k-diskann-default.log"
    },
    {
      "kind": "latency",
      "name": "latency-10k-diskann-default",
      "tags": ["aws", "latency", "ec_real_10k", "diskann", "default", "task59"],
      "prefix": "task55_real_10k_diskann",
      "profile": "ec_diskann",
      "sweep": [64, 128, 200, 400, 800],
      "iterations": 200,
      "concurrency": 1,
      "force_index": true,
      "log_output": "benchmarks/task59-aws-diskann-frontier-heap/artifacts/latency-10k-diskann-default.log"
    },
    {
      "kind": "recall",
      "name": "recall-100k-diskann-default",
      "tags": ["aws", "recall", "ec_real_100k", "diskann", "default", "task59"],
      "prefix": "task55_real_100k_diskann",
      "profile": "ec_diskann",
      "k": 10,
      "sweep": [64, 128, 200, 400, 800],
      "queries_limit": 200,
      "force_index": true,
      "truth_cache_file": "benchmarks/task59-aws-diskann-frontier-heap/artifacts/truth-100k-k10.json",
      "log_output": "benchmarks/task59-aws-diskann-frontier-heap/artifacts/recall-100k-diskann-default.log"
    },
    {
      "kind": "latency",
      "name": "latency-100k-diskann-default",
      "tags": ["aws", "latency", "ec_real_100k", "diskann", "default", "task59"],
      "prefix": "task55_real_100k_diskann",
      "profile": "ec_diskann",
      "sweep": [64, 128, 200, 400, 800],
      "iterations": 200,
      "concurrency": 1,
      "force_index": true,
      "log_output": "benchmarks/task59-aws-diskann-frontier-heap/artifacts/latency-100k-diskann-default.log"
    },
    {
      "kind": "explain",
      "name": "explain-100k-diskann-l800",
      "tags": ["aws", "explain", "ec_real_100k", "diskann", "list-size-800", "task59"],
      "prefix": "task55_real_100k_diskann",
      "profile": "ec_diskann",
      "nprobe": 800,
      "rerank_width": 0,
      "sql_file": "benchmarks/task59-aws-diskann-frontier-heap/artifacts/explain-100k-diskann-l800.sql",
      "log_output": "benchmarks/task59-aws-diskann-frontier-heap/artifacts/explain-100k-diskann-l800.log"
    }
  ]
}
