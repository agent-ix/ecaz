{
  "name": "task59-aws-diskann-final-graviton-suite",
  "schema_version": 1,
  "artifact_dir": "benchmarks/task59-aws-diskann-final-graviton-suite/artifacts",
  "defaults": {
    "pg": 18,
    "socket_dir": "/var/run/postgresql",
    "profile": "ec_diskann",
    "seed": 42,
    "queries_limit": 200,
    "iterations": 200,
    "force_index": true,
    "sample_backend_memory": true,
    "memory_sample_interval_ms": 25
  },
  "steps": [
    {
      "kind": "corpus-fetch",
      "name": "fetch-dbpedia-openai3-1m",
      "tags": ["setup", "fetch", "dbpedia", "graviton", "task59"],
      "dataset": "qdrant-dbpedia-openai3-large-1536-1m",
      "output_dir": "/var/lib/pgsql/18/datasets/dbpedia-openai3-1m"
    },
    {
      "kind": "corpus-prepare",
      "name": "prepare-ec-real-10k",
      "tags": ["setup", "prepare", "ec_real_10k", "graviton", "task59"],
      "profile": "ec_real_10k",
      "parquet": "/var/lib/pgsql/18/datasets/dbpedia-openai3-1m/data",
      "output_dir": "/var/lib/pgsql/18/datasets/staged-task59-diskann-final"
    },
    {
      "kind": "corpus-prepare",
      "name": "prepare-ec-real-50k",
      "tags": ["setup", "prepare", "ec_real_50k", "graviton", "task59"],
      "profile": "ec_real_50k",
