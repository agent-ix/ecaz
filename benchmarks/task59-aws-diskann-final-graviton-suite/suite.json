      "tags": ["storage", "ec_real_10k", "diskann", "pq_fastscan", "graviton", "task59"],
      "prefix": "task59_real_10k_diskann",
      "log_file": "benchmarks/task59-aws-diskann-final-graviton-suite/artifacts/storage-10k-diskann-default.log"
    },
    {
      "kind": "explain",
