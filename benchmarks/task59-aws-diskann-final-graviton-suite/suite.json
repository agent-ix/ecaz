    },
    {
      "kind": "corpus-prepare",
      "name": "prepare-ec-real-100k",
      "tags": ["setup", "prepare", "ec_real_100k", "graviton", "task59"],
      "profile": "ec_real_100k",
      "parquet": "/var/lib/pgsql/18/datasets/dbpedia-openai3-1m/data",
      "output_dir": "/var/lib/pgsql/18/datasets/staged-task59-diskann-final"
    },
    {
      "kind": "raw",
      "name": "precheck-host",
      "tags": ["setup", "precheck", "graviton", "task59"],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "postgres",
        "--socket-dir",
        "/var/run/postgresql",
        "--raw",
        "--sql",
        "SELECT now() AS captured_at, version() AS postgres_version, current_setting('shared_buffers') AS shared_buffers, current_setting('work_mem') AS work_mem, current_setting('maintenance_work_mem') AS maintenance_work_mem, current_setting('effective_cache_size') AS effective_cache_size; SELECT left(pg_read_file('/proc/cpuinfo', 0, 20000), 20000) AS cpuinfo_prefix; SELECT left(pg_read_file('/proc/meminfo', 0, 12000), 12000) AS meminfo_prefix;",
        "--log-output",
        "benchmarks/task59-aws-diskann-final-graviton-suite/artifacts/precheck-host.log"
      ],
      "expected_artifacts": [
        "benchmarks/task59-aws-diskann-final-graviton-suite/artifacts/precheck-host.log"
      ]
    },
    {
      "kind": "load",
      "name": "load-10k-diskann-default",
      "tags": ["load", "ec_real_10k", "diskann", "pq_fastscan", "graviton", "task59"],
      "prefix": "task59_real_10k_diskann",
      "profile": "ec_diskann",
      "corpus_file": "/var/lib/pgsql/18/datasets/staged-task59-diskann-final/ec_real_10k_corpus.tsv",
      "queries_file": "/var/lib/pgsql/18/datasets/staged-task59-diskann-final/ec_real_10k_queries.tsv",
      "manifest_file": "/var/lib/pgsql/18/datasets/staged-task59-diskann-final/ec_real_10k_manifest.json",
      "allow_manifest_mismatch": true,
      "log_file": "benchmarks/task59-aws-diskann-final-graviton-suite/artifacts/load-10k-diskann-default.log"
    },
    {
      "kind": "recall",
      "name": "recall-10k-diskann-default",
      "tags": ["recall", "ec_real_10k", "diskann", "pq_fastscan", "graviton", "task59"],
      "prefix": "task59_real_10k_diskann",
      "profile": "ec_diskann",
      "k": 10,
      "sweep": [64, 128, 200, 400, 800],
      "truth_cache_file": "benchmarks/task59-aws-diskann-final-graviton-suite/artifacts/truth-10k-k10.json",
      "log_output": "benchmarks/task59-aws-diskann-final-graviton-suite/artifacts/recall-10k-diskann-default.log"
    },
    {
      "kind": "latency",
      "name": "latency-10k-diskann-default",
      "tags": ["latency", "ec_real_10k", "diskann", "pq_fastscan", "graviton", "task59"],
      "prefix": "task59_real_10k_diskann",
      "profile": "ec_diskann",
      "sweep": [64, 128, 200, 400, 800],
      "concurrency": 1,
      "cache_state": "post_recall_warm",
      "log_output": "benchmarks/task59-aws-diskann-final-graviton-suite/artifacts/latency-10k-diskann-default.log"
    },
    {
      "kind": "storage",
