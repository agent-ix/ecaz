{
  "name": "task59-aws-diskann-final-graviton-suite-1m-resume",
  "schema_version": 1,
  "artifact_dir": "benchmarks/task59-aws-diskann-final-graviton-suite/artifacts/one-million-resume",
  "defaults": {
    "pg": 18,
    "socket_dir": "/var/run/postgresql",
    "profile": "ec_diskann",
    "seed": 42,
    "queries_limit": 200,
    "iterations": 200,
    "force_index": true,
    "sample_backend_memory": true,
    "memory_sample_interval_ms": 25
  },
  "steps": [
    {
      "kind": "load",
      "name": "load-1m-diskann-default",
      "tags": ["load", "ec_real_1m", "diskann", "pq_fastscan", "graviton", "task59", "resume"],
      "prefix": "task59_real_1m_diskann",
      "profile": "ec_diskann",
      "corpus_file": "/var/lib/pgsql/18/datasets/staged-1m/ec_real_ann_benchmarks_anchor_corpus.tsv",
      "queries_file": "/var/lib/pgsql/18/datasets/staged-1m/ec_real_ann_benchmarks_anchor_queries.tsv",
      "manifest_file": "/var/lib/pgsql/18/datasets/staged-1m/ec_real_ann_benchmarks_anchor_manifest.json",
      "allow_manifest_mismatch": true,
      "log_file": "benchmarks/task59-aws-diskann-final-graviton-suite/artifacts/one-million-resume/load-1m-diskann-default.log"
    },
    {
      "kind": "recall",
      "name": "recall-1m-diskann-default",
      "tags": ["recall", "ec_real_1m", "diskann", "pq_fastscan", "graviton", "task59", "resume"],
      "prefix": "task59_real_1m_diskann",
      "profile": "ec_diskann",
      "k": 10,
      "sweep": [64, 128, 200, 400, 800],
      "truth_cache_file": "benchmarks/task59-aws-diskann-final-graviton-suite/artifacts/one-million-resume/truth-1m-k10.json",
      "log_output": "benchmarks/task59-aws-diskann-final-graviton-suite/artifacts/one-million-resume/recall-1m-diskann-default.log"
    },
    {
      "kind": "latency",
      "name": "latency-1m-diskann-default",
      "tags": ["latency", "ec_real_1m", "diskann", "pq_fastscan", "graviton", "task59", "resume"],
      "prefix": "task59_real_1m_diskann",
      "profile": "ec_diskann",
      "sweep": [64, 128, 200, 400, 800],
      "concurrency": 1,
      "cache_state": "post_recall_warm",
      "log_output": "benchmarks/task59-aws-diskann-final-graviton-suite/artifacts/one-million-resume/latency-1m-diskann-default.log"
    },
    {
      "kind": "storage",
      "name": "storage-1m-diskann-default",
      "tags": ["storage", "ec_real_1m", "diskann", "pq_fastscan", "graviton", "task59", "resume"],
      "prefix": "task59_real_1m_diskann",
      "log_file": "benchmarks/task59-aws-diskann-final-graviton-suite/artifacts/one-million-resume/storage-1m-diskann-default.log"
    },
    {
      "kind": "explain",
      "name": "explain-1m-diskann-l800",
      "tags": ["explain", "ec_real_1m", "diskann", "pq_fastscan", "graviton", "task59", "resume"],
      "prefix": "task59_real_1m_diskann",
      "profile": "ec_diskann",
      "nprobe": 800,
      "rerank_width": 0,
      "sql_file": "benchmarks/task59-aws-diskann-final-graviton-suite/artifacts/one-million-resume/explain-1m-diskann-l800.sql",
      "log_output": "benchmarks/task59-aws-diskann-final-graviton-suite/artifacts/one-million-resume/explain-1m-diskann-l800.log"
    }
  ]
}
