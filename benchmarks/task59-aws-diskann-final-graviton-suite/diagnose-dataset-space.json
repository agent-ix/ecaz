{
  "name": "task59-diagnose-dataset-space",
  "schema_version": 1,
  "artifact_dir": "benchmarks/task59-aws-diskann-final-graviton-suite/artifacts/diagnose-dataset-space",
  "defaults": {
    "pg": 18,
    "socket_dir": "/var/run/postgresql"
  },
  "steps": [
    {
      "kind": "raw",
      "name": "dataset-du",
      "tags": ["diagnostic", "space", "graviton", "task59"],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "postgres",
        "--socket-dir",
        "/var/run/postgresql",
        "--raw",
        "--sql",
        "COPY (SELECT '') TO PROGRAM 'sh -c ''du -h -d 1 /var/lib/pgsql/18/datasets | sort -h > /var/lib/pgsql/build/ecaz/benchmarks/task59-aws-diskann-final-graviton-suite/artifacts/diagnose-dataset-space/dataset-du.log; df -h /var/lib/pgsql/18 >> /var/lib/pgsql/build/ecaz/benchmarks/task59-aws-diskann-final-graviton-suite/artifacts/diagnose-dataset-space/dataset-du.log''';",
        "--log-output",
        "benchmarks/task59-aws-diskann-final-graviton-suite/artifacts/diagnose-dataset-space/dataset-du-sql.log"
      ],
      "expected_artifacts": [
        "benchmarks/task59-aws-diskann-final-graviton-suite/artifacts/diagnose-dataset-space/dataset-du.log",
        "benchmarks/task59-aws-diskann-final-graviton-suite/artifacts/diagnose-dataset-space/dataset-du-sql.log"
      ]
    }
  ]
}
