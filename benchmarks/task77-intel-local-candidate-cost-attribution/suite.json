{
  "name": "task77-intel-local-candidate-cost-attribution",
  "schema_version": 1,
  "artifact_dir": "benchmarks/task77-intel-local-candidate-cost-attribution/artifacts",
  "defaults": {
    "bits": 4,
    "seed": 42,
    "socket_dir": "/home/peter/.pgrx",
    "pg": 18,
    "profile": "ec_spire",
    "queries_limit": 200,
    "iterations": 200,
    "force_index": true,
    "sample_backend_memory": true,
    "memory_sample_interval_ms": 25
  },
  "steps": [
    {
      "kind": "raw",
      "name": "drop-task77-database",
      "tags": ["setup", "task77", "intel-local"],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "postgres",
        "--socket-dir",
        "/home/peter/.pgrx",
        "--raw",
        "--sql",
        "DROP DATABASE IF EXISTS task77_spire_attribution;",
        "--log-output",
        "benchmarks/task77-intel-local-candidate-cost-attribution/artifacts/drop-task77-database.log"
      ],
      "expected_artifacts": [
        "benchmarks/task77-intel-local-candidate-cost-attribution/artifacts/drop-task77-database.log"
      ]
    },
    {
      "kind": "raw",
      "name": "create-task77-database",
      "tags": ["setup", "task77", "intel-local"],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "postgres",
        "--socket-dir",
        "/home/peter/.pgrx",
        "--raw",
        "--sql",
        "CREATE DATABASE task77_spire_attribution;",
        "--log-output",
        "benchmarks/task77-intel-local-candidate-cost-attribution/artifacts/create-task77-database.log"
      ],
      "expected_artifacts": [
        "benchmarks/task77-intel-local-candidate-cost-attribution/artifacts/create-task77-database.log"
      ]
    },
    {
      "kind": "raw",
      "name": "precheck-host-and-extension",
      "tags": ["setup", "precheck", "task77", "intel-local"],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "task77_spire_attribution",
        "--socket-dir",
        "/home/peter/.pgrx",
        "--raw",
        "--sql",
        "CREATE EXTENSION IF NOT EXISTS ecaz; SELECT now() AS captured_at, version() AS postgres_version, current_setting('shared_buffers') AS shared_buffers, current_setting('work_mem') AS work_mem, current_setting('maintenance_work_mem') AS maintenance_work_mem, current_setting('effective_cache_size') AS effective_cache_size; SELECT extname, extversion FROM pg_extension WHERE extname = 'ecaz'; SELECT amname FROM pg_am WHERE amname IN ('ec_spire', 'ec_ivf') ORDER BY amname; SELECT proname FROM pg_proc WHERE proname = 'ec_spire_index_scan_leaf_candidate_snapshot';",
        "--log-output",
        "benchmarks/task77-intel-local-candidate-cost-attribution/artifacts/precheck-host-and-extension.log"
      ],
      "expected_artifacts": [
        "benchmarks/task77-intel-local-candidate-cost-attribution/artifacts/precheck-host-and-extension.log"
      ]
    },
    {
      "kind": "load",
      "name": "load-100k-spire-tg64-b0",
      "tags": ["load", "task77", "intel-local", "ec_real_100k", "spire", "tg64", "b0"],
      "prefix": "task77_spire_100k",
      "profile": "ec_spire",
      "corpus_file": "target/real-corpus/staged-task50/ec_real_100k_corpus.tsv",
      "queries_file": "target/real-corpus/staged-task50/ec_real_100k_queries.tsv",
      "manifest_file": "target/real-corpus/staged-task50/ec_real_100k_manifest.json",
      "allow_manifest_mismatch": true,
      "reloptions": [
        "nlists=128",
        "recursive_fanout=8",
        "nprobe=24",
        "rerank_width=25",
        "storage_format=turboquant",
        "boundary_replica_count=0",
        "top_graph_enabled=1",
        "top_graph_degree=32",
        "top_graph_build_list_size=100",
        "top_graph_search_list_size=64"
      ]
    },
    {
      "kind": "spire-pipeline",
      "name": "pipeline-100k-tg64-b0",
      "tags": ["pipeline", "funnel", "task77", "intel-local", "ec_real_100k", "spire", "tg64", "b0"],
      "prefix": "task77_spire_100k",
      "index": "task77_spire_100k_idx",
      "queries_limit": 200,
      "sweep": [64],
      "rerank_width": 25,
      "include_local_store_overlap": true,
      "include_cost_snapshot": true,
      "include_query_metrics": true,
      "include_recall": true,
      "include_production_read_profile": true,
      "truth_corpus_file": "target/real-corpus/staged-task50/ec_real_100k_corpus.tsv",
      "query_metric_k": 10,
      "query_metric_projection_columns": ["id"],
      "log_output": "benchmarks/task77-intel-local-candidate-cost-attribution/artifacts/pipeline-100k-tg64-b0.log",
      "funnel_output": "benchmarks/task77-intel-local-candidate-cost-attribution/artifacts/funnel-100k-tg64-b0.jsonl"
    },
    {
      "kind": "raw",
      "name": "rebuild-100k-tg96-b0",
      "tags": ["create-index", "task77", "intel-local", "ec_real_100k", "spire", "tg96", "b0"],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "task77_spire_attribution",
        "--socket-dir",
        "/home/peter/.pgrx",
        "--raw",
        "--sql",
        "SET client_min_messages TO notice; DROP INDEX IF EXISTS task77_spire_100k_idx; CREATE INDEX task77_spire_100k_idx ON task77_spire_100k_corpus USING ec_spire (embedding ecvector_spire_ip_ops) WITH (nlists = 128, recursive_fanout = 8, nprobe = 24, rerank_width = 25, storage_format = 'turboquant', boundary_replica_count = 0, top_graph_enabled = 1, top_graph_degree = 32, top_graph_build_list_size = 100, top_graph_search_list_size = 96);",
        "--log-output",
        "benchmarks/task77-intel-local-candidate-cost-attribution/artifacts/rebuild-100k-tg96-b0.log"
      ],
      "expected_artifacts": [
        "benchmarks/task77-intel-local-candidate-cost-attribution/artifacts/rebuild-100k-tg96-b0.log"
      ]
    },
    {
      "kind": "spire-pipeline",
      "name": "pipeline-100k-tg96-b0",
      "tags": ["pipeline", "funnel", "task77", "intel-local", "ec_real_100k", "spire", "tg96", "b0"],
      "prefix": "task77_spire_100k",
      "index": "task77_spire_100k_idx",
      "queries_limit": 200,
      "sweep": [96],
      "rerank_width": 25,
      "include_local_store_overlap": true,
      "include_cost_snapshot": true,
      "include_query_metrics": true,
      "include_recall": true,
      "include_production_read_profile": true,
      "truth_corpus_file": "target/real-corpus/staged-task50/ec_real_100k_corpus.tsv",
      "query_metric_k": 10,
      "query_metric_projection_columns": ["id"],
      "log_output": "benchmarks/task77-intel-local-candidate-cost-attribution/artifacts/pipeline-100k-tg96-b0.log",
      "funnel_output": "benchmarks/task77-intel-local-candidate-cost-attribution/artifacts/funnel-100k-tg96-b0.jsonl"
    },
    {
      "kind": "raw",
      "name": "rebuild-100k-tg128-b0",
      "tags": ["create-index", "task77", "intel-local", "ec_real_100k", "spire", "tg128", "b0", "matched-recall"],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "task77_spire_attribution",
        "--socket-dir",
        "/home/peter/.pgrx",
        "--raw",
        "--sql",
        "SET client_min_messages TO notice; DROP INDEX IF EXISTS task77_spire_100k_idx; CREATE INDEX task77_spire_100k_idx ON task77_spire_100k_corpus USING ec_spire (embedding ecvector_spire_ip_ops) WITH (nlists = 128, recursive_fanout = 8, nprobe = 24, rerank_width = 25, storage_format = 'turboquant', boundary_replica_count = 0, top_graph_enabled = 1, top_graph_degree = 32, top_graph_build_list_size = 100, top_graph_search_list_size = 128);",
        "--log-output",
        "benchmarks/task77-intel-local-candidate-cost-attribution/artifacts/rebuild-100k-tg128-b0.log"
      ],
      "expected_artifacts": [
        "benchmarks/task77-intel-local-candidate-cost-attribution/artifacts/rebuild-100k-tg128-b0.log"
      ]
    },
    {
      "kind": "spire-pipeline",
      "name": "pipeline-100k-tg128-b0",
      "tags": ["pipeline", "funnel", "task77", "intel-local", "ec_real_100k", "spire", "tg128", "b0", "matched-recall"],
      "prefix": "task77_spire_100k",
      "index": "task77_spire_100k_idx",
      "queries_limit": 200,
      "sweep": [128],
      "rerank_width": 25,
      "include_local_store_overlap": true,
      "include_cost_snapshot": true,
      "include_query_metrics": true,
      "include_recall": true,
      "include_production_read_profile": true,
      "truth_corpus_file": "target/real-corpus/staged-task50/ec_real_100k_corpus.tsv",
      "query_metric_k": 10,
      "query_metric_projection_columns": ["id"],
      "log_output": "benchmarks/task77-intel-local-candidate-cost-attribution/artifacts/pipeline-100k-tg128-b0.log",
      "funnel_output": "benchmarks/task77-intel-local-candidate-cost-attribution/artifacts/funnel-100k-tg128-b0.jsonl"
    },
    {
      "kind": "raw",
      "name": "fixed-candidate-rabitq-kernel-77531",
      "tags": ["microbench", "fixed-candidate", "task77", "intel-local", "rabitq"],
      "args": [
        "bench",
        "rabitq-kernel",
        "--dim",
        "1536",
        "--candidates",
        "77531",
        "--iterations",
        "256",
        "--simd-mode",
        "auto",
        "--log-output",
        "benchmarks/task77-intel-local-candidate-cost-attribution/artifacts/fixed-candidate-rabitq-kernel-77531.log"
      ],
      "expected_artifacts": [
        "benchmarks/task77-intel-local-candidate-cost-attribution/artifacts/fixed-candidate-rabitq-kernel-77531.log"
      ]
    }
  ]
}
