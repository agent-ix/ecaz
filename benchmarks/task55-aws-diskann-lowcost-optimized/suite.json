{
  "name": "task55-aws-diskann-lowcost-optimized",
  "schema_version": 1,
  "artifact_dir": "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts",
  "defaults": {
    "pg": 18,
    "socket_dir": "/var/run/postgresql",
    "profile": "ec_diskann",
    "seed": 42,
    "queries_limit": 200,
    "iterations": 200,
    "force_index": true
  },
  "steps": [
    {
      "kind": "corpus-fetch",
      "name": "fetch-dbpedia-openai3",
      "tags": ["aws", "fetch", "dbpedia"],
      "dataset": "qdrant-dbpedia-openai3-large-1536-1m",
      "output_dir": "/var/lib/pgsql/18/datasets/dbpedia-openai3-1m"
    },
    {
      "kind": "corpus-prepare",
      "name": "prepare-ec-real-10k",
      "tags": ["aws", "prepare", "ec_real_10k"],
      "profile": "ec_real_10k",
      "parquet": "/var/lib/pgsql/18/datasets/dbpedia-openai3-1m/data",
      "output_dir": "/var/lib/pgsql/18/datasets/staged-task55-diskann"
    },
    {
      "kind": "corpus-prepare",
      "name": "prepare-ec-real-100k",
      "tags": ["aws", "prepare", "ec_real_100k"],
      "profile": "ec_real_100k",
      "parquet": "/var/lib/pgsql/18/datasets/dbpedia-openai3-1m/data",
      "output_dir": "/var/lib/pgsql/18/datasets/staged-task55-diskann"
    },
    {
      "kind": "raw",
      "name": "precheck-host",
      "tags": ["aws", "precheck"],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "postgres",
        "--socket-dir",
        "/var/run/postgresql",
        "--raw",
        "--sql",
        "SELECT now() AS captured_at, version() AS postgres_version, current_setting('shared_buffers') AS shared_buffers, current_setting('work_mem') AS work_mem, current_setting('maintenance_work_mem') AS maintenance_work_mem; SELECT left(pg_read_file('/proc/cpuinfo', 0, 20000), 20000) AS cpuinfo_prefix;",
        "--log-output",
        "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/precheck-host.log"
      ],
      "expected_artifacts": [
        "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/precheck-host.log"
      ]
    },
    {
      "kind": "load",
      "name": "load-10k-diskann-default",
      "tags": ["aws", "load", "ec_real_10k", "diskann", "default"],
      "prefix": "task55_real_10k_diskann",
      "profile": "ec_diskann",
      "corpus_file": "/var/lib/pgsql/18/datasets/staged-task55-diskann/ec_real_10k_corpus.tsv",
      "queries_file": "/var/lib/pgsql/18/datasets/staged-task55-diskann/ec_real_10k_queries.tsv",
      "manifest_file": "/var/lib/pgsql/18/datasets/staged-task55-diskann/ec_real_10k_manifest.json",
      "allow_manifest_mismatch": true,
      "log_file": "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/load-10k-diskann-default.log"
    },
    {
      "kind": "raw",
      "name": "graph-10k-diskann-default",
      "tags": ["aws", "graph", "ec_real_10k", "diskann", "default"],
      "args": [
        "bench",
        "diskann-graph",
        "--prefix",
        "task55_real_10k_diskann",
        "--log-output",
        "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/graph-10k-diskann-default.log"
      ],
      "expected_artifacts": [
        "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/graph-10k-diskann-default.log"
      ]
    },
    {
      "kind": "raw",
      "name": "build-probe-10k-default",
      "tags": ["aws", "build-probe", "ec_real_10k", "diskann", "default"],
      "args": [
        "bench",
        "diskann-build-probe",
        "--prefix",
        "task55_real_10k_diskann",
        "--rows-limit",
        "10000",
        "--queries-limit",
        "100",
        "--graph-degree",
        "32",
        "--build-list-size",
        "100",
        "--alpha",
        "1.2",
        "--scan-list-size",
        "200",
        "--log-output",
        "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/build-probe-10k-default.log"
      ],
      "expected_artifacts": [
        "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/build-probe-10k-default.log"
      ]
    },
    {
      "kind": "raw",
      "name": "build-probe-10k-low-degree",
      "tags": ["aws", "build-probe", "ec_real_10k", "diskann", "low-degree"],
      "args": [
        "bench",
        "diskann-build-probe",
        "--prefix",
        "task55_real_10k_diskann",
        "--rows-limit",
        "10000",
        "--queries-limit",
        "100",
        "--graph-degree",
        "16",
        "--build-list-size",
        "100",
        "--alpha",
        "1.2",
        "--scan-list-size",
        "200",
        "--log-output",
        "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/build-probe-10k-low-degree.log"
      ],
      "expected_artifacts": [
        "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/build-probe-10k-low-degree.log"
      ]
    },
    {
      "kind": "raw",
      "name": "build-probe-10k-wide-alpha",
      "tags": ["aws", "build-probe", "ec_real_10k", "diskann", "wide-alpha"],
      "args": [
        "bench",
        "diskann-build-probe",
        "--prefix",
        "task55_real_10k_diskann",
        "--rows-limit",
        "10000",
        "--queries-limit",
        "100",
        "--graph-degree",
        "32",
        "--build-list-size",
        "200",
        "--alpha",
        "1.4",
        "--scan-list-size",
        "200",
        "--log-output",
        "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/build-probe-10k-wide-alpha.log"
      ],
      "expected_artifacts": [
        "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/build-probe-10k-wide-alpha.log"
      ]
    },
    {
      "kind": "recall",
      "name": "recall-10k-diskann-default",
      "tags": ["aws", "recall", "ec_real_10k", "diskann", "default"],
      "prefix": "task55_real_10k_diskann",
      "profile": "ec_diskann",
      "k": 10,
      "sweep": [64, 128, 200, 400, 800],
      "queries_limit": 200,
      "force_index": true,
      "truth_cache_file": "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/truth-10k-k10.json",
      "log_output": "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/recall-10k-diskann-default.log"
    },
    {
      "kind": "latency",
      "name": "latency-10k-diskann-default",
      "tags": ["aws", "latency", "ec_real_10k", "diskann", "default"],
      "prefix": "task55_real_10k_diskann",
      "profile": "ec_diskann",
      "sweep": [64, 128, 200, 400, 800],
      "iterations": 200,
      "concurrency": 1,
      "force_index": true,
      "log_output": "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/latency-10k-diskann-default.log"
    },
    {
      "kind": "storage",
      "name": "storage-10k-diskann-default",
      "tags": ["aws", "storage", "ec_real_10k", "diskann", "default"],
      "prefix": "task55_real_10k_diskann",
      "log_file": "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/storage-10k-diskann-default.log"
    },
    {
      "kind": "explain",
      "name": "explain-10k-diskann-l200",
      "tags": ["aws", "explain", "ec_real_10k", "diskann", "list-size-200"],
      "prefix": "task55_real_10k_diskann",
      "profile": "ec_diskann",
      "nprobe": 200,
      "rerank_width": 0,
      "sql_file": "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/explain-10k-diskann-l200.sql",
      "log_output": "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/explain-10k-diskann-l200.log"
    },
    {
      "kind": "load",
      "name": "load-100k-diskann-default",
      "tags": ["aws", "load", "ec_real_100k", "diskann", "default"],
      "prefix": "task55_real_100k_diskann",
      "profile": "ec_diskann",
      "corpus_file": "/var/lib/pgsql/18/datasets/staged-task55-diskann/ec_real_100k_corpus.tsv",
      "queries_file": "/var/lib/pgsql/18/datasets/staged-task55-diskann/ec_real_100k_queries.tsv",
      "manifest_file": "/var/lib/pgsql/18/datasets/staged-task55-diskann/ec_real_100k_manifest.json",
      "allow_manifest_mismatch": true,
      "log_file": "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/load-100k-diskann-default.log"
    },
    {
      "kind": "raw",
      "name": "graph-100k-diskann-default",
      "tags": ["aws", "graph", "ec_real_100k", "diskann", "default"],
      "args": [
        "bench",
        "diskann-graph",
        "--prefix",
        "task55_real_100k_diskann",
        "--log-output",
        "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/graph-100k-diskann-default.log"
      ],
      "expected_artifacts": [
        "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/graph-100k-diskann-default.log"
      ]
    },
    {
      "kind": "raw",
      "name": "build-probe-100k-default-sample",
      "tags": ["aws", "build-probe", "ec_real_100k", "diskann", "default", "sample"],
      "args": [
        "bench",
        "diskann-build-probe",
        "--prefix",
        "task55_real_100k_diskann",
        "--rows-limit",
        "20000",
        "--queries-limit",
        "100",
        "--graph-degree",
        "32",
        "--build-list-size",
        "100",
        "--alpha",
        "1.2",
        "--scan-list-size",
        "200",
        "--log-output",
        "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/build-probe-100k-default-sample.log"
      ],
      "expected_artifacts": [
        "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/build-probe-100k-default-sample.log"
      ]
    },
    {
      "kind": "raw",
      "name": "build-probe-100k-wide-alpha-sample",
      "tags": ["aws", "build-probe", "ec_real_100k", "diskann", "wide-alpha", "sample"],
      "args": [
        "bench",
        "diskann-build-probe",
        "--prefix",
        "task55_real_100k_diskann",
        "--rows-limit",
        "20000",
        "--queries-limit",
        "100",
        "--graph-degree",
        "32",
        "--build-list-size",
        "200",
        "--alpha",
        "1.4",
        "--scan-list-size",
        "200",
        "--log-output",
        "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/build-probe-100k-wide-alpha-sample.log"
      ],
      "expected_artifacts": [
        "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/build-probe-100k-wide-alpha-sample.log"
      ]
    },
    {
      "kind": "recall",
      "name": "recall-100k-diskann-default",
      "tags": ["aws", "recall", "ec_real_100k", "diskann", "default"],
      "prefix": "task55_real_100k_diskann",
      "profile": "ec_diskann",
      "k": 10,
      "sweep": [64, 128, 200, 400, 800],
      "queries_limit": 200,
      "force_index": true,
      "truth_cache_file": "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/truth-100k-k10.json",
      "log_output": "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/recall-100k-diskann-default.log"
    },
    {
      "kind": "latency",
      "name": "latency-100k-diskann-default",
      "tags": ["aws", "latency", "ec_real_100k", "diskann", "default"],
      "prefix": "task55_real_100k_diskann",
      "profile": "ec_diskann",
      "sweep": [64, 128, 200, 400, 800],
      "iterations": 200,
      "concurrency": 1,
      "force_index": true,
      "log_output": "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/latency-100k-diskann-default.log"
    },
    {
      "kind": "storage",
      "name": "storage-100k-diskann-default",
      "tags": ["aws", "storage", "ec_real_100k", "diskann", "default"],
      "prefix": "task55_real_100k_diskann",
      "log_file": "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/storage-100k-diskann-default.log"
    },
    {
      "kind": "explain",
      "name": "explain-100k-diskann-l200",
      "tags": ["aws", "explain", "ec_real_100k", "diskann", "list-size-200"],
      "prefix": "task55_real_100k_diskann",
      "profile": "ec_diskann",
      "nprobe": 200,
      "rerank_width": 0,
      "sql_file": "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/explain-100k-diskann-l200.sql",
      "log_output": "benchmarks/task55-aws-diskann-lowcost-optimized/artifacts/explain-100k-diskann-l200.log"
    }
  ]
}
