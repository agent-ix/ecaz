{
  "name": "vchord-g4-probe-sweep",
  "schema_version": 1,
  "artifact_dir": "benchmarks/comparators-50k-100k-1m/artifacts/vchord-g4-run/artifacts",
  "defaults": {
    "pg": 18,
    "socket_dir": "/var/run/postgresql",
    "queries_limit": 200
  },
  "thresholds": [],
  "steps": [
    {
      "kind": "comparator",
      "name": "comparator-vchord-50k-probe-sweep",
      "tags": ["comparator", "vchord", "real50k", "g4", "probe-sweep"],
      "engine": "vchord",
      "prefix": "real_50k_ivf_rabitq",
      "k": 10,
      "sweep": [1, 4, 16, 64],
      "lists": 224,
      "rebuild": true
    },
    {
      "kind": "comparator",
      "name": "comparator-vchord-100k-probe-sweep",
      "tags": ["comparator", "vchord", "real100k", "g4", "probe-sweep"],
      "engine": "vchord",
      "prefix": "real_100k_ivf_rabitq1_rerank",
      "k": 10,
      "sweep": [1, 4, 16, 64],
      "lists": 320,
      "rebuild": true
    },
    {
      "kind": "comparator",
      "name": "comparator-vchord-1m-probe-sweep",
      "tags": ["comparator", "vchord", "real1m", "g4", "probe-sweep"],
      "engine": "vchord",
      "prefix": "real_1m_ivf_rabitq1_rerank",
      "k": 10,
      "sweep": [1, 4, 16, 64],
      "lists": 1024,
      "rebuild": true
    }
  ]
}
