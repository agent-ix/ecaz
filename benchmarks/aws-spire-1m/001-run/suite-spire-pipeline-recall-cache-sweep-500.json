{
  "name": "aws-spire-1m-rabitq-global1152-pipeline-recall-cache-sweep-500",
  "schema_version": 1,
  "artifact_dir": "benchmarks/aws-spire-1m/001-run/artifacts/pipeline-recall-cache-sweep-500",
  "defaults": {
    "pg": 18,
    "socket_dir": "/var/run/postgresql",
    "profile": "ec_spire",
    "queries_limit": 500,
    "iterations": 500,
    "force_index": true
  },
  "steps": [
    {
      "kind": "raw",
      "name": "precheck-existing-spire-1m-index-and-truth-cache",
      "tags": ["setup", "precheck", "aws", "1m", "spire", "rabitq", "global1152", "pipeline-recall", "truth-cache", "q500", "sweep"],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "postgres",
        "--socket-dir",
        "/var/run/postgresql",
        "--raw",
        "--sql",
        "CREATE EXTENSION IF NOT EXISTS ecaz; SELECT now() AS captured_at, current_database() AS database_name, version() AS postgres_version; SELECT count(*) AS corpus_rows FROM task67_1m_hnsw_m7g2xlarge_corpus; SELECT count(*) AS query_rows FROM task67_1m_hnsw_m7g2xlarge_queries; SELECT i.relname AS index_name, am.amname, pg_size_pretty(pg_relation_size(i.oid)) AS index_size FROM pg_index x JOIN pg_class i ON i.oid = x.indexrelid JOIN pg_class t ON t.oid = x.indrelid JOIN pg_am am ON am.oid = i.relam WHERE t.relname = 'task67_1m_hnsw_m7g2xlarge_corpus' ORDER BY i.relname;",
        "--log-output",
        "benchmarks/aws-spire-1m/001-run/artifacts/pipeline-recall-cache-sweep-500/precheck-existing-spire-1m-index.log"
      ],
      "expected_artifacts": ["benchmarks/aws-spire-1m/001-run/artifacts/pipeline-recall-cache-sweep-500/precheck-existing-spire-1m-index.log"]
    },
    {
      "kind": "spire-pipeline",
      "name": "pipeline-spire-1m-rabitq-global1152-recall-cache-sweep-500",
      "tags": ["pipeline", "recall", "aws", "1m", "spire", "rabitq", "global1152", "truth-cache", "q500", "sweep"],
      "pgoptions": "-c ec_spire.leaf_block_pruning_max_blocks_per_leaf=0 -c ec_spire.leaf_block_pruning_max_global_blocks=1152 -c ec_spire.leaf_block_pruning_global_probe_blocks=0 -c ec_spire.leaf_block_pruning_sample_rows_per_block=0 -c ec_spire.leaf_block_pruning_sample_summary_prior_weight=0.8 -c ec_spire.leaf_block_pruning_summary_radius_weight=0.25 -c ec_spire.leaf_block_pruning_route_prior_weight=0.0",
      "prefix": "task67_1m_hnsw_m7g2xlarge",
      "index": "aws_spire_1m_rabitq_global1152_idx",
      "queries_limit": 500,
      "sweep": [96, 128, 256],
      "rerank_width": 25,
      "include_cost_snapshot": true,
      "include_query_metrics": true,
      "include_recall": true,
      "truth_cache_file": "benchmarks/task51-aws-ivf-rabitq-final-gate/artifacts/truth-aws-real-1m-q500-k10.json",
      "query_metric_k": 10,
      "query_metric_projection_columns": ["id"],
      "log_output": "benchmarks/aws-spire-1m/001-run/artifacts/pipeline-recall-cache-sweep-500/pipeline-spire-1m-rabitq-global1152-recall-cache-sweep-500.log"
    }
  ]
}
