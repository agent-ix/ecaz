{
  "name": "profile-hnsw-1m",
  "schema_version": 1,
  "artifact_dir": "benchmarks/profile-hnsw-1m/artifacts",
  "defaults": {
    "profile": "ec_hnsw",
    "bits": 4,
    "seed": 42,
    "queries_limit": 100,
    "iterations": 100,
    "force_index": true,
    "sample_backend_memory": true,
    "memory_sample_interval_ms": 25,
    "pg": 18
  },
  "thresholds": [],
  "steps": [
    {
      "kind": "load",
      "name": "load-hnsw-real1m-m16",
      "tags": ["load", "hnsw", "real1m", "m16"],
      "prefix": "ec_hnsw_real_ann_benchmarks_anchor",
      "manifest_file": "data/benchmark-profile-inputs/dbpedia-openai3-1m-staged/ec_hnsw_real_ann_benchmarks_anchor_manifest.json",
      "chunked": true,
      "profile": "ec_hnsw",
      "m": [16],
      "ef_construction": 128,
      "log_file": "benchmarks/profile-hnsw-1m/artifacts/load-hnsw-real1m-m16.log"
    },
    {
      "kind": "recall",
      "name": "recall-hnsw-real1m-ef-sweep",
      "tags": ["recall", "hnsw", "real1m", "m16"],
      "prefix": "ec_hnsw_real_ann_benchmarks_anchor",
      "profile": "ec_hnsw",
      "k": 10,
      "sweep": [40, 64, 100, 128, 160, 200],
      "truth_cache_file": "benchmarks/profile-hnsw-1m/artifacts/truth-real1m-k10.json",
      "log_output": "benchmarks/profile-hnsw-1m/artifacts/recall-hnsw-real1m-ef-sweep.log"
    },
    {
      "kind": "latency",
      "name": "latency-hnsw-real1m-ef-sweep",
      "tags": ["latency", "hnsw", "real1m", "m16"],
      "prefix": "ec_hnsw_real_ann_benchmarks_anchor",
      "profile": "ec_hnsw",
      "k": 10,
      "sweep": [40, 64, 100, 128, 160, 200],
      "log_output": "benchmarks/profile-hnsw-1m/artifacts/latency-hnsw-real1m-ef-sweep.log"
    },
    {
      "kind": "storage",
      "name": "storage-hnsw-real1m-m16",
      "tags": ["storage", "hnsw", "real1m", "m16"],
      "prefix": "ec_hnsw_real_ann_benchmarks_anchor",
      "log_file": "benchmarks/profile-hnsw-1m/artifacts/storage-hnsw-real1m-m16.log"
    },
    {
      "kind": "compare-pgvector",
      "name": "compare-pgvector-real1m-hnsw",
      "tags": ["compare", "pgvector", "hnsw", "real1m", "m16"],
      "prefix": "ec_hnsw_real_ann_benchmarks_anchor",
      "profile": "ec_hnsw",
      "k": 10,
      "sweep": [40, 64, 100, 128, 160, 200],
      "pgvector_m": 16,
      "pgvector_ef_construction": 128,
      "rebuild": true,
      "log_file": "benchmarks/profile-hnsw-1m/artifacts/compare-pgvector-real1m-hnsw.log"
    }
  ]
}
