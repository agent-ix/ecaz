{
  "name": "task61-hnsw-scan-frontier-overhead-100k",
  "schema_version": 1,
  "artifact_dir": "benchmarks/task61-hnsw-scan-frontier-overhead/artifacts",
  "defaults": {
    "pg": 18,
    "socket_dir": "/var/run/postgresql",
    "profile": "ec_hnsw",
    "seed": 42,
    "queries_limit": 200,
    "iterations": 200,
    "force_index": true,
    "sample_backend_memory": true,
    "memory_sample_interval_ms": 25
  },
  "steps": [
    {
      "kind": "corpus-prepare",
      "name": "prepare-ec-real-100k",
      "profile": "ec_real_100k",
      "parquet": "/var/lib/pgsql/18/datasets/dbpedia-openai3-1m/data",
      "output_dir": "/var/lib/pgsql/18/datasets/staged-task61-hnsw-scan-frontier-overhead"
    },
    {
      "kind": "load",
      "name": "load-100k-hnsw-default",
      "prefix": "task61_opt_100k_hnsw",
      "profile": "ec_hnsw",
      "corpus_file": "/var/lib/pgsql/18/datasets/staged-task61-hnsw-scan-frontier-overhead/ec_real_100k_corpus.tsv",
      "queries_file": "/var/lib/pgsql/18/datasets/staged-task61-hnsw-scan-frontier-overhead/ec_real_100k_queries.tsv",
      "manifest_file": "/var/lib/pgsql/18/datasets/staged-task61-hnsw-scan-frontier-overhead/ec_real_100k_manifest.json",
      "allow_manifest_mismatch": true,
      "m": [
        16
      ],
      "ef_construction": 128,
      "log_file": "benchmarks/task61-hnsw-scan-frontier-overhead/artifacts/load-100k-hnsw-default.log"
    },
    {
      "kind": "recall",
      "name": "recall-100k-hnsw-default",
      "prefix": "task61_opt_100k_hnsw",
      "profile": "ec_hnsw",
      "k": 10,
      "sweep": [
        40,
        64,
        100,
        128,
        160,
        200
      ],
      "truth_cache_file": "benchmarks/task61-hnsw-scan-frontier-overhead/artifacts/truth-100k-k10.json",
      "log_output": "benchmarks/task61-hnsw-scan-frontier-overhead/artifacts/recall-100k-hnsw-default.log"
    },
    {
      "kind": "latency",
      "name": "latency-100k-hnsw-default",
      "prefix": "task61_opt_100k_hnsw",
      "profile": "ec_hnsw",
      "sweep": [
        40,
        64,
        100,
        128,
        160,
        200
      ],
      "concurrency": 1,
      "cache_state": "post_recall_warm",
      "log_output": "benchmarks/task61-hnsw-scan-frontier-overhead/artifacts/latency-100k-hnsw-default.log"
    },
    {
      "kind": "storage",
      "name": "storage-100k-hnsw-default",
      "prefix": "task61_opt_100k_hnsw",
      "log_file": "benchmarks/task61-hnsw-scan-frontier-overhead/artifacts/storage-100k-hnsw-default.log"
    },
    {
      "kind": "explain",
      "name": "explain-100k-hnsw-ef200",
      "prefix": "task61_opt_100k_hnsw",
      "profile": "ec_hnsw",
      "index_name": "task61_opt_100k_hnsw_m16_idx",
      "nprobe": 200,
      "rerank_width": 0,
      "sql_file": "benchmarks/task61-hnsw-scan-frontier-overhead/artifacts/explain-100k-hnsw-ef200.sql",
      "log_output": "benchmarks/task61-hnsw-scan-frontier-overhead/artifacts/explain-100k-hnsw-ef200.log"
    }
  ]
}
