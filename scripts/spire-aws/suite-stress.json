{
  "name": "spire-aws-stress",
  "schema_version": 1,
  "artifact_dir": "scripts/spire-aws/artifacts/stress",
  "defaults": {
    "profile": "ec_spire",
    "bits": 4,
    "seed": 42,
    "pg": 18
  },
  "steps": [
    {
      "kind": "recall",
      "name": "13a3a-stress-recall-k10",
      "prefix": "ec_spire_aws_synth_10m",
      "k": 10,
      "sweep": [8, 16, 24, 32],
      "queries_limit": 10000
    },
    {
      "kind": "latency",
      "name": "13a3a-stress-latency-k10-c1",
      "prefix": "ec_spire_aws_synth_10m",
      "k": 10,
      "sweep": [8, 16, 24, 32],
      "concurrency": 1,
      "iterations": 2000
    },
    {
      "kind": "spire-pipeline",
      "name": "13e3-stress-production-read-profile-k10",
      "tags": ["phase13e", "production-read-profile", "stress"],
      "prefix": "ec_spire_aws_synth_10m",
      "queries_limit": 10000,
      "sweep": [8, 16, 24, 32],
      "top_k": 10,
      "include_remote": true,
      "require_remote_placements": true,
      "include_query_metrics": true,
      "include_recall": true,
      "include_production_read_profile": true,
      "production_read_only": true,
      "query_metric_k": 10,
      "query_metric_projection_columns": ["id"]
    }
  ]
}
