      "queries_file": "/var/lib/pgsql/18/datasets/staged-current/ec_real_1m_queries.tsv",
      "manifest_file": "/var/lib/pgsql/18/datasets/staged-current/ec_real_1m_manifest.json",
      "allow_manifest_mismatch": true,
      "m": [32],
      "ef_construction": 256
