    {
      "kind": "compare-pgvector",
      "name": "compare-100k-pgvector-ivfflat-l320",
      "tags": ["compare", "current", "aws-graviton", "comparators", "ec_real_100k", "pgvector", "ivfflat", "lists320"],
      "prefix": "current_g4_cmp_real100k_ivf_rabitq",
      "profile": "ec_ivf",
      "k": 10,
      "sweep": [16, 32, 48, 64, 80, 96, 128, 192, 256],
      "pgvector_am": "ivfflat",
      "pgvector_lists": 320,
      "pgvector_maintenance_work_mem": "4GB",
      "rebuild": true
