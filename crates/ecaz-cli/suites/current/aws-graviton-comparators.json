{
  "name": "current-aws-graviton-comparators",
  "schema_version": 1,
  "artifact_dir": "benchmarks/comparators-g4-recall-frontier-100k-1m/artifacts",
  "defaults": {
    "pg": 18,
    "socket_dir": "/var/run/postgresql",
    "bits": 4,
    "seed": 42,
    "queries_limit": 200,
    "iterations": 200,
    "force_index": true,
    "sample_backend_memory": true,
    "memory_sample_interval_ms": 25
  },
  "steps": [
    {
      "kind": "raw",
      "name": "precheck-host",
      "tags": ["setup", "precheck", "current", "aws-graviton", "comparators"],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "postgres",
        "--socket-dir",
        "/var/run/postgresql",
        "--raw",
        "--sql",
        "SELECT now() AS captured_at, version() AS postgres_version, current_setting('shared_buffers') AS shared_buffers, current_setting('work_mem') AS work_mem, current_setting('maintenance_work_mem') AS maintenance_work_mem, current_setting('effective_cache_size') AS effective_cache_size; SELECT extname, extversion FROM pg_extension WHERE extname IN ('ecaz', 'vector', 'vectorscale', 'vchord') ORDER BY extname; SELECT left(pg_read_file('/proc/cpuinfo', 0, 20000), 20000) AS cpuinfo_prefix; SELECT left(pg_read_file('/proc/meminfo', 0, 12000), 12000) AS meminfo_prefix;",
        "--log-output",
        "${artifact_dir}/precheck-host.log"
      ],
      "expected_artifacts": ["${artifact_dir}/precheck-host.log"]
    },

    {
      "kind": "load",
      "name": "load-100k-diskann",
      "tags": ["load", "current", "aws-graviton", "comparators", "ec_real_100k", "diskann"],
      "prefix": "current_g4_cmp_real100k_diskann",
      "profile": "ec_diskann",
      "corpus_file": "/var/lib/pgsql/18/datasets/staged-current/ec_real_100k_corpus.tsv",
      "queries_file": "/var/lib/pgsql/18/datasets/staged-current/ec_real_100k_queries.tsv",
      "manifest_file": "/var/lib/pgsql/18/datasets/staged-current/ec_real_100k_manifest.json",
      "allow_manifest_mismatch": true,
      "reloptions": ["graph_degree=32", "build_list_size=100", "alpha=1.2"]
    },
    {
      "kind": "load",
      "name": "load-100k-hnsw",
      "tags": ["load", "current", "aws-graviton", "comparators", "ec_real_100k", "hnsw"],
      "prefix": "current_g4_cmp_real100k_hnsw",
      "profile": "ec_hnsw",
      "corpus_file": "/var/lib/pgsql/18/datasets/staged-current/ec_real_100k_corpus.tsv",
      "queries_file": "/var/lib/pgsql/18/datasets/staged-current/ec_real_100k_queries.tsv",
      "manifest_file": "/var/lib/pgsql/18/datasets/staged-current/ec_real_100k_manifest.json",
      "allow_manifest_mismatch": true,
      "m": [32],
      "ef_construction": 256
    },
    {
      "kind": "load",
      "name": "load-100k-ivf-rabitq",
      "tags": ["load", "current", "aws-graviton", "comparators", "ec_real_100k", "ivf", "rabitq", "n320"],
      "prefix": "current_g4_cmp_real100k_ivf_rabitq",
      "profile": "ec_ivf",
      "corpus_file": "/var/lib/pgsql/18/datasets/staged-current/ec_real_100k_corpus.tsv",
      "queries_file": "/var/lib/pgsql/18/datasets/staged-current/ec_real_100k_queries.tsv",
      "manifest_file": "/var/lib/pgsql/18/datasets/staged-current/ec_real_100k_manifest.json",
      "allow_manifest_mismatch": true,
      "reloptions": ["storage_format=rabitq", "nlists=320", "nprobe=64", "rerank=off"]
    },

    {
      "kind": "compare-vectorscale",
      "name": "compare-100k-vectorscale-sl100",
      "tags": ["compare", "current", "aws-graviton", "comparators", "ec_real_100k", "vectorscale", "diskann", "sl100"],
      "prefix": "current_g4_cmp_real100k_diskann",
      "profile": "ec_diskann",
      "k": 10,
      "sweep": [64, 128, 200, 400, 800],
      "vectorscale_num_neighbors": 32,
      "vectorscale_build_search_list_size": 100,
      "vectorscale_max_alpha": 1.2,
      "rebuild": true
    },
    {
      "kind": "compare-vectorscale",
      "name": "compare-100k-vectorscale-sl200",
      "tags": ["compare", "current", "aws-graviton", "comparators", "ec_real_100k", "vectorscale", "diskann", "sl200"],
      "prefix": "current_g4_cmp_real100k_diskann",
      "profile": "ec_diskann",
      "k": 10,
      "sweep": [64, 128, 200, 400, 800],
      "vectorscale_num_neighbors": 32,
      "vectorscale_build_search_list_size": 200,
      "vectorscale_max_alpha": 1.2,
      "rebuild": true
    },
    {
      "kind": "compare-pgvector",
      "name": "compare-100k-pgvector-hnsw-m16-ef128",
      "tags": ["compare", "current", "aws-graviton", "comparators", "ec_real_100k", "pgvector", "hnsw", "m16", "ef128"],
      "prefix": "current_g4_cmp_real100k_hnsw",
      "profile": "ec_hnsw",
      "k": 10,
      "sweep": [40, 64, 80, 120, 160, 200, 320, 400, 800],
      "pgvector_am": "hnsw",
      "pgvector_m": 16,
      "pgvector_ef_construction": 128,
      "pgvector_maintenance_work_mem": "4GB",
      "rebuild": true
    },
    {
      "kind": "compare-pgvector",
      "name": "compare-100k-pgvector-hnsw-m32-ef128",
      "tags": ["compare", "current", "aws-graviton", "comparators", "ec_real_100k", "pgvector", "hnsw", "m32", "ef128"],
      "prefix": "current_g4_cmp_real100k_hnsw",
      "profile": "ec_hnsw",
      "k": 10,
      "sweep": [40, 64, 80, 120, 160, 200, 320, 400, 800],
      "pgvector_am": "hnsw",
      "pgvector_m": 32,
      "pgvector_ef_construction": 128,
      "pgvector_maintenance_work_mem": "4GB",
      "rebuild": true
    },
    {
