/target
/fuzz/target
/fuzz/artifacts
# /fuzz/corpus is intentionally tracked — `make fuzz-corpus-minimize`
# keeps it bounded after long campaigns (Task 46 §Exit Criteria #4).
/hardening/*/target
/.pgrx
Cargo.lock
__pycache__/
.codex
tmp/
/data/
**/.terraform/
*.tfstate
*.tfstate.*
infra/spire-aws/terraform.tfvars

# Local agent/session state and downloaded paper copies.
.claude/
CLAUDE.md
handoff.md
*.pdf

# Review packets may record TLS setup logs, but never private key material or
# compiled extension payloads.
reviews/**/artifacts/tls/**/*.key
reviews/**/artifacts/**/*.tar.gz
reviews/**/artifacts/**/*.so

# ── Review/benchmark packet cruft — never commit. See AGENTS.md ›
#    "Never Commit: Corpus Data, Operational Logs, and Polling Cruft".
#    Note: .gitignore only affects UNtracked files; already-committed copies
#    must be removed with a separate `git rm` pass.

# Corpus / query / ground-truth data dumps — regenerable via `ecaz corpus`;
# record the corpus prefix + scale + SHA in manifest.md instead. Scoped to
# packet trees so non-packet fixtures (e.g. fixtures/*.tsv) stay tracked.
reviews/**/*.tsv
reviews/**/*.tsv.gz
benchmarks/**/*.tsv
benchmarks/**/*.tsv.gz

# SSM tunnel / polling / diagnostic operational exhaust.
reviews/**/tunnel-state/
reviews/**/tunnel-*.log
reviews/**/*.tunneled.json
reviews/**/diagnostic-while-*/
reviews/**/pg-readonly-status.log

# Raw AWS SSM RunShellScript output trees (multi-MB stdout/stderr dumps).
reviews/**/awsrunShellScript/

# SSM command-invocation poll snapshots (keep *.final.json as cited evidence).
reviews/**/ssm-command-invocation.latest.json
reviews/**/list-command-invocations*.json

# Regenerable recall ground-truth caches.
reviews/**/truth-cache/
benchmarks/**/truth-cache/

# Raw per-query SPIRE pipeline diagnostics are large and usually regenerable.
# Commit compact summaries and suite-results.jsonl unless a packet explicitly
# needs a force-added raw diagnostic artifact.
reviews/**/pipeline-*-funnel.jsonl
reviews/**/pipeline-*-stage-containment.jsonl
reviews/**/pipeline-*-leaf-block-rank.jsonl
reviews/**/pipeline-*-target-block-rank.jsonl
reviews/**/pipeline-*-target-candidate-rank.jsonl
