{
  "name": "task130-tq4-smoke",
  "schema_version": 1,
  "artifact_dir": "reviews/task-130/001-clean-main-keep-set/artifacts/tq4-smoke-suite",
  "defaults": {
    "pg": 18,
    "socket_dir": "/Users/peter/.pgrx",
    "profile": "ec_ivf",
    "bits": 4,
    "seed": 42,
    "queries_limit": 100,
    "force_index": true
  },
  "thresholds": [],
  "steps": [
    {
      "kind": "load",
      "name": "load-10k-tq4-final15",
      "tags": [
        "task130",
        "load",
        "ec_real_10k",
        "ivf",
        "turboquant",
        "final15"
      ],
      "prefix": "task130_tq4_smoke_10k",
      "corpus_file": "data/staged-current/ec_real_10k_corpus.tsv",
      "queries_file": "data/staged-current/ec_real_10k_queries.tsv",
      "manifest_file": "data/staged-current/ec_real_10k_manifest.json",
      "allow_manifest_mismatch": true,
      "storage_format": "coarse_rerank",
      "reloptions": [
        "nlists=64",
        "nprobe=32",
        "training_sample_rows=10000",
        "coarse_format=rabitq",
        "coarse_bits=1",
        "rerank=heap_f32",
        "rerank_placement=index",
        "rerank_format=turboquant",
        "rerank_width=100",
        "stage2_final_rerank_width=15"
      ],
      "log_file": "${artifact_dir}/load-10k-tq4-final15.log"
    },
    {
      "kind": "recall",
      "name": "recall-10k-tq4-final15",
      "tags": [
        "task130",
        "recall",
        "ec_real_10k",
        "ivf",
        "turboquant",
        "final15"
      ],
      "prefix": "task130_tq4_smoke_10k",
      "k": 10,
      "sweep": [
        32,
        64
      ],
      "rerank_width": 100,
      "session_gucs": [
        "ec_ivf.stage2_final_rerank_width=15"
      ],
      "truth_cache_file": "${artifact_dir}/truth-10k-k10.json",
      "log_output": "${artifact_dir}/recall-10k-tq4-final15.log"
    }
  ]
}
