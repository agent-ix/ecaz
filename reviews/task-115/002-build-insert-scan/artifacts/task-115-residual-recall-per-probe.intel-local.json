    {
      "kind": "recall",
      "name": "recall-100k-ivf-rabitq-residual",
      "tags": ["recall", "task-115", "intel-local", "ec_real_100k", "ivf", "rabitq", "residual"],
      "prefix": "task115_real100k_ivf_rabitq_residual",
      "profile": "ec_ivf",
      "k": 10,
      "sweep": [8, 16, 24, 32, 48, 64]
    },
    {
      "kind": "latency",
      "name": "latency-100k-ivf-rabitq-residual",
      "tags": ["latency", "task-115", "intel-local", "ec_real_100k", "ivf", "rabitq", "residual"],
      "prefix": "task115_real100k_ivf_rabitq_residual",
      "profile": "ec_ivf",
      "k": 10,
      "sweep": [8, 16, 24, 32, 48, 64],
      "concurrency": 1,
      "cache_state": "post_recall_warm"
    },
    {
      "kind": "storage",
      "name": "storage-100k-ivf-rabitq-residual",
      "tags": ["storage", "task-115", "intel-local", "ec_real_100k", "ivf", "rabitq", "residual"],
      "prefix": "task115_real100k_ivf_rabitq_residual"
    }
  ]
