{
  "name": "task120-phase1-attribution-rerun",
  "schema_version": 1,
  "artifact_dir": "reviews/task-120/009-phase1-attribution-rerun/artifacts",
  "defaults": {
    "profile": "ec_spire",
    "bits": 4,
    "seed": 42,
    "queries_limit": 200,
    "iterations": 200,
    "force_index": true,
    "sample_backend_memory": true,
    "memory_sample_interval_ms": 25,
    "pg": 18,
    "socket_dir": "/home/peter/.pgrx"
  },
  "thresholds": [],
  "steps": [
    {
      "kind": "raw",
      "name": "precheck-host",
      "tags": ["setup", "precheck", "task120", "phase1", "attribution", "intel-local"],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "tqvector_bench_task120",
        "--socket-dir",
        "/home/peter/.pgrx",
        "--raw",
        "--sql",
        "LOAD 'ecaz'; SELECT now() AS captured_at, version() AS postgres_version, current_setting('shared_buffers') AS shared_buffers, current_setting('work_mem') AS work_mem, current_setting('maintenance_work_mem') AS maintenance_work_mem, current_setting('effective_cache_size') AS effective_cache_size, current_setting('ec_spire.leaf_block_rows') AS leaf_block_rows, current_setting('ec_spire.leaf_block_summary_representatives') AS leaf_block_summary_representatives;",
        "--log-output",
        "${artifact_dir}/precheck-host.log"
      ],
      "expected_artifacts": ["${artifact_dir}/precheck-host.log"]
    },
    {
      "kind": "load",
      "name": "load-10k-spire",
      "tags": ["load", "task120", "phase1", "attribution", "intel-local", "ec_real_10k", "spire"],
      "prefix": "task120_phase1_rerun_real10k_spire",
      "profile": "ec_spire",
      "corpus_file": "data/staged-current/ec_real_10k_corpus.tsv",
      "queries_file": "data/staged-current/ec_real_10k_queries.tsv",
      "manifest_file": "data/staged-current/ec_real_10k_manifest.json",
      "allow_manifest_mismatch": true,
      "log_file": "${artifact_dir}/load-10k-spire.log"
    },
    {
      "kind": "spire-pipeline",
      "name": "pipeline-10k-spire",
      "tags": ["pipeline", "containment", "task120", "phase1", "attribution", "intel-local", "ec_real_10k", "spire"],
      "prefix": "task120_phase1_rerun_real10k_spire",
      "sweep": [8, 16, 24, 32],
      "include_query_metrics": true,
      "include_recall": true,
      "include_local_store_overlap": true,
      "truth_corpus_file": "data/staged-current/ec_real_10k_corpus.tsv",
      "log_output": "${artifact_dir}/pipeline-10k-spire.log",
      "funnel_output": "${artifact_dir}/pipeline-10k-funnel.jsonl",
      "stage_containment_output": "${artifact_dir}/pipeline-10k-stage-containment.jsonl",
      "leaf_block_rank_output": "${artifact_dir}/pipeline-10k-leaf-block-rank.jsonl",
      "target_block_rank_output": "${artifact_dir}/pipeline-10k-target-block-rank.jsonl",
      "target_candidate_rank_output": "${artifact_dir}/pipeline-10k-target-candidate-rank.jsonl"
    },
    {
      "kind": "load",
      "name": "load-50k-spire",
      "tags": ["load", "task120", "phase1", "attribution", "intel-local", "ec_real_50k", "spire"],
      "prefix": "task120_phase1_rerun_real50k_spire",
      "profile": "ec_spire",
      "corpus_file": "data/staged-current/ec_real_50k_corpus.tsv",
      "queries_file": "data/staged-current/ec_real_50k_queries.tsv",
      "manifest_file": "data/staged-current/ec_real_50k_manifest.json",
      "allow_manifest_mismatch": true,
      "log_file": "${artifact_dir}/load-50k-spire.log"
    },
    {
      "kind": "spire-pipeline",
      "name": "pipeline-50k-spire",
      "tags": ["pipeline", "containment", "task120", "phase1", "attribution", "intel-local", "ec_real_50k", "spire"],
      "prefix": "task120_phase1_rerun_real50k_spire",
      "sweep": [8, 16, 24, 32],
      "include_query_metrics": true,
      "include_recall": true,
      "include_local_store_overlap": true,
      "truth_corpus_file": "data/staged-current/ec_real_50k_corpus.tsv",
      "log_output": "${artifact_dir}/pipeline-50k-spire.log",
      "funnel_output": "${artifact_dir}/pipeline-50k-funnel.jsonl",
      "stage_containment_output": "${artifact_dir}/pipeline-50k-stage-containment.jsonl",
      "leaf_block_rank_output": "${artifact_dir}/pipeline-50k-leaf-block-rank.jsonl",
      "target_block_rank_output": "${artifact_dir}/pipeline-50k-target-block-rank.jsonl",
      "target_candidate_rank_output": "${artifact_dir}/pipeline-50k-target-candidate-rank.jsonl"
    },
    {
      "kind": "load",
      "name": "load-100k-spire",
      "tags": ["load", "task120", "phase1", "attribution", "intel-local", "ec_real_100k", "spire"],
      "prefix": "task120_phase1_rerun_real100k_spire",
      "profile": "ec_spire",
      "corpus_file": "data/staged-current/ec_real_100k_corpus.tsv",
      "queries_file": "data/staged-current/ec_real_100k_queries.tsv",
      "manifest_file": "data/staged-current/ec_real_100k_manifest.json",
      "allow_manifest_mismatch": true,
      "log_file": "${artifact_dir}/load-100k-spire.log"
    },
    {
      "kind": "spire-pipeline",
      "name": "pipeline-100k-spire",
      "tags": ["pipeline", "containment", "task120", "phase1", "attribution", "intel-local", "ec_real_100k", "spire"],
      "prefix": "task120_phase1_rerun_real100k_spire",
      "sweep": [8, 16, 24, 32],
      "include_query_metrics": true,
      "include_recall": true,
      "include_local_store_overlap": true,
      "truth_corpus_file": "data/staged-current/ec_real_100k_corpus.tsv",
      "log_output": "${artifact_dir}/pipeline-100k-spire.log",
      "funnel_output": "${artifact_dir}/pipeline-100k-funnel.jsonl",
      "stage_containment_output": "${artifact_dir}/pipeline-100k-stage-containment.jsonl",
      "leaf_block_rank_output": "${artifact_dir}/pipeline-100k-leaf-block-rank.jsonl",
      "target_block_rank_output": "${artifact_dir}/pipeline-100k-target-block-rank.jsonl",
      "target_candidate_rank_output": "${artifact_dir}/pipeline-100k-target-candidate-rank.jsonl"
    }
  ]
}
