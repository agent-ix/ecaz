{
  "name": "task111e-compact-sidecar-rerank",
  "schema_version": 1,
  "artifact_dir": "reviews/task-111e/005-compact-sidecar-rerank/artifacts/suite",
  "defaults": {
    "profile": "ec_ivf",
    "bits": 4,
    "seed": 42,
    "queries_limit": 100,
    "force_index": true,
    "pg": 18,
    "socket_dir": "/home/peter/.pgrx"
  },
  "steps": [
    {
      "kind": "load",
      "name": "load-50k-rb1-dense-page-rerank-off",
      "tags": [
        "task111e",
        "load",
        "real50k",
        "rabitq",
        "bits1",
        "dense",
        "page-local",
        "rerank-off"
      ],
      "prefix": "task111e_005_50k_rb1_dense_page_off",
      "storage_format": "rabitq",
      "corpus_file": "data/task111a_real50k/ec_real_50k_corpus.tsv",
      "queries_file": "data/task111a_real50k/ec_real_50k_queries.tsv",
      "manifest_file": "data/task111a_real50k/ec_real_50k_manifest.json",
      "allow_manifest_mismatch": true,
      "reloptions": [
        "nlists=64",
        "nprobe=32",
        "quant_bits=1",
        "training_sample_rows=10000",
        "dense_posting_blocks=1",
        "dense_posting_pack_pages=1",
        "dense_posting_typed_layout=1",
        "rerank=off"
      ],
      "log_file": "${artifact_dir}/load-50k-rb1-dense-page-rerank-off.log"
    },
    {
      "kind": "sidecar-rerank",
      "name": "compact-sidecar-50k-k50-p32",
      "tags": [
        "task111e",
        "compact-sidecar",
        "real50k",
        "candidate_k50",
        "f32",
        "f16",
        "rabitq8"
      ],
      "prefix": "task111e_005_50k_rb1_dense_page_off",
      "profile": "ec_ivf",
      "k": 10,
      "candidate_k": 50,
      "concurrency": 1,
      "sweep": [32],
      "queries_limit": 100,
      "warmup_queries": 10,
      "variants": ["f32", "f16", "rabitq8"],
      "read_modes": ["free", "random-id", "tid-sorted"],
      "rebuild_sidecar_table": true,
      "force_index": true,
      "log_output": "reviews/task-111e/005-compact-sidecar-rerank/artifacts/compact-sidecar-50k-k50-p32.log"
    },
    {
      "kind": "sidecar-rerank",
      "name": "compact-sidecar-50k-k100-p32",
      "tags": [
        "task111e",
        "compact-sidecar",
        "real50k",
        "candidate_k100",
        "f32",
        "f16",
        "rabitq8"
      ],
      "prefix": "task111e_005_50k_rb1_dense_page_off",
      "profile": "ec_ivf",
      "k": 10,
      "candidate_k": 100,
      "concurrency": 1,
      "sweep": [32],
      "queries_limit": 100,
      "warmup_queries": 10,
      "variants": ["f32", "f16", "rabitq8"],
      "read_modes": ["free", "random-id", "tid-sorted"],
      "force_index": true,
      "log_output": "reviews/task-111e/005-compact-sidecar-rerank/artifacts/compact-sidecar-50k-k100-p32.log"
    }
  ]
}
