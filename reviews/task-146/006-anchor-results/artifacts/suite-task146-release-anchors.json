{
  "name": "task146-release-anchors",
  "schema_version": 1,
  "artifact_dir": "reviews/task-146/004-anchor-reporting-and-suite/artifacts/top-suite",
  "defaults": {
    "bits": 4,
    "seed": 42,
    "queries_limit": 200,
    "iterations": 200,
    "force_index": true,
    "sample_backend_memory": true,
    "memory_sample_interval_ms": 25,
    "pg": 18
  },
  "thresholds": [],
  "_doc": {
    "intent": "Task 146 matched-scale ecaz release anchors for the Pareto frontier table.",
    "step_count": "24 = 3 scales x 2 engines x load/recall/latency/storage",
    "validity": [
      "all cells use data/staged-current fixtures to match the Task 146 SPIRE matrix",
      "ec_ivf controls use pq_fastscan, pq_group_size=8, heap_f32 rerank, rerank_width=500",
      "ec_hnsw controls use m=16, ef_construction=128",
      "50k anchors are required because Task76 has only 10k and 100k ecaz controls"
    ]
  },
  "steps": [
    {
      "kind": "load",
      "name": "load-10k-ivf-control",
      "tags": ["load", "task146", "anchor", "10k", "ivf"],
      "prefix": "t146_anchor_10k_ivf",
      "profile": "ec_ivf",
      "corpus_file": "data/staged-current/ec_real_10k_corpus.tsv",
      "queries_file": "data/staged-current/ec_real_10k_queries.tsv",
      "manifest_file": "data/staged-current/ec_real_10k_manifest.json",
      "allow_manifest_mismatch": true,
      "reloptions": [
        "storage_format=pq_fastscan",
        "pq_group_size=8",
        "nlists=32",
        "nprobe=24",
        "rerank=heap_f32",
        "rerank_width=500"
      ],
      "log_file": "${artifact_dir}/load-10k-ivf-control.log"
    },
    {
      "kind": "recall",
      "name": "recall-10k-ivf-control",
      "tags": ["recall", "task146", "anchor", "10k", "ivf"],
      "prefix": "t146_anchor_10k_ivf",
      "profile": "ec_ivf",
      "k": 10,
      "sweep": [16, 24, 32],
      "rerank_width": 500,
      "truth_corpus_file": "data/staged-current/ec_real_10k_corpus.tsv",
      "log_output": "${artifact_dir}/recall-10k-ivf-control.log"
    },
    {
      "kind": "latency",
      "name": "latency-10k-ivf-control",
      "tags": ["latency", "task146", "anchor", "10k", "ivf"],
      "prefix": "t146_anchor_10k_ivf",
      "profile": "ec_ivf",
      "k": 10,
      "sweep": [16, 24, 32],
      "rerank_width": 500,
      "concurrency": 1,
      "cache_state": "post_recall_warm",
      "log_output": "${artifact_dir}/latency-10k-ivf-control.log"
    },
    {
      "kind": "storage",
      "name": "storage-10k-ivf-control",
      "tags": ["storage", "task146", "anchor", "10k", "ivf"],
      "prefix": "t146_anchor_10k_ivf",
      "log_file": "${artifact_dir}/storage-10k-ivf-control.log"
    },
