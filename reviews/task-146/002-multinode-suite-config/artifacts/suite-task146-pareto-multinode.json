  "thresholds": [],
  "_doc": {
    "intent": "Task 146 preregistered multinode release matrix config. This file defines the 10k/50k/100k x S1-S6 shapes from packet 001 without running them.",
    "validity": [
      "release spire-local-multinode only",
      "source_identity=include",
      "no closure/ratio pruning",
      "no bound-prune candidate",
      "no rerank-economy promotion",
      "standard nprobe sweep 8,16,32,64,96",
      "200 queries"
    ],
    "shape_ids": {
      "S1": "nlists=128, boundary_replica_count=0, defaults otherwise",
      "S2": "nlists=1024, boundary_replica_count=0, defaults otherwise",
      "S3": "nlists=1024, boundary_replica_count=2 fixed-replication control",
      "S4": "S2 plus ec_spire.leaf_score_only_routing=on",
      "S5": "S4 plus ec_spire.route_overfetch_multiplier=2.0",
      "S6": "S4 plus top_graph_search_list_size=200 and training_sample_rows=scale cap"
    }
  },
