    },
    {
      "kind": "latency",
      "name": "latency-100k-tq-w75-g50-final15-nprobe-refine",
      "tags": ["task124", "speed", "latency", "tq-nprobe-refine", "ec_real_100k", "turboquant", "w75", "g50", "final15"],
      "prefix": "task124_tq_bscore_w75_g50_100k",
