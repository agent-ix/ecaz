      "prefix": "task124_tq_bscore_w75_g50_100k",
      "k": 10,
      "sweep": [56, 58, 60, 62, 64],
      "rerank_width": 75,
      "queries_limit": 100,
      "session_gucs": ["ec_ivf.stage2_final_rerank_width=15"],
      "truth_cache_file": "${artifact_dir}/truth-100k-k10.json",
