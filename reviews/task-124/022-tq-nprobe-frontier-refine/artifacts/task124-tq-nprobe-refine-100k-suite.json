    {
      "kind": "storage",
      "name": "storage-100k-tq-w75-g50-final15-nprobe-refine",
      "tags": ["task124", "speed", "storage", "tq-nprobe-refine", "ec_real_100k", "turboquant", "w75", "g50", "final15", "reused-index"],
      "prefix": "task124_tq_bscore_w75_g50_100k",
      "log_file": "${artifact_dir}/storage-100k-tq-w75-g50-final15-nprobe-refine.log"
