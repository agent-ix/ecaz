+fn retain_ranked_prefix(
+    candidates: &mut Vec<EcIvfScoredCandidate>,
+    prefix_len: usize,
+    retained_len: usize,
+) {
+    debug_assert!(prefix_len <= candidates.len());
+    if retained_len >= prefix_len {
+        candidates[..prefix_len].sort_by(candidate_cmp);
+        return;
+    }
+    let retained = collect_ranked_probe_candidates(
+        candidates[..prefix_len].iter().copied(),
+        Some(retained_len),
+    );
+    candidates[..retained.len()].copy_from_slice(&retained);
+    candidates.truncate(retained.len());
+}
