+pub(super) fn encode_rerank_group_slot_tid(
+    group_tid: ItemPointer,
+    slot: usize,
+) -> Option<ItemPointer> {
+    if group_tid == ItemPointer::INVALID {
+        return None;
+    }
+    if group_tid.offset_number == 0 || group_tid.offset_number > 0x7F || slot > 0xFF {
+        return None;
+    }
+    Some(ItemPointer {
+        block_number: group_tid.block_number,
+        offset_number: RERANK_GROUP_SLOT_TID_MARKER
+            | (group_tid.offset_number << RERANK_GROUP_SLOT_TID_OFFSET_SHIFT)
+            | slot as u16,
+    })
+}
+
+pub(super) fn decode_rerank_group_slot_tid(
+    rerank_tid: ItemPointer,
+) -> (ItemPointer, Option<usize>) {
+    if rerank_tid == ItemPointer::INVALID
+        || rerank_tid.offset_number & RERANK_GROUP_SLOT_TID_MARKER == 0
+    {
+        return (rerank_tid, None);
+    }
+    let offset_number = (rerank_tid.offset_number & RERANK_GROUP_SLOT_TID_OFFSET_MASK)
+        >> RERANK_GROUP_SLOT_TID_OFFSET_SHIFT;
+    let slot = (rerank_tid.offset_number & RERANK_GROUP_SLOT_TID_SLOT_MASK) as usize;
+    (
+        ItemPointer {
+            block_number: rerank_tid.block_number,
+            offset_number,
+        },
+        Some(slot),
+    )
+}
