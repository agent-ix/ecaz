+fn rerank_group_payload_offset_for_slot(
+    header: &super::page::IvfRerankGroupHeaderTuple,
+    heap_tid: ItemPointer,
+    slot: usize,
+    expected_payload_len: usize,
+) -> Result<usize, String> {
+    if slot >= header.len() {
+        return Err(format!(
+            "ec_ivf rerank group slot {slot} is out of bounds for {} entries",
+            header.len()
+        ));
+    }
+    if header.is_deleted(slot) {
+        return Err(format!(
+            "ec_ivf rerank group slot {slot} is deleted for heap tid {:?}",
+            heap_tid
+        ));
+    }
+    let heap_start = usize::try_from(header.heap_tid_offsets[slot])
+        .map_err(|_| "ec_ivf rerank group heap offset conversion failed".to_owned())?;
+    let heap_count = usize::from(header.heap_tid_counts[slot]);
+    if heap_count != 1 {
+        return Err("ec_ivf direct rerank group slot requires a single heap tid".to_owned());
+    }
+    if header.heap_tids.get(heap_start).copied() != Some(heap_tid) {
+        return Err(format!(
+            "ec_ivf direct rerank group slot {slot} does not match heap tid {:?}",
+            heap_tid
+        ));
+    }
+    let payload_offset = usize::try_from(header.payload_offsets[slot])
+        .map_err(|_| "ec_ivf rerank group payload offset conversion failed".to_owned())?;
+    payload_offset
+        .checked_add(expected_payload_len)
+        .ok_or_else(|| "ec_ivf rerank group payload range overflow".to_owned())?;
+    Ok(payload_offset)
+}
