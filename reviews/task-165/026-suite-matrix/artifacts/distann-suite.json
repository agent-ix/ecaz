        "tqvector_bench",
        "--socket-dir",
        "/home/peter/.pgrx",
        "--raw",
        "--sql",
        "SELECT now() AS captured_at, version() AS postgres_version, current_setting('shared_buffers') AS shared_buffers, current_setting('maintenance_work_mem') AS maintenance_work_mem;",
