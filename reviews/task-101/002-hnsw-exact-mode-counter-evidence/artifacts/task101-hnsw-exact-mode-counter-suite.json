        "corpus",
        "generate",
        "--output",
        "reviews/task-101/002-hnsw-exact-mode-counter-evidence/artifacts/task101_hnsw_tq_1k_corpus.tsv",
        "--n",
        "1000",
        "--dim",
        "1536",
        "--seed",
        "4201",
        "--kind",
        "corpus"
      ],
      "expected_artifacts": [
        "reviews/task-101/002-hnsw-exact-mode-counter-evidence/artifacts/task101_hnsw_tq_1k_corpus.tsv"
      ]
    },
    {
      "kind": "raw",
      "name": "generate-hnsw-tq-1k-queries",
      "tags": ["task101", "fixture", "generate", "queries"],
      "args": [
        "corpus",
        "generate",
        "--output",
        "reviews/task-101/002-hnsw-exact-mode-counter-evidence/artifacts/task101_hnsw_tq_1k_queries.tsv",
        "--n",
        "64",
        "--dim",
        "1536",
        "--seed",
        "4202",
        "--kind",
        "queries"
      ],
      "expected_artifacts": [
        "reviews/task-101/002-hnsw-exact-mode-counter-evidence/artifacts/task101_hnsw_tq_1k_queries.tsv"
      ]
    },
    {
      "kind": "load",
      "name": "load-hnsw-tq-1k",
      "tags": ["task101", "fixture", "hnsw", "turboquant", "synthetic1k"],
      "prefix": "task101_hnsw_tq_1k",
      "profile": "ec_hnsw",
      "storage_format": "turboquant",
      "bits": 4,
      "dim": 1536,
      "m": [16],
      "ef_construction": 128,
      "corpus_file": "reviews/task-101/002-hnsw-exact-mode-counter-evidence/artifacts/task101_hnsw_tq_1k_corpus.tsv",
      "queries_file": "reviews/task-101/002-hnsw-exact-mode-counter-evidence/artifacts/task101_hnsw_tq_1k_queries.tsv",
      "log_file": "${artifact_dir}/load-hnsw-tq-1k.log"
    },
    {
      "kind": "recall",
      "name": "recall-full_lut-1k-kernel-on",
      "tags": ["task101", "hnsw", "turboquant", "synthetic1k", "mode=full_lut", "kernel_on"],
      "prefix": "task101_hnsw_tq_1k",
      "profile": "ec_hnsw",
      "k": 10,
      "sweep": [80],
      "queries_limit": 64,
      "session_gucs": ["ec_hnsw.disable_binary_prefilter=on", "ec_hnsw.turboquant_exact_score_mode=full_lut"],
      "truth_cache_dir": "${artifact_dir}/truth-cache",
      "log_output": "${artifact_dir}/recall-full_lut-1k-kernel-on.log"
    },
    {
      "kind": "latency",
      "name": "latency-full_lut-1k-kernel-on",
