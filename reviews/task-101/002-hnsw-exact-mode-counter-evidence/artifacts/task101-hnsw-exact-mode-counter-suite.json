{
  "name": "task101-hnsw-exact-mode-counter-suite",
  "schema_version": 1,
  "artifact_dir": "reviews/task-101/002-hnsw-exact-mode-counter-evidence/artifacts",
  "defaults": {
    "pg": 18,
    "bits": 4,
    "seed": 42,
    "queries_limit": 64,
    "iterations": 32,
    "force_index": true,
    "sample_backend_memory": false
  },
  "steps": [
    {
      "kind": "raw",
      "name": "generate-hnsw-tq-1k-corpus",
      "tags": ["task101", "fixture", "generate", "corpus"],
