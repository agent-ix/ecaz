      "prefix": "task101_hnsw_tq_1k",
      "profile": "ec_hnsw",
      "k": 10,
      "sweep": [80],
      "iterations": 32,
      "concurrency": 1,
      "cache_state": "task101_full_lut_1k_on",
      "session_gucs": ["ec_hnsw.disable_binary_prefilter=on", "ec_hnsw.turboquant_exact_score_mode=full_lut"],
      "task87_candidate_batch_counters": true,
      "log_output": "${artifact_dir}/latency-full_lut-1k-kernel-on.log"
    },
    {
      "kind": "recall",
