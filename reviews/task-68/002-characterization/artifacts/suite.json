{
  "name": "task68-spire-build-characterization",
  "schema_version": 1,
  "artifact_dir": "reviews/task-68/002-characterization/artifacts",
  "defaults": {
    "bits": 4,
    "seed": 42,
    "socket_dir": "/Users/peter/.pgrx",
    "pg": 18,
    "profile": "ec_spire"
  },
  "steps": [
    {
      "kind": "raw",
      "name": "precheck-host",
      "tags": ["setup", "precheck", "task68", "spire"],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "task68_spire_char",
        "--socket-dir",
        "/Users/peter/.pgrx",
        "--raw",
        "--sql",
        "SELECT now() AS captured_at, version() AS postgres_version, current_setting('shared_buffers') AS shared_buffers, current_setting('work_mem') AS work_mem, current_setting('maintenance_work_mem') AS maintenance_work_mem, current_setting('effective_cache_size') AS effective_cache_size;",
        "--log-output",
        "reviews/task-68/002-characterization/artifacts/precheck-host.log"
      ],
      "expected_artifacts": [
        "reviews/task-68/002-characterization/artifacts/precheck-host.log"
      ]
    },
    {
      "kind": "raw",
      "name": "setup-extension",
      "tags": ["setup", "extension", "task68", "spire"],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "task68_spire_char",
        "--socket-dir",
        "/Users/peter/.pgrx",
        "--raw",
        "--sql",
        "CREATE EXTENSION IF NOT EXISTS ecaz; SELECT extname, extversion FROM pg_extension WHERE extname = 'ecaz'; SELECT amname FROM pg_am WHERE amname LIKE 'ec_%' ORDER BY amname;",
        "--log-output",
        "reviews/task-68/002-characterization/artifacts/setup-extension.log"
      ],
      "expected_artifacts": [
        "reviews/task-68/002-characterization/artifacts/setup-extension.log"
      ]
    },
    {
      "kind": "raw",
      "name": "cleanup-prior-task68-relations",
      "tags": ["setup", "cleanup", "task68", "spire"],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "task68_spire_char",
        "--socket-dir",
        "/Users/peter/.pgrx",
        "--raw",
        "--sql",
        "DROP TABLE IF EXISTS task68_spire_10k_load_corpus CASCADE; DROP TABLE IF EXISTS task68_spire_10k_load_queries CASCADE; DROP TABLE IF EXISTS task68_spire_100k_load_corpus CASCADE; DROP TABLE IF EXISTS task68_spire_100k_load_queries CASCADE;",
        "--log-output",
        "reviews/task-68/002-characterization/artifacts/cleanup-prior-task68-relations.log"
      ],
      "expected_artifacts": [
        "reviews/task-68/002-characterization/artifacts/cleanup-prior-task68-relations.log"
      ]
    },
    {
      "kind": "load",
      "name": "load-10k-spire-turboquant",
      "tags": ["load", "ec_real_10k", "spire", "turboquant", "task68"],
      "prefix": "task68_spire_10k_load",
      "profile": "ec_spire",
      "storage_format": "turboquant",
      "corpus_file": "data/task31_m5_dbpedia_staged/ec_hnsw_real_10k_corpus.tsv",
      "queries_file": "data/task31_m5_dbpedia_staged/ec_hnsw_real_10k_queries.tsv",
      "manifest_file": "data/task31_m5_dbpedia_staged/ec_hnsw_real_10k_manifest.json",
      "allow_manifest_mismatch": true,
      "reloptions": [
        "nlists=32",
        "recursive_fanout=8",
        "nprobe=24",
        "rerank_width=25",
        "boundary_replica_count=0"
      ],
      "log_file": "reviews/task-68/002-characterization/artifacts/load-10k-spire-turboquant.log"
    },
    {
      "kind": "raw",
      "name": "create-10k-spire-profile-index",
      "tags": ["create-index", "ec_real_10k", "spire", "turboquant", "task68"],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "task68_spire_char",
        "--socket-dir",
        "/Users/peter/.pgrx",
        "--raw",
        "--sql",
        "SET client_min_messages TO notice; DROP INDEX IF EXISTS task68_spire_10k_load_turboquant_idx; DROP INDEX IF EXISTS task68_spire_10k_profile_idx; CREATE INDEX task68_spire_10k_profile_idx ON task68_spire_10k_load_corpus USING ec_spire (embedding ecvector_spire_ip_ops) WITH (nlists = 32, recursive_fanout = 8, nprobe = 24, rerank_width = 25, storage_format = 'turboquant', boundary_replica_count = 0, top_graph_enabled = 1, top_graph_degree = 32, top_graph_build_list_size = 100, top_graph_search_list_size = 16);",
        "--log-output",
        "reviews/task-68/002-characterization/artifacts/create-10k-spire-profile-index.log"
      ],
      "expected_artifacts": [
        "reviews/task-68/002-characterization/artifacts/create-10k-spire-profile-index.log"
      ]
    },
    {
      "kind": "load",
      "name": "load-100k-spire-turboquant",
      "tags": ["load", "ec_real_100k", "spire", "turboquant", "task68"],
      "prefix": "task68_spire_100k_load",
      "profile": "ec_spire",
      "storage_format": "turboquant",
      "corpus_file": "data/task60_m5_dbpedia_staged/ec_real_100k_corpus.tsv",
      "queries_file": "data/task60_m5_dbpedia_staged/ec_real_100k_queries.tsv",
      "manifest_file": "data/task60_m5_dbpedia_staged/ec_real_100k_manifest.json",
      "allow_manifest_mismatch": true,
      "reloptions": [
        "nlists=128",
        "recursive_fanout=8",
        "nprobe=24",
        "rerank_width=25",
        "boundary_replica_count=0"
      ],
      "log_file": "reviews/task-68/002-characterization/artifacts/load-100k-spire-turboquant.log"
    },
    {
      "kind": "raw",
      "name": "create-100k-spire-profile-index",
      "tags": ["create-index", "ec_real_100k", "spire", "turboquant", "task68"],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "task68_spire_char",
        "--socket-dir",
        "/Users/peter/.pgrx",
        "--raw",
        "--sql",
        "SET client_min_messages TO notice; DROP INDEX IF EXISTS task68_spire_100k_load_turboquant_idx; DROP INDEX IF EXISTS task68_spire_100k_profile_idx; CREATE INDEX task68_spire_100k_profile_idx ON task68_spire_100k_load_corpus USING ec_spire (embedding ecvector_spire_ip_ops) WITH (nlists = 128, recursive_fanout = 8, nprobe = 24, rerank_width = 25, storage_format = 'turboquant', boundary_replica_count = 0, top_graph_enabled = 1, top_graph_degree = 32, top_graph_build_list_size = 100, top_graph_search_list_size = 16);",
        "--log-output",
        "reviews/task-68/002-characterization/artifacts/create-100k-spire-profile-index.log"
      ],
      "expected_artifacts": [
        "reviews/task-68/002-characterization/artifacts/create-100k-spire-profile-index.log"
      ]
    }
  ]
}
