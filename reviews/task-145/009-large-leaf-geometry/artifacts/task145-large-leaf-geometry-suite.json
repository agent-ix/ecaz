  "thresholds": [],
  "_doc": {
    "intent": "Task 145 AC3 large-leaf geometry measurement. Compare 100k fine nlists=1024 against fewer-larger-leaves nlists=128 with block summaries built, block pruning enabled, rerank_width=50, and ratio probing variants held constant across both cells.",
    "cells": [
      "100k n1024/b0 fine frontier control",
      "100k n128/b0 fewer-larger-leaves candidate"
    ],
    "nprobe_sweep": [
      8,
      16,
      32,
      64,
      96
    ],
    "queries_limit": 200,
    "held_constant": [
      "storage_format=rabitq",
      "boundary_replica_count=0",
      "source_identity=include",
      "leaf_score_only_routing=on",
      "route_overfetch_multiplier=1.0",
      "rerank_width=50",
      "max_candidate_rows=100",
      "leaf_block_pruning_max_global_blocks=128",
      "max_remote_payload_bytes_per_row=16384"
    ],
    "block_summary_build": [
      "ec_spire.leaf_block_rows=16",
      "ec_spire.leaf_block_summary_representatives=2"
    ],
    "variants": [
      "fixed: probe_distance_ratio=0",
      "ratio4: probe_distance_ratio=4.0",
      "ratio8: probe_distance_ratio=8.0"
    ],
    "note": "This is the explicit 100k AC3 large-leaf geometry cell requested by the task. If promising, extend to 10k/50k before Task 145 closeout."
  },
