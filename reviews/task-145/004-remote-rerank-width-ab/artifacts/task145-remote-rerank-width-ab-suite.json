    "intent": "Task 145 Phase 0 remote-path rerank_width A/B. This exercises the coordinator remote production-read path after the packet 003 fix and isolates ec_spire.rerank_width=0 versus 50.",
    "scales": ["10k n128/b0", "50k n1024/b0", "100k n1024/b0"],
    "nprobe_sweep": [8, 16, 32, 64, 96],
    "queries_limit": 200,
    "held_constant": [
      "storage_format=rabitq",
      "boundary_replica_count=0",
      "source_identity=include",
      "leaf_score_only_routing=on",
      "route_overfetch_multiplier=1.0",
      "probe_distance_ratio=0",
      "max_remote_payload_bytes_per_row=16384"
    ]
  },
  "steps": [
