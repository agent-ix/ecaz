{
  "name": "task145-rerank-width-ab",
  "schema_version": 1,
  "artifact_dir": "reviews/task-145/001-rerank-width-ab/artifacts",
  "defaults": {
    "profile": "ec_spire",
    "bits": 4,
    "seed": 42,
    "queries_limit": 200,
    "iterations": 200,
    "force_index": true,
    "sample_backend_memory": true,
    "memory_sample_interval_ms": 25,
    "pg": 18,
    "socket_dir": "/home/peter/dev/ecaz/target/task145-pg18-socket"
  },
  "thresholds": [],
  "_doc": {
    "intent": "Task 145 Phase 0 rerank_width economy A/B. This isolates rerank_width=0 full-frontier behavior against rerank_width=50 while holding the Task 143 positive leaf-only routing candidate constant and leaving Task 144 closure/ratio pruning off.",
    "scales": ["10k n128/b0", "50k n1024/b0", "100k n1024/b0"],
    "nprobe_sweep": [8, 16, 32, 64, 96],
    "queries_limit": 200
  },
  "steps": [
    {
      "kind": "raw",
      "name": "precheck-host",
      "tags": ["setup", "precheck", "task145", "release"],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "tqvector_bench_task145",
        "--socket-dir",
        "/home/peter/dev/ecaz/target/task145-pg18-socket",
        "--raw",
        "--sql",
        "LOAD 'ecaz'; SELECT now() AS captured_at, version() AS postgres_version, ecaz_build_profile() AS ecaz_build_profile, current_setting('ec_spire.rerank_width') AS session_rerank_width, current_setting('ec_spire.leaf_score_only_routing') AS leaf_score_only_routing;",
        "--log-output",
        "${artifact_dir}/precheck-host.log"
      ],
      "expected_artifacts": ["${artifact_dir}/precheck-host.log"]
    },
    {
      "kind": "load",
      "name": "load-10k-n128-index",
      "tags": ["load", "task145", "10k", "n128", "storage_format=rabitq"],
      "prefix": "t145_10k_n128_rerank_ab",
      "index_name": "t145_10k_n128_rerank_ab_idx",
      "dim": 1536,
      "corpus_file": "data/staged-current/ec_real_10k_corpus.tsv",
      "queries_file": "data/staged-current/ec_real_10k_queries.tsv",
      "manifest_file": "data/staged-current/ec_real_10k_manifest.json",
      "allow_manifest_mismatch": true,
      "storage_format": "rabitq",
      "reloptions": [
        "nlists=128",
        "recursive_fanout=8",
        "top_graph_enabled=1",
        "top_graph_degree=32",
        "top_graph_build_list_size=100",
        "top_graph_search_list_size=96",
        "boundary_replica_count=0",
        "training_sample_rows=10000",
        "source_identity=include"
      ],
      "log_file": "${artifact_dir}/load-10k-n128-index.log"
    },
    {
      "kind": "storage",
      "name": "storage-10k-n128-index",
      "tags": ["storage", "task145", "10k", "n128"],
      "prefix": "t145_10k_n128_rerank_ab",
      "log_file": "${artifact_dir}/storage-10k-n128-index.log"
    },
    {
      "kind": "recall",
      "name": "truth-cache-10k-q200-k10",
      "tags": ["recall", "truth-cache", "task145", "10k", "n128"],
      "prefix": "t145_10k_n128_rerank_ab",
      "k": 10,
      "sweep": [96],
      "queries_limit": 200,
      "profile": "ec_spire",
      "force_index": true,
      "truth_corpus_file": "data/staged-current/ec_real_10k_corpus.tsv",
      "truth_cache_file": "${artifact_dir}/truth-cache-10k-q200-k10.json",
      "log_output": "${artifact_dir}/truth-cache-10k-q200-k10.log"
    },
    {
      "kind": "spire-pipeline",
      "name": "pipeline-10k-rerank-full",
      "tags": ["pipeline", "task145", "10k", "n128", "variant=rerank_width_0"],
      "prefix": "t145_10k_n128_rerank_ab",
      "queries_limit": 200,
      "sweep": [8, 16, 32, 64, 96],
      "rerank_width": 0,
      "include_query_metrics": true,
      "include_recall": true,
      "include_local_store_overlap": true,
      "include_cost_snapshot": true,
      "truth_corpus_file": "data/staged-current/ec_real_10k_corpus.tsv",
      "truth_cache_file": "${artifact_dir}/truth-cache-10k-q200-k10.json",
      "session_gucs": [
        "ec_spire.leaf_score_only_routing=on",
        "ec_spire.route_overfetch_multiplier=1.0",
        "ec_spire.probe_distance_ratio=0"
      ],
      "log_output": "${artifact_dir}/pipeline-10k-rerank-full.log"
    },
    {
      "kind": "spire-pipeline",
      "name": "pipeline-10k-rerank-50",
