{
  "name": "task145-remote-block-pruning-ab",
  "schema_version": 1,
  "artifact_dir": "reviews/task-145/007-remote-block-pruning-ab/artifacts/top-suite",
  "defaults": {
    "pg": 18
  },
  "thresholds": [],
  "_doc": {
    "intent": "Task 145 remote-path block-pruning A/B after remote leaf-block pruning GUC propagation. Each cell builds leaf block summaries, then compares pruning off vs global block pruning on through production-read variants.",
    "control_reference": "reviews/task-145/006-remote-rerank-width-ab-rerun contains the no-summary rerank_width=50 control for storage and latency context.",
    "scales": [
      "10k n128/b0",
      "50k n1024/b0",
      "100k n1024/b0"
    ],
    "nprobe_sweep": [
      8,
      16,
      32,
      64,
      96
    ],
    "queries_limit": 200,
    "held_constant": [
      "storage_format=rabitq",
      "boundary_replica_count=0",
      "source_identity=include",
      "leaf_score_only_routing=on",
      "route_overfetch_multiplier=1.0",
      "probe_distance_ratio=0",
      "rerank_width=50",
      "max_candidate_rows=100",
      "max_remote_payload_bytes_per_row=16384"
    ],
    "block_summary_build": [
      "ec_spire.leaf_block_rows=16",
      "ec_spire.leaf_block_summary_representatives=2"
    ]
  },
  "steps": [
    {
      "kind": "spire-local-multinode",
      "name": "remote-10k-n128-block-ab-r2",
      "tags": [
        "task145",
        "remote",
        "release",
        "10k",
        "n128",
        "block-pruning-ab"
      ],
      "artifact_dir": "reviews/task-145/007-remote-block-pruning-ab/artifacts/remote-10k-n128-block-r2",
      "run_dir": "target/t145b2-10n128",
      "run_id": "t145b2-10n128",
      "tier": "representative",
      "prefix": "ec_real_10k",
      "prepared_prefix": "ec_real_10k",
      "prepared_dir": "data/staged-current",
      "storage_format": "rabitq",
      "coord_index": "t145_b2_10_n128_coord_idx",
      "remote_index": "t145_b2_10_n128_remote_idx",
      "reloptions": [
        "nlists=128",
        "recursive_fanout=8",
        "top_graph_enabled=1",
        "top_graph_degree=32",
        "top_graph_build_list_size=100",
        "top_graph_search_list_size=96",
        "boundary_replica_count=0",
        "training_sample_rows=10000",
        "source_identity=include"
      ],
      "load_session_gucs": [
        "ec_spire.leaf_block_rows=16",
        "ec_spire.leaf_block_summary_representatives=2"
      ],
      "bench_top_k": 10,
      "bench_queries_limit": 200,
      "bench_sweep": "8,16,32,64,96",
      "skip_bench_rowcap": true,
      "bench_query_metric_projection_columns": [
        "id",
        "source"
      ],
      "bench_session_gucs": [
