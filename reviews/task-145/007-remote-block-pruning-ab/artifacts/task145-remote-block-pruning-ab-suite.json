        "ec_spire.route_overfetch_multiplier=1.0",
        "ec_spire.probe_distance_ratio=0",
        "ec_spire.max_remote_payload_bytes_per_row=16384"
      ],
      "bench_production_read_variants": [
        "name=block-off;projection=id,source;guc=ec_spire.rerank_width=50;guc=ec_spire.max_candidate_rows=100;guc=ec_spire.leaf_block_pruning_max_blocks_per_leaf=0;guc=ec_spire.leaf_block_pruning_max_global_blocks=0",
