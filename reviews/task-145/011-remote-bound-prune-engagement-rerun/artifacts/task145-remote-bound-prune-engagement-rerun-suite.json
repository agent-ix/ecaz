{
  "name": "task145-remote-bound-prune-engagement-rerun",
  "schema_version": 1,
  "artifact_dir": "reviews/task-145/011-remote-bound-prune-engagement-rerun/artifacts/top-suite",
  "defaults": {
    "pg": 18
  },
  "thresholds": [],
  "_doc": {
    "intent": "Task 145 bound-prune A/B rerun after adding a dedicated pre_materialization_pruned_sum engagement counter. Packet 008 is rejected as faulty/null evidence because it lacked mechanism engagement proof.",
    "scales": [
      "10k n128/b0",
      "50k n1024/b0",
      "100k n1024/b0"
    ],
    "nprobe_sweep": [
      8,
      16,
      32,
      64,
      96
    ],
    "queries_limit": 200,
    "held_constant": [
      "storage_format=rabitq",
      "boundary_replica_count=0",
      "source_identity=include",
      "leaf_score_only_routing=on",
      "route_overfetch_multiplier=1.0",
      "probe_distance_ratio=0",
      "rerank_width=50",
      "max_candidate_rows=100",
      "leaf_block_pruning off",
      "max_remote_payload_bytes_per_row=16384"
    ],
    "single_axis": "bench production-read variants differ only by ec_spire.pre_materialization_prune=off/on",
    "validity_gate": "pre_materialization_pruned_sum must be 0 for off and nonzero for on before any latency/recall conclusion is valid"
  },
  "steps": [
    {
      "kind": "spire-local-multinode",
      "name": "remote-10k-n128-bound-prune-engagement-r2",
