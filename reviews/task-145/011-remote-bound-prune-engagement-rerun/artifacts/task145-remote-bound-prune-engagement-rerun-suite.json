      "run_id": "t145bpeng2-10n128",
      "tier": "representative",
      "prefix": "ec_real_10k",
      "prepared_prefix": "ec_real_10k",
      "prepared_dir": "data/staged-current",
      "storage_format": "rabitq",
      "coord_index": "t145_bpeng2_10_n128_coord_idx",
      "remote_index": "t145_bpeng2_10_n128_remote_idx",
      "reloptions": [
        "nlists=128",
        "recursive_fanout=8",
        "top_graph_enabled=1",
        "top_graph_degree=32",
        "top_graph_build_list_size=100",
        "top_graph_search_list_size=96",
        "boundary_replica_count=0",
        "training_sample_rows=10000",
        "source_identity=include"
