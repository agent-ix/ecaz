{
  "name": "task74-intel-profiler-baseline",
  "schema_version": 1,
  "artifact_dir": "reviews/task-74/005-intel-profiler-baseline/artifacts",
  "defaults": {
    "pg": 18,
    "socket_dir": "/home/peter/.pgrx",
    "bits": 4,
    "seed": 42,
    "queries_limit": 200,
    "iterations": 200,
    "force_index": true,
    "sample_backend_memory": true,
    "memory_sample_interval_ms": 25
  },
  "steps": [
    {
      "kind": "raw",
      "name": "precheck-host-and-inputs",
      "tags": ["setup", "precheck", "intel-local", "task74"],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "postgres",
        "--socket-dir",
        "/home/peter/.pgrx",
        "--raw",
        "--sql",
        "CREATE EXTENSION IF NOT EXISTS ecaz; SELECT now() AS captured_at, version() AS postgres_version, current_setting('shared_buffers') AS shared_buffers, current_setting('work_mem') AS work_mem, current_setting('maintenance_work_mem') AS maintenance_work_mem, current_setting('effective_cache_size') AS effective_cache_size; SELECT extname, extversion FROM pg_extension WHERE extname = 'ecaz'; SELECT amname FROM pg_am WHERE amname IN ('ec_spire', 'ec_ivf') ORDER BY amname; SELECT pg_stat_file('/home/peter/dev/ecaz/target/real-corpus/staged-task50/ec_real_100k_corpus.tsv') AS corpus_file, pg_stat_file('/home/peter/dev/ecaz/target/real-corpus/staged-task50/ec_real_100k_queries.tsv') AS queries_file, pg_stat_file('/home/peter/dev/ecaz/target/real-corpus/staged-task50/ec_real_100k_manifest.json') AS manifest_file;",
        "--log-output",
        "reviews/task-74/005-intel-profiler-baseline/artifacts/precheck-host-and-inputs.log"
      ],
      "expected_artifacts": ["reviews/task-74/005-intel-profiler-baseline/artifacts/precheck-host-and-inputs.log"]
    },
    {
      "kind": "raw",
      "name": "drop-prior-intel-profiler-fixtures",
      "tags": ["setup", "drop", "intel-local", "task74"],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "postgres",
        "--socket-dir",
        "/home/peter/.pgrx",
        "--raw",
        "--sql",
        "DROP TABLE IF EXISTS task74_intel_spire_highrecall_tg128_b0_queries CASCADE; DROP TABLE IF EXISTS task74_intel_spire_highrecall_tg128_b0_corpus CASCADE; DROP TABLE IF EXISTS task74_intel_ivf_control_queries CASCADE; DROP TABLE IF EXISTS task74_intel_ivf_control_corpus CASCADE;",
        "--log-output",
        "reviews/task-74/005-intel-profiler-baseline/artifacts/drop-prior-intel-profiler-fixtures.log"
      ],
      "expected_artifacts": ["reviews/task-74/005-intel-profiler-baseline/artifacts/drop-prior-intel-profiler-fixtures.log"]
    },
    {
      "kind": "load",
      "name": "load-100k-spire-highrecall-tg128-b0",
      "tags": ["load", "intel-local", "ec_real_100k", "spire", "high-recall", "tg128", "b0", "task74"],
      "prefix": "task74_intel_spire_highrecall_tg128_b0",
      "profile": "ec_spire",
      "corpus_file": "target/real-corpus/staged-task50/ec_real_100k_corpus.tsv",
      "queries_file": "target/real-corpus/staged-task50/ec_real_100k_queries.tsv",
      "manifest_file": "target/real-corpus/staged-task50/ec_real_100k_manifest.json",
      "allow_manifest_mismatch": true,
      "log_file": "reviews/task-74/005-intel-profiler-baseline/artifacts/load-100k-spire-highrecall-tg128-b0.log",
      "reloptions": [
        "nlists=128",
        "recursive_fanout=8",
        "nprobe=24",
        "rerank_width=25",
        "storage_format=turboquant",
        "boundary_replica_count=0",
        "top_graph_enabled=1",
        "top_graph_degree=32",
        "top_graph_build_list_size=100",
        "top_graph_search_list_size=128"
      ]
    },
    {
      "kind": "latency",
      "name": "latency-100k-spire-highrecall-tg128-b0",
      "tags": ["latency", "intel-local", "ec_real_100k", "spire", "high-recall", "tg128", "b0", "task74"],
      "prefix": "task74_intel_spire_highrecall_tg128_b0",
      "profile": "ec_spire",
      "k": 10,
      "sweep": [96],
      "rerank_width": 25,
      "iterations": 200,
      "concurrency": 1,
      "force_index": true,
      "cache_state": "post_load_warm"
    },
    {
      "kind": "load",
      "name": "load-100k-ivf-control",
      "tags": ["load", "intel-local", "ec_real_100k", "ivf", "control", "task74"],
      "prefix": "task74_intel_ivf_control",
      "profile": "ec_ivf",
      "corpus_file": "target/real-corpus/staged-task50/ec_real_100k_corpus.tsv",
      "queries_file": "target/real-corpus/staged-task50/ec_real_100k_queries.tsv",
      "manifest_file": "target/real-corpus/staged-task50/ec_real_100k_manifest.json",
      "allow_manifest_mismatch": true,
      "log_file": "reviews/task-74/005-intel-profiler-baseline/artifacts/load-100k-ivf-control.log",
      "storage_format": "pq_fastscan",
      "reloptions": ["nlists=128", "nprobe=96", "rerank=heap_f32", "rerank_width=500", "pq_group_size=8"]
    },
    {
      "kind": "latency",
      "name": "latency-100k-ivf-control",
      "tags": ["latency", "intel-local", "ec_real_100k", "ivf", "control", "task74"],
      "prefix": "task74_intel_ivf_control",
      "profile": "ec_ivf",
      "k": 10,
      "sweep": [96],
      "rerank_width": 500,
      "iterations": 200,
      "concurrency": 1,
      "force_index": true,
      "cache_state": "post_load_warm"
    }
  ]
}
