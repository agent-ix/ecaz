      "tags": ["load", "diskann", "synth10k", "workers8", "batch64", "pq_fastscan", "r32", "l240"],
      "pgoptions": "-c max_parallel_maintenance_workers=8 -c max_parallel_workers=8",
      "capture_parallel_workers": true,
      "table_reloptions": ["parallel_workers=8"],
      "prefix": "t65b_syn_stream_w8_b64_l240",
      "storage_format": "pq_fastscan",
      "corpus_file": "data/task65b_synth10k_stream_closeout/synth10k_corpus.tsv",
