{
  "name": "task65b-diskann-synth10k-b64-l240-closeout",
  "schema_version": 1,
  "artifact_dir": "reviews/task-65b/020-strict-closeout-tuning/artifacts",
  "defaults": {
    "pg": 18,
    "socket_dir": "/Users/peter/.pgrx",
    "profile": "ec_diskann",
    "bits": 4,
    "seed": 42,
    "queries_limit": 200,
    "iterations": 200,
    "force_index": true,
