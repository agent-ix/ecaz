      "reloptions": [
        "graph_degree=32",
        "build_list_size=240",
        "alpha=1.2",
        "parallel_build_batch_size=64"
      ]
    },
    {
      "kind": "recall",
      "name": "recall-synth10k-w8-b64-r32-l240",
      "tags": ["recall", "diskann", "synth10k", "workers8", "batch64", "r32", "l240"],
      "prefix": "t65b_syn_stream_w8_b64_l240",
      "profile": "ec_diskann",
      "k": 10,
      "sweep": [64, 200, 800],
      "truth_cache_file": "${artifact_dir}/truth-synth10k-stream-k10.json"
    },
    {
      "kind": "storage",
      "name": "storage-synth10k-w8-b64-r32-l240",
      "tags": ["storage", "diskann", "synth10k", "workers8", "batch64", "r32", "l240"],
      "prefix": "t65b_syn_stream_w8_b64_l240"
    }
  ]
}
