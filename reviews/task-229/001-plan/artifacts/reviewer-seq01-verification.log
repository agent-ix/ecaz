    let suffix = hex::encode(build_id.as_bytes());
    let oid = u32::from(index_oid);
    (
        format!("_ecdz_replica_{oid}_{suffix}"),
        format!("_ecdz_replica_dir_{oid}_{suffix}"),
    )

