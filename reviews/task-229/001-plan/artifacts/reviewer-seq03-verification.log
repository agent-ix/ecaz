$ grep -n "materialize_pending_physical_window\|enum CustomScanOutputRow\|Frozen\|RemotePending\|RemoteSkipped" src/am/ec_distann/custom_scan.rs
  :616  enum CustomScanOutputRow {
  :621      Frozen(crate::storage::page::ItemPointer),          <- no vec_id
