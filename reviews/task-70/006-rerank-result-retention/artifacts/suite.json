      "prefix": "task70_006_diskann",
      "profile": "ec_diskann",
      "k": 10,
      "sweep": [64, 200],
      "session_gucs": ["ec_diskann.scan_profile_notice=on"],
      "log_output": "reviews/task-70/006-rerank-result-retention/artifacts/latency-diskann-real10k-l64-l200-profiled.log"
