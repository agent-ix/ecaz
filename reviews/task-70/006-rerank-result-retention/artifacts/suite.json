{
  "name": "task70-diskann-rerank-result-retention-real10k",
  "schema_version": 1,
  "artifact_dir": "reviews/task-70/006-rerank-result-retention/artifacts",
  "defaults": {
    "bits": 4,
    "seed": 42,
    "queries_limit": 200,
    "iterations": 500,
