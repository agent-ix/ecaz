        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "tqvector_bench",
        "--raw",
        "--file",
        "reviews/task-70/006-rerank-result-retention/artifacts/profile-notices-diskann-real10k-l64.sql",
        "--log-output",
        "reviews/task-70/006-rerank-result-retention/artifacts/profile-notices-diskann-real10k-l64.log"
      ],
      "expected_artifacts": [
        "reviews/task-70/006-rerank-result-retention/artifacts/profile-notices-diskann-real10k-l64.log"
      ]
    },
    {
      "kind": "raw",
      "name": "profile-notices-diskann-real10k-l200",
