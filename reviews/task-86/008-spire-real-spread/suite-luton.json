{
  "name": "task86-spire-turboquant-luton-real-spread",
  "schema_version": 1,
  "artifact_dir": "reviews/task-86/008-spire-real-spread/artifacts/luton",
  "defaults": {
    "profile": "ec_spire",
    "bits": 4,
    "seed": 42,
    "queries_limit": 200,
    "iterations": 1000,
    "force_index": true,
    "sample_backend_memory": true,
    "memory_sample_interval_ms": 25,
    "pg": 18,
    "socket_dir": "/Users/peter/.pgrx"
  },
  "steps": [
    {
      "kind": "raw",
      "name": "precheck-pg18-extension",
      "tags": ["setup", "precheck", "spire", "turboquant", "luton"],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "task86_spire_luton",
        "--socket-dir",
        "/Users/peter/.pgrx",
        "--raw",
        "--sql",
        "CREATE EXTENSION IF NOT EXISTS ecaz; SELECT now() AS captured_at, version() AS postgres_version, current_setting('server_version_num') AS server_version_num; SELECT extname, extversion FROM pg_extension WHERE extname = 'ecaz'; SELECT amname FROM pg_am WHERE amname IN ('ec_spire', 'ec_ivf', 'ec_hnsw') ORDER BY amname;",
        "--log-output",
        "${artifact_dir}/precheck-pg18-extension.log"
      ],
      "expected_artifacts": ["${artifact_dir}/precheck-pg18-extension.log"]
    },
    {
      "kind": "load",
      "name": "load-real10k-spire-turboquant-n32",
      "tags": ["load", "real10k", "spire", "turboquant", "luton"],
      "prefix": "task86_luton_real10k",
      "profile": "ec_spire",
      "corpus_file": "data/task31_m5_dbpedia_staged/ec_hnsw_real_10k_corpus.tsv",
      "queries_file": "data/task31_m5_dbpedia_staged/ec_hnsw_real_10k_queries.tsv",
      "manifest_file": "data/task31_m5_dbpedia_staged/ec_hnsw_real_10k_manifest.json",
      "allow_manifest_mismatch": true,
      "reloptions": ["storage_format=turboquant", "nlists=32", "nprobe=24", "rerank_width=25"],
      "log_file": "${artifact_dir}/load-real10k-spire-turboquant-n32.log"
    },
    {
      "kind": "storage",
      "name": "storage-real10k-spire-turboquant-n32",
      "tags": ["storage", "real10k", "spire", "turboquant", "luton"],
      "prefix": "task86_luton_real10k",
      "log_file": "${artifact_dir}/storage-real10k-spire-turboquant-n32.log"
    },
    {
      "kind": "recall",
      "name": "recall-real10k-spire-turboquant-n32",
      "tags": ["recall", "real10k", "spire", "turboquant", "luton"],
      "prefix": "task86_luton_real10k",
      "k": 10,
      "sweep": [8, 24, 32],
      "rerank_width": 25,
      "truth_cache_file": "reviews/task-86/008-spire-real-spread/artifacts/truth-real10k-k10.json",
      "truth_corpus_file": "data/task31_m5_dbpedia_staged/ec_hnsw_real_10k_corpus.tsv",
      "log_output": "${artifact_dir}/recall-real10k-spire-turboquant-n32.log"
    },
    {
      "kind": "latency",
      "name": "latency-real10k-spire-turboquant-n32",
      "tags": ["latency", "real10k", "spire", "turboquant", "luton"],
      "prefix": "task86_luton_real10k",
      "k": 10,
      "sweep": [8, 24, 32],
      "rerank_width": 25,
      "iterations": 1000,
      "log_output": "${artifact_dir}/latency-real10k-spire-turboquant-n32.log"
    },
    {
      "kind": "spire-pipeline",
      "name": "pipeline-real10k-spire-turboquant-n32",
      "tags": ["pipeline", "real10k", "spire", "turboquant", "luton"],
      "prefix": "task86_luton_real10k",
      "index": "task86_luton_real10k_idx",
      "queries_limit": 200,
      "sweep": [8, 24, 32],
      "rerank_width": 25,
      "include_local_store_overlap": true,
      "include_query_metrics": true,
      "include_recall": true,
      "include_production_read_profile": true,
      "truth_corpus_file": "data/task31_m5_dbpedia_staged/ec_hnsw_real_10k_corpus.tsv",
      "query_metric_k": 10,
      "query_metric_projection_columns": ["id"],
      "log_output": "${artifact_dir}/pipeline-real10k-spire-turboquant-n32.log"
    },
    {
      "kind": "load",
      "name": "load-real50k-spire-turboquant-n64",
