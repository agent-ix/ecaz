      "queries_file": "/home/peter/dev/ecaz/data/staged-current/ec_real_50k_queries.tsv",
      "manifest_file": "/home/peter/dev/ecaz/data/staged-current/ec_real_50k_manifest.json",
      "allow_manifest_mismatch": true,
      "reloptions": ["neighbor_code_format=rabitq", "build_shards=4", "closure_epsilon=0.1"],
      "log_file": "${artifact_dir}/load-50k.log"
    },
    {
      "kind": "load",
      "name": "load-100k-current",
      "tags": ["task163", "d8", "ec_real_100k", "current", "load"],
      "prefix": "d8_current_100k",
      "profile": "ec_distann",
      "corpus_file": "/home/peter/dev/ecaz/data/staged-current/ec_real_100k_corpus.tsv",
      "queries_file": "/home/peter/dev/ecaz/data/staged-current/ec_real_100k_queries.tsv",
      "manifest_file": "/home/peter/dev/ecaz/data/staged-current/ec_real_100k_manifest.json",
      "allow_manifest_mismatch": true,
      "reloptions": ["neighbor_code_format=rabitq", "build_shards=4", "closure_epsilon=0.1"],
