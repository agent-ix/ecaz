{
  "commands": [
    "set -euo pipefail",
    "echo step=probe",
    "hostname",
    "uname -m",
    "command -v git || true",
    "command -v cargo || true",
    "command -v rustc || true",
    "command -v pg_config || true",
    "test -x /usr/pgsql-18/bin/pg_config && echo /usr/pgsql-18/bin/pg_config || true",
    "command -v psql || true",
    "test -x /usr/pgsql-18/bin/psql && echo /usr/pgsql-18/bin/psql || true",
    "command -v ecaz || true",
    "/usr/local/bin/ecaz --version || true",
    "ls -ld /var/tmp/ecaz-spire-aws /var/tmp/ecaz-spire-aws/ecaz-source /var/tmp/ecaz-spire-aws/ecaz-runtime-publish 2>/dev/null || true",
    "sudo -u postgres /usr/pgsql-18/bin/psql -h 127.0.0.1 -p 5432 -U ecaz_coord -d postgres -At -c \"SELECT extversion FROM pg_extension WHERE extname='ecaz';\" || true"
  ],
  "executionTimeout": ["600"]
}
