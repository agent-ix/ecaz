+const EC_SPIRE_AM_NAME: &core::ffi::CStr = c"ec_spire";
+
+pub(crate) fn ec_spire_access_method_oid() -> Option<pg_sys::Oid> {
+    // SAFETY: get_index_am_oid reads PostgreSQL syscache by static C string;
