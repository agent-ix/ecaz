      "artifact_dir": "${artifact_dir}/control",
      "run_dir": "/home/peter/.ecaz/clusters/task207-50k-union-control",
      "nodes": 3,
      "base_port": 41520,
      "graph_degree": 32,
      "build_shards": 1,
      "head_index_cap": 4096,
