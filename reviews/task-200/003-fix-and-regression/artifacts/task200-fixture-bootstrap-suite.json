{
  "name": "task200-fixture-bootstrap",
  "schema_version": 1,
  "artifact_dir": "reviews/task-200/003-fix-and-regression/artifacts/fixture-bootstrap-run",
  "defaults": { "pg": 18 },
  "thresholds": [],
  "steps": [
    {
      "kind": "distann-local-multinode",
      "name": "build-100k-fixture-once",
      "tags": ["task200", "fixture-bootstrap", "100k"],
      "artifact_dir": "${artifact_dir}",
      "run_dir": "/home/peter/.ecaz/clusters/task200-counters-off-100k",
      "nodes": 3,
      "base_port": 42080,
      "graph_degree": 32,
