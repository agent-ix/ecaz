{
  "name": "task106-aws-spire-pqfastscan-negative-smoke",
  "schema_version": 1,
  "artifact_dir": "reviews/task-106/004-aws-targeted-bench/artifacts/spire-pqfastscan-negative",
  "defaults": {
    "pg": 18,
    "socket_dir": "/var/run/postgresql",
    "bits": 4,
    "seed": 42,
    "queries_limit": 200,
    "iterations": 1,
    "force_index": true,
    "sample_backend_memory": false
  },
  "steps": [
    {
      "kind": "raw",
      "name": "precheck-host",
      "tags": [
        "task106",
        "aws-targeted",
        "precheck",
        "aws-negative-smoke"
      ],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "postgres",
        "--socket-dir",
        "/var/run/postgresql",
        "--raw",
        "--sql",
        "SELECT now() AS captured_at, version() AS postgres_version, current_setting('server_version') AS server_version, current_setting('shared_buffers') AS shared_buffers, current_setting('work_mem') AS work_mem, current_setting('maintenance_work_mem') AS maintenance_work_mem, current_setting('effective_cache_size') AS effective_cache_size; SELECT left(pg_read_file('/proc/cpuinfo', 0, 20000), 20000) AS cpuinfo_prefix; SELECT left(pg_read_file('/proc/meminfo', 0, 12000), 12000) AS meminfo_prefix;",
        "--log-output",
        "${artifact_dir}/precheck-host.log"
      ],
      "expected_artifacts": [
        "${artifact_dir}/precheck-host.log"
      ]
    },
    {
      "kind": "load",
      "name": "load-10k-aws-intel-spire-pqfastscan-gap",
      "tags": [
        "task106",
        "aws-targeted",
        "aws-intel",
        "real10k",
        "spire",
        "spire-pqfastscan-gap",
        "expected-failure"
      ],
      "prefix": "t106_aws_intel_10k_spire_pqfastscan_gap",
      "profile": "ec_spire",
      "bits": 4,
      "dim": 1536,
      "corpus_file": "/var/lib/pgsql/18/datasets/staged-task106-targeted/ec_real_10k_corpus.tsv",
      "queries_file": "/var/lib/pgsql/18/datasets/staged-task106-targeted/ec_real_10k_queries.tsv",
      "manifest_file": "/var/lib/pgsql/18/datasets/staged-task106-targeted/ec_real_10k_manifest.json",
      "allow_manifest_mismatch": true,
      "reloptions": [
        "nlists=32",
        "nprobe=24",
        "rerank_width=25",
        "local_store_count=1",
        "training_sample_rows=10000"
      ],
      "log_file": "${artifact_dir}/load-10k-aws-intel-spire-pqfastscan-gap.log",
      "storage_format": "pq_fastscan"
    },
    {
      "kind": "load",
      "name": "load-10k-aws-graviton-spire-pqfastscan-gap",
      "tags": [
        "task106",
        "aws-targeted",
        "aws-graviton",
        "real10k",
        "spire",
        "spire-pqfastscan-gap",
        "expected-failure"
      ],
      "prefix": "t106_aws_graviton_10k_spire_pqfastscan_gap",
      "profile": "ec_spire",
      "bits": 4,
      "dim": 1536,
      "corpus_file": "/var/lib/pgsql/18/datasets/staged-task106-targeted/ec_real_10k_corpus.tsv",
      "queries_file": "/var/lib/pgsql/18/datasets/staged-task106-targeted/ec_real_10k_queries.tsv",
      "manifest_file": "/var/lib/pgsql/18/datasets/staged-task106-targeted/ec_real_10k_manifest.json",
      "allow_manifest_mismatch": true,
      "reloptions": [
        "nlists=32",
        "nprobe=24",
        "rerank_width=25",
        "local_store_count=1",
        "training_sample_rows=10000"
      ],
      "log_file": "${artifact_dir}/load-10k-aws-graviton-spire-pqfastscan-gap.log",
      "storage_format": "pq_fastscan"
    }
  ]
}
