        "recall",
        "task148",
        "tqdefault",
        "real10k",
        "baseline"
      ],
      "prefix": "task148_calib_baseline_tqdefault_real10k",
      "profile": "ec_ivf",
      "k": 10,
      "bits": 4,
      "sweep": [
        8,
        16,
        24,
        32,
        48,
        64
      ],
      "queries_limit": 32,
      "truth_cache_dir": "reviews/task-148/008-codebook-calibration-ab/truth-cache",
      "log_output": "${artifact_dir}/recall-tqdefault-10k.log"
