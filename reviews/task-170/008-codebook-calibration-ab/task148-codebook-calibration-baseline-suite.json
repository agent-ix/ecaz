{
  "name": "task148-codebook-calibration-baseline-ab",
  "schema_version": 1,
  "artifact_dir": "reviews/task-148/008-codebook-calibration-ab/artifacts/baseline",
  "defaults": {
    "pg": 18,
    "socket_dir": "/Users/peter/.pgrx",
    "profile": "ec_ivf",
    "seed": 42,
    "queries_limit": 32,
    "iterations": 32,
    "force_index": true,
    "sample_backend_memory": true,
    "memory_sample_interval_ms": 25
  },
  "thresholds": [],
  "steps": [
    {
      "kind": "raw",
      "name": "precheck-build-sha",
      "tags": [
        "setup",
        "precheck",
        "task148",
        "baseline"
      ],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "tqvector_bench",
        "--socket-dir",
        "/Users/peter/.pgrx",
        "--raw",
        "--sql",
        "SELECT now() AS captured_at, ecaz_build_git_sha(), current_setting('ec_ivf.turboquant_scorer') AS scorer_default;",
        "--log-output",
        "${artifact_dir}/precheck-build-sha.log"
      ],
      "expected_artifacts": [
        "${artifact_dir}/precheck-build-sha.log"
      ]
    },
    {
      "kind": "load",
      "name": "load-tqdefault-10k",
      "tags": [
        "load",
        "task148",
        "tqdefault",
        "real10k",
        "baseline"
      ],
      "prefix": "task148_calib_baseline_tqdefault_real10k",
      "profile": "ec_ivf",
      "storage_format": "turboquant",
      "bits": 4,
      "corpus_file": "data/staged-current/ec_real_10k_corpus.tsv",
      "queries_file": "data/staged-current/ec_real_10k_queries.tsv",
      "manifest_file": "data/staged-current/ec_real_10k_manifest.json",
      "allow_manifest_mismatch": true,
      "log_file": "${artifact_dir}/load-tqdefault-10k.log"
