{
  "name": "task103-binary-warm-recheck",
  "schema_version": 1,
  "artifact_dir": "reviews/task-103/001-intel-baseline-matrix/artifacts",
  "defaults": {
    "pg": 18,
    "bits": 4,
    "seed": 42,
    "queries_limit": 100,
    "iterations": 120,
    "force_index": true,
    "sample_backend_memory": false
  },
  "steps": [
    {
      "kind": "latency",
      "name": "warm-latency-diskann-real50k-binary-kernel-off",
      "tags": [
        "task103",
        "local",
        "diskann",
        "binary",
        "real50k",
        "kernel_off",
        "quant=binary",
        "warm_order"
      ],
      "prefix": "task67_local_fullq_50k_diskann",
      "profile": "ec_diskann",
      "k": 10,
      "sweep": [
        64,
        128
      ],
      "iterations": 120,
      "concurrency": 1,
      "cache_state": "task103_diskann_binary_warm_off",
      "task87_candidate_batch_counters": true,
      "log_output": "${artifact_dir}/warm-latency-diskann-real50k-binary-kernel-off.log",
      "session_gucs": [
        "ec_diskann.candidate_batch_scoring=off"
      ]
    },
    {
      "kind": "latency",
      "name": "warm-latency-diskann-real50k-binary-kernel-on",
      "tags": [
        "task103",
        "local",
        "diskann",
        "binary",
        "real50k",
        "kernel_on",
        "quant=binary",
        "warm_order"
      ],
      "prefix": "task67_local_fullq_50k_diskann",
      "profile": "ec_diskann",
      "k": 10,
      "sweep": [
        64,
        128
      ],
      "iterations": 120,
      "concurrency": 1,
      "cache_state": "task103_diskann_binary_warm_on",
      "task87_candidate_batch_counters": true,
      "log_output": "${artifact_dir}/warm-latency-diskann-real50k-binary-kernel-on.log"
    }
  ]
}
