{
  "name": "task144-phase0-geometry-release",
  "schema_version": 1,
  "artifact_dir": "reviews/task-144/003-phase0-geometry-release/artifacts",
  "defaults": {
    "profile": "ec_spire",
    "bits": 4,
    "seed": 42,
    "queries_limit": 200,
    "iterations": 200,
    "force_index": true,
    "sample_backend_memory": true,
    "memory_sample_interval_ms": 25,
    "pg": 18,
    "socket_dir": "/home/peter/dev/ecaz/target/task144-pg18-socket"
  },
  "thresholds": [],
  "_doc": {
    "intent": "Task 144 Phase 0 release geometry diagnostic. Measures leaf-size variance and true-neighbor list concentration for single assignment plus read-only simulated closure epsilons on 50k/100k n1024/b0.",
    "baseline_reloptions": "nlists=1024, recursive_fanout=8, top_graph_enabled=1, top_graph_degree=32, top_graph_build_list_size=100, top_graph_search_list_size=96, boundary_replica_count=0, storage_format=rabitq",
    "closure_epsilons": [0.05, 0.1, 0.2],
    "queries_limit": 200,
    "prerequisite": "PG18 backend must be release-built. Local staged files: data/task111a_real50k/ec_real_50k_{corpus,queries}.tsv and data/task106_full_sweep_100k/ec_real_100k_{corpus,queries}.tsv."
  },
  "steps": [
    {
      "kind": "raw",
      "name": "precheck-host",
      "tags": ["setup", "precheck", "task144", "release"],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "tqvector_bench_task144",
        "--socket-dir",
        "/home/peter/dev/ecaz/target/task144-pg18-socket",
        "--raw",
        "--sql",
        "LOAD 'ecaz'; SELECT now() AS captured_at, version() AS postgres_version, ecaz_build_profile() AS ecaz_build_profile;",
        "--log-output",
        "${artifact_dir}/precheck-host.log"
      ],
      "expected_artifacts": ["${artifact_dir}/precheck-host.log"]
    },
    {
      "kind": "load",
      "name": "load-50k-n1024-index",
      "tags": ["load", "task144", "50k", "n1024", "baseline-index", "storage_format=rabitq"],
      "prefix": "t144_50k_n1024_phase0",
      "index_name": "t144_50k_n1024_phase0_idx",
      "dim": 1536,
      "corpus_file": "data/task111a_real50k/ec_real_50k_corpus.tsv",
      "queries_file": "data/task111a_real50k/ec_real_50k_queries.tsv",
      "manifest_file": "data/task111a_real50k/ec_real_50k_manifest.json",
      "allow_manifest_mismatch": true,
      "storage_format": "rabitq",
      "reloptions": [
        "nlists=1024",
        "recursive_fanout=8",
        "top_graph_enabled=1",
        "top_graph_degree=32",
        "top_graph_build_list_size=100",
        "top_graph_search_list_size=96",
        "boundary_replica_count=0",
        "training_sample_rows=50000"
      ],
      "log_file": "${artifact_dir}/load-50k-n1024-index.log"
    },
    {
      "kind": "recall",
      "name": "truth-cache-50k-q200-k10",
      "tags": ["recall", "truth-cache", "task144", "50k", "n1024"],
      "prefix": "t144_50k_n1024_phase0",
      "k": 10,
      "sweep": [96],
      "queries_limit": 200,
      "profile": "ec_spire",
      "force_index": true,
      "truth_corpus_file": "data/task111a_real50k/ec_real_50k_corpus.tsv",
      "truth_cache_file": "${artifact_dir}/truth-cache-50k-q200-k10.json",
      "log_output": "${artifact_dir}/truth-cache-50k-q200-k10.log"
    },
    {
      "kind": "spire-pipeline",
      "name": "geometry-50k-n1024",
      "tags": ["pipeline", "geometry", "task144", "50k", "n1024", "variant=single-plus-closure-sim"],
      "prefix": "t144_50k_n1024_phase0",
      "queries_limit": 200,
      "sweep": [96],
      "include_recall": true,
      "truth_corpus_file": "data/task111a_real50k/ec_real_50k_corpus.tsv",
      "truth_cache_file": "${artifact_dir}/truth-cache-50k-q200-k10.json",
      "geometry_output": "${artifact_dir}/geometry-50k-n1024.jsonl",
      "geometry_closure_epsilon": [0.05, 0.1, 0.2],
      "log_output": "${artifact_dir}/geometry-50k-n1024.log"
    },
    {
      "kind": "load",
      "name": "load-100k-n1024-index",
      "tags": ["load", "task144", "100k", "n1024", "baseline-index", "storage_format=rabitq"],
      "prefix": "t144_100k_n1024_phase0",
      "index_name": "t144_100k_n1024_phase0_idx",
      "dim": 1536,
      "corpus_file": "data/task106_full_sweep_100k/ec_real_100k_corpus.tsv",
      "queries_file": "data/task106_full_sweep_100k/ec_real_100k_queries.tsv",
      "manifest_file": "data/task106_full_sweep_100k/ec_real_100k_manifest.json",
      "allow_manifest_mismatch": true,
      "storage_format": "rabitq",
      "reloptions": [
        "nlists=1024",
        "recursive_fanout=8",
        "top_graph_enabled=1",
        "top_graph_degree=32",
        "top_graph_build_list_size=100",
        "top_graph_search_list_size=96",
        "boundary_replica_count=0",
        "training_sample_rows=100000"
      ],
      "log_file": "${artifact_dir}/load-100k-n1024-index.log"
    },
    {
      "kind": "recall",
      "name": "truth-cache-100k-q200-k10",
      "tags": ["recall", "truth-cache", "task144", "100k", "n1024"],
      "prefix": "t144_100k_n1024_phase0",
      "k": 10,
      "sweep": [96],
      "queries_limit": 200,
      "profile": "ec_spire",
      "force_index": true,
      "truth_corpus_file": "data/task106_full_sweep_100k/ec_real_100k_corpus.tsv",
      "truth_cache_file": "${artifact_dir}/truth-cache-100k-q200-k10.json",
      "log_output": "${artifact_dir}/truth-cache-100k-q200-k10.log"
    },
    {
      "kind": "spire-pipeline",
      "name": "geometry-100k-n1024",
      "tags": ["pipeline", "geometry", "task144", "100k", "n1024", "variant=single-plus-closure-sim"],
      "prefix": "t144_100k_n1024_phase0",
      "queries_limit": 200,
      "sweep": [96],
      "include_recall": true,
      "truth_corpus_file": "data/task106_full_sweep_100k/ec_real_100k_corpus.tsv",
      "truth_cache_file": "${artifact_dir}/truth-cache-100k-q200-k10.json",
      "geometry_output": "${artifact_dir}/geometry-100k-n1024.jsonl",
      "geometry_closure_epsilon": [0.05, 0.1, 0.2],
      "log_output": "${artifact_dir}/geometry-100k-n1024.log"
    }
  ]
}
