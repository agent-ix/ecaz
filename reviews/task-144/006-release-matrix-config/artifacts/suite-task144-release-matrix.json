{
  "name": "task144-release-matrix",
  "schema_version": 1,
  "artifact_dir": "reviews/task-144/006-release-matrix-config/artifacts",
  "defaults": {
    "profile": "ec_spire",
    "bits": 4,
    "seed": 42,
    "queries_limit": 200,
    "iterations": 200,
    "force_index": true,
    "sample_backend_memory": true,
    "memory_sample_interval_ms": 25,
    "pg": 18,
    "socket_dir": "/home/peter/dev/ecaz/target/task144-pg18-socket"
  },
  "thresholds": [],
  "_doc": {
    "intent": "Task 144 release A/B matrix plan. Pre-registers assignment variants and query modes for the real closeout run after packets 004/005 landed default-off controls.",
    "assignment_variants": {
      "single": "boundary_replica_count=0, closure_epsilon=0",
      "fixed_b2": "boundary_replica_count=2, closure_epsilon=0",
      "closure_e010_b8": "boundary_replica_count=8, closure_epsilon=0.10"
    },
    "query_modes": {
      "fixed": "ordinary nprobe sweep",
      "ratio125": "ordinary sweep as a ceiling plus ec_spire.probe_distance_ratio=1.25",
      "adaptive": "existing ec_spire adaptive_nprobe score-gap policy"
    },
    "sweep": [8, 16, 32, 64, 96],
    "evidence": "Each shape has storage plus spire-pipeline include_recall, include_query_metrics, include_production_read_profile, stage_containment_output, and result_identity_output. Stage containment carries per-query route/probed counts and recall-tail missing ranks."
  },
