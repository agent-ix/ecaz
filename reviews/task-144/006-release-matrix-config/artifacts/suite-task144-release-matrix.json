      "kind": "raw",
      "name": "precheck-release-profile",
      "tags": ["setup", "precheck", "task144", "release"],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "tqvector_bench_task144",
        "--socket-dir",
        "/home/peter/dev/ecaz/target/task144-pg18-socket",
        "--raw",
        "--sql",
        "LOAD 'ecaz'; SELECT now() AS captured_at, version() AS postgres_version, ecaz_build_profile() AS ecaz_build_profile;",
        "--log-output",
        "${artifact_dir}/precheck-release-profile.log"
      ],
      "expected_artifacts": ["${artifact_dir}/precheck-release-profile.log"]
    },

