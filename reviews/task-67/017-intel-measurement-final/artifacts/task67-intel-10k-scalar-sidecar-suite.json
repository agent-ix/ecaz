{
  "name": "task67-intel-10k-scalar-sidecar",
  "schema_version": 1,
  "artifact_dir": "reviews/task-67/017-intel-measurement-final/artifacts/scalar-sidecar",
  "defaults": {
    "pg": 18,
    "socket_dir": "/var/run/postgresql",
    "profile": "ec_ivf",
    "bits": 4,
    "seed": 42,
    "queries_limit": 200,
    "iterations": 200,
    "force_index": true
  },
  "steps": [
    {
      "kind": "load",
      "name": "load-10k-rabitq1-scalar-sidecar",
      "tags": ["aws", "load", "scalar", "sidecar", "ec_real_10k", "ivf", "rabitq", "bits1"],
      "prefix": "task67_intel_10k_rabitq1_scalar_sidecar",
      "profile": "ec_ivf",
      "bits": 4,
      "storage_format": "rabitq",
      "corpus_file": "target/real-corpus/staged-task50/ec_real_10k_corpus.tsv",
      "queries_file": "target/real-corpus/staged-task50/ec_real_10k_queries.tsv",
      "manifest_file": "target/real-corpus/staged-task50/ec_real_10k_manifest.json",
      "allow_manifest_mismatch": true,
      "reloptions": [
        "nlists=64",
        "nprobe=64",
        "training_sample_rows=5000",
        "quant_bits=1",
        "rerank=off"
      ],
      "log_file": "reviews/task-67/017-intel-measurement-final/artifacts/scalar-sidecar/load-10k-rabitq1-scalar-sidecar.log"
    },
    {
      "kind": "sidecar-rerank",
      "name": "sidecar-10k-rabitq8-variants-scalar",
      "tags": ["aws", "sidecar", "scalar", "ec_real_10k", "ivf", "rabitq8", "variants"],
      "prefix": "task67_intel_10k_rabitq1_scalar_sidecar",
      "profile": "ec_ivf",
      "k": 10,
      "candidate_k": 100,
      "concurrency": 1,
      "sweep": [64],
      "queries_limit": 200,
      "warmup_queries": 50,
      "variants": ["rabitq8", "rabitq8ls", "rabitq8c3", "rabitq8c4"],
      "read_modes": ["tid-sorted"],
      "rebuild_sidecar_table": true,
      "force_index": true,
      "log_output": "reviews/task-67/017-intel-measurement-final/artifacts/scalar-sidecar/sidecar-10k-rabitq8-variants-scalar.log"
    }
  ]
}
