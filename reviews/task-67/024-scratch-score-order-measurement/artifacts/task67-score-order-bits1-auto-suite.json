      "profile": "ec_ivf",
      "bits": 4,
      "k": 10,
      "sweep": [16, 32, 64],
      "rerank_width": 100,
      "force_index": true,
      "ivf_scratch_soa_batch_decode": true,
      "iterations": 200,
