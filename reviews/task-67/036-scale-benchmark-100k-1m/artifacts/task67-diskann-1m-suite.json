      "prefix": "task67_1m_diskann_default",
      "profile": "ec_diskann",
      "k": 10,
      "sweep": [64, 128, 200, 400, 800],
      "iterations": 50,
      "concurrency": 1,
      "force_index": true,
      "sample_backend_memory": true,
      "memory_sample_interval_ms": 25,
