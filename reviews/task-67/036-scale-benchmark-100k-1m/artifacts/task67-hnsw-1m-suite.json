{
  "name": "task67-hnsw-1m",
  "schema_version": 1,
  "artifact_dir": "reviews/task-67/036-scale-benchmark-100k-1m/artifacts/1m-hnsw",
  "defaults": {
    "pg": 18,
    "socket_dir": "/var/run/postgresql",
    "profile": "ec_hnsw",
    "bits": 4,
    "seed": 42,
    "queries_limit": 100,
    "iterations": 50,
    "force_index": true,
    "sample_backend_memory": true,
    "memory_sample_interval_ms": 25
  },
  "steps": [
    {
      "kind": "corpus-fetch",
      "name": "fetch-dbpedia-openai3-1m",
      "tags": ["aws", "fetch", "hnsw", "real1m"],
      "dataset": "qdrant-dbpedia-openai3-large-1536-1m",
      "output_dir": "/var/lib/pgsql/18/datasets/task67-dbpedia-openai3-1m"
    },
    {
      "kind": "corpus-prepare",
      "name": "prepare-ann-benchmarks-anchor",
      "tags": ["aws", "prepare", "hnsw", "real1m"],
      "profile": "ec_real_ann_benchmarks_anchor",
      "parquet": "/var/lib/pgsql/18/datasets/task67-dbpedia-openai3-1m/data",
      "output_dir": "/var/lib/pgsql/18/datasets/staged-task67-1m",
      "chunk_rows": 25000
    },
    {
      "kind": "load",
      "name": "load-hnsw-real1m-m16",
      "tags": ["aws", "load", "hnsw", "real1m", "m16"],
      "prefix": "task67_1m_hnsw_m16",
      "profile": "ec_hnsw",
      "manifest_file": "/var/lib/pgsql/18/datasets/staged-task67-1m/ec_real_ann_benchmarks_anchor_manifest.json",
      "chunked": true,
      "m": [16],
      "ef_construction": 128,
      "log_file": "reviews/task-67/036-scale-benchmark-100k-1m/artifacts/1m-hnsw/load-hnsw-real1m-m16.log"
    },
    {
      "kind": "recall",
      "name": "recall-hnsw-real1m-ef-sweep",
      "tags": ["aws", "recall", "hnsw", "real1m", "m16"],
      "prefix": "task67_1m_hnsw_m16",
      "profile": "ec_hnsw",
      "k": 10,
      "sweep": [64, 128, 200, 400],
      "queries_limit": 100,
      "truth_cache_file": "reviews/task-67/036-scale-benchmark-100k-1m/artifacts/1m-hnsw/truth-hnsw-real1m-k10.json",
      "log_output": "reviews/task-67/036-scale-benchmark-100k-1m/artifacts/1m-hnsw/recall-hnsw-real1m-ef-sweep.log"
    },
    {
      "kind": "latency",
      "name": "latency-hnsw-real1m-ef-sweep",
      "tags": ["aws", "latency", "hnsw", "real1m", "m16"],
      "prefix": "task67_1m_hnsw_m16",
      "profile": "ec_hnsw",
      "k": 10,
      "sweep": [64, 128, 200, 400],
      "iterations": 50,
      "concurrency": 1,
      "force_index": true,
      "sample_backend_memory": true,
      "memory_sample_interval_ms": 25,
      "log_output": "reviews/task-67/036-scale-benchmark-100k-1m/artifacts/1m-hnsw/latency-hnsw-real1m-ef-sweep.log"
    },
    {
      "kind": "storage",
      "name": "storage-hnsw-real1m-m16",
      "tags": ["aws", "storage", "hnsw", "real1m", "m16"],
      "prefix": "task67_1m_hnsw_m16",
      "log_file": "reviews/task-67/036-scale-benchmark-100k-1m/artifacts/1m-hnsw/storage-hnsw-real1m-m16.log"
    }
  ]
}
