{
  "name": "task67-rabitq8-100k-auto-envfix",
  "schema_version": 1,
  "artifact_dir": "reviews/task-67/038-corrected-100k-simd-benchmark/artifacts/100k-auto",
  "defaults": {
    "pg": 18,
    "socket_dir": "/var/run/postgresql",
    "profile": "ec_ivf",
    "bits": 4,
    "seed": 42,
    "queries_limit": 100,
    "iterations": 100,
    "force_index": true
  },
  "steps": [
    {
      "kind": "corpus-fetch",
      "name": "fetch-dbpedia-openai3-1m",
      "tags": ["aws", "fetch", "dbpedia", "real100k"],
      "dataset": "qdrant-dbpedia-openai3-large-1536-1m",
      "output_dir": "/var/lib/pgsql/18/datasets/task67-dbpedia-openai3-1m"
    },
    {
      "kind": "corpus-prepare",
      "name": "prepare-ec-real-100k",
      "tags": ["aws", "prepare", "ec_real_100k"],
      "profile": "ec_real_100k",
      "parquet": "/var/lib/pgsql/18/datasets/task67-dbpedia-openai3-1m/data",
      "output_dir": "/var/lib/pgsql/18/datasets/staged-task67-scale"
    },
    {
      "kind": "load",
      "name": "load-100k-rabitq8-headline-auto-envfix",
      "tags": ["aws", "load", "auto", "ec_real_100k", "ivf", "rabitq8", "headline"],
      "prefix": "task67_r8head_100k_auto_envfix",
      "profile": "ec_ivf",
      "corpus_file": "/var/lib/pgsql/18/datasets/staged-task67-scale/ec_real_100k_corpus.tsv",
      "queries_file": "/var/lib/pgsql/18/datasets/staged-task67-scale/ec_real_100k_queries.tsv",
      "manifest_file": "/var/lib/pgsql/18/datasets/staged-task67-scale/ec_real_100k_manifest.json",
      "allow_manifest_mismatch": true,
      "reloptions": [
        "storage_format=rabitq",
        "nlists=128",
        "nprobe=96",
        "training_sample_rows=5000",
        "quant_bits=1",
        "rerank=off"
      ],
      "log_file": "reviews/task-67/038-corrected-100k-simd-benchmark/artifacts/100k-auto/load-100k-rabitq8-headline-auto-envfix.log"
    },
    {
      "kind": "sidecar-rerank",
      "name": "sidecar-100k-rabitq8-headline-auto-envfix",
      "tags": ["aws", "sidecar", "auto", "ec_real_100k", "ivf", "rabitq8", "headline"],
      "prefix": "task67_r8head_100k_auto_envfix",
      "profile": "ec_ivf",
      "k": 10,
      "candidate_k": 100,
      "concurrency": 1,
      "sweep": [64, 96, 128],
      "queries_limit": 100,
      "bits": 4,
      "warmup_queries": 25,
      "variants": ["rabitq8", "rabitq8ls", "rabitq8c3", "rabitq8c4"],
      "read_modes": ["tid-sorted"],
      "rebuild_sidecar_table": true,
      "force_index": true,
      "log_output": "reviews/task-67/038-corrected-100k-simd-benchmark/artifacts/100k-auto/sidecar-100k-rabitq8-headline-auto-envfix.log"
    }
  ]
}
