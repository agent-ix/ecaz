[suite:task85-aws-1m-rerank-locality-q500] apply-rerank-locality-snapshot-signature -> --database postgres --host /var/run/postgresql --user postgres dev sql --pg 18 --db postgres --socket-dir /var/run/postgresql --raw --sql "BEGIN; DROP FUNCTION IF EXISTS ec_spire_index_scan_rerank_locality_snapshot(oid, real[]); CREATE FUNCTION ec_spire_index_scan_rerank_locality_snapshot(index_oid oid, query real[]) RETURNS TABLE (active_epoch bigint, effective_nprobe bigint, effective_nprobe_source text, effective_rerank_width bigint, effective_rerank_width_source text, candidate_count bigint, rerank_prefix_count bigint, unique_heap_block_count bigint, heap_block_transition_count bigint, heap_block_span bigint, heap_block_jump_sum bigint, heap_block_jump_max bigint) STRICT STABLE LANGUAGE c AS '$libdir/ecaz', 'ec_spire_index_scan_rerank_locality_snapshot_wrapper'; ALTER EXTENSION ecaz ADD FUNCTION ec_spire_index_scan_rerank_locality_snapshot(oid, real[]); COMMIT;" --log-output reviews/task-85/025-aws-rerank-locality-measurement/artifacts/aws-1m-rerank-locality-q500/apply-rerank-locality-snapshot-signature.log
