{
  "name": "task71-ivf-parallel-build-worker-curve",
  "schema_version": 1,
  "artifact_dir": "reviews/task-71/003-worker-curve/artifacts",
  "defaults": {
    "profile": "ec_ivf",
    "bits": 4,
    "seed": 42,
    "queries_limit": 100,
    "iterations": 100,
    "force_index": true,
    "sample_backend_memory": true,
    "memory_sample_interval_ms": 25,
    "pg": 18,
    "socket_dir": "/Users/peter/.pgrx"
  },
  "steps": [
    {
      "kind": "raw",
      "name": "parallel-workers-before",
      "tags": ["worker-counter", "before"],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "tqvector_bench",
        "--socket-dir",
        "/Users/peter/.pgrx",
        "--sql",
        "SELECT datname, pg_stat_get_db_parallel_workers_launched(oid) AS parallel_workers_launched FROM pg_database WHERE datname = current_database();",
        "--log-output",
        "${artifact_dir}/parallel-workers-before.log"
      ],
      "expected_artifacts": ["${artifact_dir}/parallel-workers-before.log"]
    },

    {
      "kind": "load",
      "name": "load-real10k-w1",
      "tags": ["load", "real10k", "workers1"],
      "pgoptions": "-c max_parallel_maintenance_workers=1 -c max_parallel_workers=1",
      "capture_parallel_workers": true,
      "table_reloptions": ["parallel_workers=1"],
      "prefix": "task71_real10k_w1",
      "corpus_file": "data/task31_m5_dbpedia_staged/ec_hnsw_real_10k_corpus.tsv",
      "queries_file": "data/task31_m5_dbpedia_staged/ec_hnsw_real_10k_queries.tsv",
      "manifest_file": "data/task31_m5_dbpedia_staged/ec_hnsw_real_10k_manifest.json",
      "allow_manifest_mismatch": true,
      "reloptions": [
        "storage_format=pq_fastscan",
        "pq_group_size=8",
        "nlists=64",
        "nprobe=48",
        "rerank=heap_f32",
        "rerank_width=750"
      ],
      "log_file": "${artifact_dir}/load-real10k-w1.log"
    },
    {
      "kind": "recall",
      "name": "recall-real10k-w1",
      "tags": ["recall", "real10k", "workers1"],
      "prefix": "task71_real10k_w1",
      "k": 10,
      "sweep": [48],
      "rerank_width": 750,
      "truth_cache_file": "${artifact_dir}/truth-real10k-k10.json",
      "log_output": "${artifact_dir}/recall-real10k-w1.log"
    },
    {
      "kind": "storage",
      "name": "storage-real10k-w1",
      "tags": ["storage", "real10k", "workers1"],
      "prefix": "task71_real10k_w1",
      "log_file": "${artifact_dir}/storage-real10k-w1.log"
    },

