#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" != "ssm" || "${2:-}" != "start-session" ]]; then
  printf 'fake aws only supports: aws ssm start-session\n' >&2
  exit 2
fi

params=""
while (($# > 0)); do
  case "$1" in
    --parameters)
      shift
      params="${1:-}"
      ;;
  esac
  shift || true
done

port="$(sed -n 's/.*"localPortNumber":\["\([0-9][0-9]*\)"\].*/\1/p' <<< "$params")"
if [[ -z "$port" ]]; then
  printf 'fake aws could not parse localPortNumber from: %s\n' "$params" >&2
  exit 2
fi

printf 'Starting session with SessionId: fake-session-%s\n' "$port"
sleep 1
printf 'Port %s opened for sessionId fake-session-%s.\n' "$port" "$port"
printf 'Waiting for connections...\n'
sleep 60
