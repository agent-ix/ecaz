{
  "name": "phase13e-spire-production-read-profile-smoke",
  "schema_version": 1,
  "artifact_dir": "reviews/task-30/970-spire-phase13e-production-read-profile-suite/artifacts",
  "defaults": {
    "queries_limit": 5
  },
  "steps": [
    {
      "kind": "spire-pipeline",
      "name": "production-read-profile",
      "tags": ["phase13e", "spire", "profile"],
      "prefix": "phase13e_spire",
      "index": "phase13e_spire_idx",
      "sweep": [3],
      "require_remote_placements": true,
      "include_remote": true,
      "include_query_metrics": true,
      "include_recall": true,
      "include_production_read_profile": true,
      "remote_tuple_transport": "pg_binary_attr_v1",
      "top_k": 10,
      "query_metric_k": 10,
      "query_metric_projection_columns": ["title"],
      "log_output": "reviews/task-30/970-spire-phase13e-production-read-profile-suite/artifacts/spire-pipeline.log"
    }
  ],
  "thresholds": [
    {
      "name": "production-read-profile-has-dispatches",
      "step": "production-read-profile",
      "metric": "spire-pipeline",
      "filters": {
        "nprobe": "3"
      },
      "field": "dispatch_sum",
      "op": "gte",
      "value": 1
    }
  ]
}
