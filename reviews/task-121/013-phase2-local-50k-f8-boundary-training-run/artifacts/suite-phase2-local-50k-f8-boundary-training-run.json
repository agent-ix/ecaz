{
  "name": "task121-phase2-local-50k-f8-boundary-training-run",
  "schema_version": 1,
  "artifact_dir": "reviews/task-121/013-phase2-local-50k-f8-boundary-training-run/artifacts",
  "defaults": {
    "profile": "ec_spire",
    "bits": 4,
    "seed": 42,
    "queries_limit": 200,
    "iterations": 200,
    "force_index": true,
    "sample_backend_memory": true,
    "memory_sample_interval_ms": 25,
    "pg": 18,
    "socket_dir": "/home/peter/.pgrx"
  },
  "thresholds": [],
  "_doc": {
    "intent": "Task 121 Phase 2 local-only 50k continuation using already-loaded b0/b1 f8 tables to measure training and boundary-replica effects without reloading or running the f16 cells.",
    "scope": "50k f8 continuation: b0/tr50/f8, b1/tr10/f8, b1/tr50/f8. Baseline b0/tr10/f8 is cited from packet 012.",
    "axes": {
      "boundary_replica_count": [
        0,
        1
      ],
      "training_sample_rows": [
        10000,
        50000
      ],
      "recursive_fanout": [
        8
      ],
      "nlists": [
        128
      ],
      "storage_format": [
        "rabitq"
      ],
      "nprobe_sweep": [
        4,
        8,
        12,
        16,
        24,
        32,
        48,
        64,
        96
      ]
    },
    "step_count": 5,
    "cells": 3,
    "prerequisite": "data/staged-current/ec_real_50k_{corpus,queries}.tsv + _manifest.json staged on the Intel local host."
  },
  "steps": [
    {
      "kind": "raw",
      "name": "precheck-host",
      "tags": [
        "setup",
        "precheck",
        "task121",
        "phase2",
        "factorial",
        "intel-local"
      ],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "tqvector_bench_task121",
        "--socket-dir",
        "/home/peter/.pgrx",
        "--raw",
        "--sql",
        "LOAD 'ecaz'; SELECT now() AS captured_at, version() AS postgres_version, ecaz_build_profile() AS ecaz_build_profile, current_setting('ec_spire.nprobe') AS session_nprobe, current_setting('ec_spire.rerank_width') AS session_rerank_width, current_setting('ec_spire.adaptive_nprobe') AS adaptive_nprobe;",
        "--log-output",
        "${artifact_dir}/precheck-host.log"
      ],
      "expected_artifacts": [
        "${artifact_dir}/precheck-host.log"
      ]
    },
    {
      "kind": "recall",
      "name": "truth-cache-50k-q200-k10",
      "tags": [
        "recall",
        "truth-cache",
        "task121",
        "phase2",
        "50k",
        "factorial",
        "baseline"
      ],
      "prefix": "t121_s2_50k_b0_tr10_f8",
      "k": 10,
      "sweep": [
        96
      ],
      "queries_limit": 200,
      "profile": "ec_spire",
      "force_index": true,
      "truth_corpus_file": "data/staged-current/ec_real_50k_corpus.tsv",
      "truth_cache_file": "${artifact_dir}/truth-cache-50k-q200-k10.json",
      "log_output": "${artifact_dir}/truth-cache-50k-q200-k10.log"
    },
    {
      "kind": "spire-pipeline",
      "name": "pipeline-50k_b0_tr50_f8",
      "tags": [
        "pipeline",
        "task121",
        "phase2",
        "factorial",
        "50k",
        "boundary_replica_count=0",
        "training_sample_rows=50000",
        "recursive_fanout=8",
        "storage_format=rabitq"
      ],
      "prefix": "t121_s2_50k_b0_tr50_f8",
      "sweep": [
        4,
        8,
        12,
        16,
        24,
        32,
        48,
        64,
        96
      ],
      "queries_limit": 200,
      "include_query_metrics": true,
      "include_recall": true,
      "include_local_store_overlap": true,
      "include_cost_snapshot": true,
      "truth_corpus_file": "data/staged-current/ec_real_50k_corpus.tsv",
      "truth_cache_file": "${artifact_dir}/truth-cache-50k-q200-k10.json",
