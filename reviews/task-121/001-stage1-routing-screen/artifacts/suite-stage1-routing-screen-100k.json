{
  "name": "task121-stage1-routing-screen-100k",
  "schema_version": 1,
  "artifact_dir": "reviews/task-121/001-stage1-routing-screen/artifacts",
  "defaults": {
    "profile": "ec_spire",
    "bits": 4,
    "seed": 42,
    "queries_limit": 200,
    "iterations": 200,
    "force_index": true,
    "sample_backend_memory": true,
    "memory_sample_interval_ms": 25,
    "pg": 18,
    "socket_dir": "/home/peter/.pgrx"
  },
  "thresholds": [],
  "_doc": {
    "intent": "Task 121 Phase 1 OFAT routing+storage screen at 100k. Baseline = Task 120 config; each non-baseline variant changes exactly ONE build-time lever. Primary metric is route-stage truth containment from the funnel (stage_containment_output), measured across nprobe so routing quality is isolated from overfetch. Each variant is its own isolated table/index (load step builds prefix_corpus + prefix_idx).",
    "baseline_reloptions": "nlists=128, recursive_fanout=8, top_graph_enabled=1, top_graph_degree=32, top_graph_build_list_size=100, top_graph_search_list_size=96, boundary_replica_count=0, training_sample_rows=10000, storage_format=rabitq",
    "run_command": "ecaz bench suite run --config reviews/task-121/001-stage1-routing-screen/artifacts/suite-stage1-routing-screen-100k.json --database tqvector_bench_task121 --host /home/peter/.pgrx --port 28818 --manifest-output reviews/task-121/001-stage1-routing-screen/artifacts/suite-manifest.json --results-output reviews/task-121/001-stage1-routing-screen/artifacts/suite-results.jsonl --log-file reviews/task-121/001-stage1-routing-screen/artifacts/suite-run.log",
    "prerequisite": "data/staged-current/ec_real_100k_{corpus,queries}.tsv + _manifest.json staged on the Intel local host."
  },
