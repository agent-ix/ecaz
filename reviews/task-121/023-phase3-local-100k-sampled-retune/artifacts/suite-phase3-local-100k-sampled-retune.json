{
  "name": "task121-phase3-local-100k-sampled-retune",
  "schema_version": 1,
  "artifact_dir": "reviews/task-121/023-phase3-local-100k-sampled-retune/artifacts",
  "defaults": {
    "profile": "ec_spire",
    "bits": 4,
    "seed": 42,
    "queries_limit": 200,
    "force_index": true,
    "pg": 18,
    "socket_dir": "/tmp"
  },
  "thresholds": [],
  "_doc": {
    "intent": "Task 121 Phase 3 100k recall retune after packets 020-022 showed the initial sampled global pruning policy was too aggressive at 50k but a looser g2048/p4096/r4 policy recovered recall and helped high-nprobe latency.",
    "basis": "Packet 021 established 50k recall neutrality with max_global_blocks=2048/global_probe_blocks=4096/sample_rows=4. This packet scales that policy to 100k with max_global_blocks=4096/global_probe_blocks=8192/sample_rows=4 before spending the longer 100k latency/pipeline run.",
    "fixed_index_shape": {
      "nlists": 128,
      "recursive_fanout": 8,
      "top_graph_enabled": 1,
      "top_graph_degree": 32,
      "top_graph_build_list_size": 100,
      "top_graph_search_list_size": 96,
      "boundary_replica_count": 4,
      "training_sample_rows": 50000,
      "storage_format": "rabitq",
      "leaf_block_rows": 64,
      "leaf_block_summary_representatives": 2
    },
    "retune_policy": {
      "name": "sampled-loose-g4096-p8192-r4",
      "max_global_blocks": 4096,
      "global_probe_blocks": 8192,
      "sample_rows_per_block": 4,
      "sample_summary_prior_weight": 0.8,
      "summary_radius_weight": 0.25,
      "route_prior_weight": 0.0
    },
    "sweep": [48, 64, 96]
  },
  "steps": [
    {
      "kind": "raw",
      "name": "precheck-host",
      "tags": ["setup", "precheck", "task121", "phase3", "100k", "sampled-retune", "intel-local"],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "tqvector_bench_task121",
        "--socket-dir",
        "/tmp",
        "--raw",
        "--sql",
        "LOAD 'ecaz'; SELECT now() AS captured_at, version() AS postgres_version, ecaz_build_profile() AS ecaz_build_profile; SELECT relname FROM pg_class WHERE relname LIKE 't121_s3_100k_b4_tr50_f8_b64%' ORDER BY relname; SELECT name, setting FROM pg_settings WHERE name IN ('ec_spire.leaf_block_rows', 'ec_spire.leaf_block_summary_representatives', 'ec_spire.leaf_block_pruning_max_blocks_per_leaf', 'ec_spire.leaf_block_pruning_max_global_blocks', 'ec_spire.leaf_block_pruning_global_probe_blocks', 'ec_spire.leaf_block_pruning_sample_rows_per_block', 'ec_spire.leaf_block_pruning_sample_summary_prior_weight', 'ec_spire.leaf_block_pruning_summary_radius_weight', 'ec_spire.leaf_block_pruning_route_prior_weight') ORDER BY name;",
        "--log-output",
        "${artifact_dir}/precheck-host.log"
      ],
      "expected_artifacts": ["${artifact_dir}/precheck-host.log"]
    },
    {
      "kind": "load",
      "name": "load-100k_b4_tr50_f8_block64",
      "tags": ["load", "task121", "phase3", "100k", "sampled-retune", "boundary_replica_count=4", "training_sample_rows=50000", "recursive_fanout=8", "storage_format=rabitq", "leaf_block_rows=64"],
      "pgoptions": "-c ec_spire.leaf_block_rows=64 -c ec_spire.leaf_block_summary_representatives=2",
      "prefix": "t121_s3_100k_b4_tr50_f8_b64",
      "index_name": "t121_s3_100k_b4_tr50_f8_b64_idx",
      "dim": 1536,
      "corpus_file": "data/staged-current/ec_real_100k_corpus.tsv",
      "queries_file": "data/staged-current/ec_real_100k_queries.tsv",
      "manifest_file": "data/staged-current/ec_real_100k_manifest.json",
      "allow_manifest_mismatch": true,
      "storage_format": "rabitq",
      "reloptions": ["nlists=128", "recursive_fanout=8", "top_graph_enabled=1", "top_graph_degree=32", "top_graph_build_list_size=100", "top_graph_search_list_size=96", "boundary_replica_count=4", "training_sample_rows=50000"],
      "log_file": "${artifact_dir}/load-100k_b4_tr50_f8_block64.log"
    },
    {
      "kind": "storage",
      "name": "storage-100k_b4_tr50_f8_block64",
      "tags": ["storage", "task121", "phase3", "100k", "sampled-retune", "storage_format=rabitq", "leaf_block_rows=64"],
      "prefix": "t121_s3_100k_b4_tr50_f8_b64",
      "log_file": "${artifact_dir}/storage-100k_b4_tr50_f8_block64.log"
    },
    {
      "kind": "recall",
      "name": "truth-cache-100k-q200-k10",
      "tags": ["recall", "truth-cache", "task121", "phase3", "100k", "sampled-retune"],
      "prefix": "t121_s3_100k_b4_tr50_f8_b64",
      "k": 10,
      "sweep": [96],
      "queries_limit": 200,
      "profile": "ec_spire",
      "force_index": true,
      "truth_corpus_file": "data/staged-current/ec_real_100k_corpus.tsv",
      "truth_cache_file": "${artifact_dir}/truth-cache-100k-q200-k10.json",
      "log_output": "${artifact_dir}/truth-cache-100k-q200-k10.log"
    },
    {
      "kind": "recall",
      "name": "recall-100k_b4_tr50_f8_block64_off",
      "tags": ["recall", "task121", "phase3", "100k", "sampled-retune", "policy=off"],
      "prefix": "t121_s3_100k_b4_tr50_f8_b64",
      "k": 10,
      "sweep": [48, 64, 96],
      "queries_limit": 200,
      "profile": "ec_spire",
      "force_index": true,
      "session_gucs": [
        "ec_spire.leaf_block_pruning_max_blocks_per_leaf=0",
        "ec_spire.leaf_block_pruning_max_global_blocks=0",
        "ec_spire.leaf_block_pruning_global_probe_blocks=0",
        "ec_spire.leaf_block_pruning_sample_rows_per_block=0"
      ],
      "truth_corpus_file": "data/staged-current/ec_real_100k_corpus.tsv",
      "truth_cache_file": "${artifact_dir}/truth-cache-100k-q200-k10.json",
      "log_output": "${artifact_dir}/recall-100k_b4_tr50_f8_block64_off.log"
    },
    {
      "kind": "recall",
      "name": "recall-100k_b4_tr50_f8_block64_sampled_loose_g4096_p8192_r4",
      "tags": ["recall", "task121", "phase3", "100k", "sampled-retune", "policy=sampled-loose-g4096-p8192-r4"],
      "prefix": "t121_s3_100k_b4_tr50_f8_b64",
      "k": 10,
      "sweep": [48, 64, 96],
      "queries_limit": 200,
      "profile": "ec_spire",
      "force_index": true,
      "session_gucs": [
        "ec_spire.leaf_block_pruning_max_blocks_per_leaf=0",
        "ec_spire.leaf_block_pruning_max_global_blocks=4096",
        "ec_spire.leaf_block_pruning_global_probe_blocks=8192",
        "ec_spire.leaf_block_pruning_sample_rows_per_block=4",
        "ec_spire.leaf_block_pruning_sample_summary_prior_weight=0.8",
        "ec_spire.leaf_block_pruning_summary_radius_weight=0.25",
        "ec_spire.leaf_block_pruning_route_prior_weight=0.0"
      ],
      "truth_corpus_file": "data/staged-current/ec_real_100k_corpus.tsv",
      "truth_cache_file": "${artifact_dir}/truth-cache-100k-q200-k10.json",
      "log_output": "${artifact_dir}/recall-100k_b4_tr50_f8_block64_sampled_loose_g4096_p8192_r4.log"
    }
  ]
}
