  "defaults": {
    "profile": "ec_spire",
    "bits": 4,
    "seed": 42,
    "queries_limit": 200,
    "iterations": 200,
    "force_index": true,
    "sample_backend_memory": true,
    "memory_sample_interval_ms": 25,
    "pg": 18,
    "socket_dir": "/home/peter/.pgrx"
  },
  "thresholds": [],
  "_doc": {
    "intent": "Task 121 Phase 2 local-only 10k benchmark run config using the corrected reviewer-requested axis set.",
    "scope": "10k corrected Phase 2 grid: boundary_replica_count x training_sample_rows x recursive_fanout, storage_format=rabitq only, nlists fixed at 128.",
    "axes": {
      "boundary_replica_count": [
        0,
        1,
        2,
        4
      ],
      "training_sample_rows": [
        10000,
        50000
      ],
      "recursive_fanout": [
        8,
        16
      ],
      "nlists": [
        128
      ],
      "storage_format": [
        "rabitq"
      ],
      "nprobe_sweep": [
        4,
        8,
        12,
        16,
        24,
        32,
        48,
        64,
        96
      ]
    },
    "step_count": 50,
    "cells": 16,
    "prerequisite": "data/staged-current/ec_real_10k_{corpus,queries}.tsv + _manifest.json staged on the Intel local host."
  },
