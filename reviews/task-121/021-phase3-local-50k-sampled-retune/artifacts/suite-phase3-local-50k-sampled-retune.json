{
  "name": "task121-phase3-local-50k-sampled-retune",
  "schema_version": 1,
  "artifact_dir": "reviews/task-121/021-phase3-local-50k-sampled-retune/artifacts",
  "defaults": {
    "profile": "ec_spire",
    "bits": 4,
    "seed": 42,
    "queries_limit": 200,
    "force_index": true,
    "pg": 18,
    "socket_dir": "/tmp"
  },
  "thresholds": [],
  "_doc": {
    "intent": "Task 121 Phase 3 retune after packet 020 showed 50k sampled global pruning was too aggressive.",
    "basis": "Packet 020 off policy reached recall 1.0000 at nprobe 48/64/96, while sampled max_global=1024/global_probe=2048/sample_rows=4 stayed at 0.9995 at those checkpoints.",
    "fixed_index": "Reuse packet 020 50k b4/tr50/f8 RaBitQ block-summary index t121_s3_50k_b4_tr50_f8_b64.",
    "retune_policy": {
      "name": "sampled-loose-g2048-p4096-r4",
      "max_global_blocks": 2048,
      "global_probe_blocks": 4096,
      "sample_rows_per_block": 4,
      "sample_summary_prior_weight": 0.8,
      "summary_radius_weight": 0.25,
      "route_prior_weight": 0.0
    },
    "sweep": [48, 64, 96]
  },
  "steps": [
    {
      "kind": "raw",
      "name": "precheck-host",
      "tags": ["setup", "precheck", "task121", "phase3", "50k", "sampled-retune"],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "tqvector_bench_task121",
        "--socket-dir",
        "/tmp",
        "--raw",
        "--sql",
        "LOAD 'ecaz'; SELECT now() AS captured_at, version() AS postgres_version, ecaz_build_profile() AS ecaz_build_profile; SELECT to_regclass('t121_s3_50k_b4_tr50_f8_b64_corpus') AS corpus, to_regclass('t121_s3_50k_b4_tr50_f8_b64_idx') AS idx;",
        "--log-output",
        "${artifact_dir}/precheck-host.log"
      ],
      "expected_artifacts": ["${artifact_dir}/precheck-host.log"]
    },
    {
      "kind": "recall",
      "name": "truth-cache-50k-q200-k10",
      "tags": ["recall", "truth-cache", "task121", "phase3", "50k", "sampled-retune"],
      "prefix": "t121_s3_50k_b4_tr50_f8_b64",
      "k": 10,
      "sweep": [96],
      "queries_limit": 200,
      "profile": "ec_spire",
      "force_index": true,
      "truth_corpus_file": "data/staged-current/ec_real_50k_corpus.tsv",
      "truth_cache_file": "${artifact_dir}/truth-cache-50k-q200-k10.json",
      "log_output": "${artifact_dir}/truth-cache-50k-q200-k10.log"
    },
    {
      "kind": "recall",
      "name": "recall-50k_b4_tr50_f8_block64_sampled_loose_g2048_p4096_r4",
      "tags": ["recall", "task121", "phase3", "50k", "sampled-retune", "policy=sampled-loose-g2048-p4096-r4"],
      "prefix": "t121_s3_50k_b4_tr50_f8_b64",
      "k": 10,
      "sweep": [48, 64, 96],
      "queries_limit": 200,
      "profile": "ec_spire",
      "force_index": true,
      "session_gucs": [
        "ec_spire.leaf_block_pruning_max_blocks_per_leaf=0",
        "ec_spire.leaf_block_pruning_max_global_blocks=2048",
        "ec_spire.leaf_block_pruning_global_probe_blocks=4096",
        "ec_spire.leaf_block_pruning_sample_rows_per_block=4",
        "ec_spire.leaf_block_pruning_sample_summary_prior_weight=0.8",
        "ec_spire.leaf_block_pruning_summary_radius_weight=0.25",
        "ec_spire.leaf_block_pruning_route_prior_weight=0.0"
      ],
      "truth_corpus_file": "data/staged-current/ec_real_50k_corpus.tsv",
      "truth_cache_file": "${artifact_dir}/truth-cache-50k-q200-k10.json",
      "log_output": "${artifact_dir}/recall-50k_b4_tr50_f8_block64_sampled_loose_g2048_p4096_r4.log"
    }
  ]
}
