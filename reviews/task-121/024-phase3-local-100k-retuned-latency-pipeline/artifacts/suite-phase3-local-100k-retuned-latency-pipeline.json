      "prefix": "t121_s3_100k_b4_tr50_f8_b64",
      "k": 10,
      "sweep": [8, 16, 32, 48, 96],
      "concurrency": 1,
      "cache_state": "cache_warm_phase3_100k_retune_off",
      "session_gucs": [
        "ec_spire.leaf_block_pruning_max_blocks_per_leaf=0",
        "ec_spire.leaf_block_pruning_max_global_blocks=0",
        "ec_spire.leaf_block_pruning_global_probe_blocks=0",
        "ec_spire.leaf_block_pruning_sample_rows_per_block=0"
      ],
      "log_output": "${artifact_dir}/latency-100k_b4_tr50_f8_block64_off.log"
    },
    {
      "kind": "latency",
      "name": "latency-100k_b4_tr50_f8_block64_retuned_sampled",
      "tags": ["latency", "task121", "phase3", "100k", "retuned-sampled-pruning", "policy=retuned-sampled-global"],
      "prefix": "t121_s3_100k_b4_tr50_f8_b64",
      "k": 10,
      "sweep": [8, 16, 32, 48, 96],
      "concurrency": 1,
      "cache_state": "cache_warm_phase3_100k_retune_sampled",
      "session_gucs": [
        "ec_spire.leaf_block_pruning_max_blocks_per_leaf=0",
        "ec_spire.leaf_block_pruning_max_global_blocks=4096",
        "ec_spire.leaf_block_pruning_global_probe_blocks=8192",
        "ec_spire.leaf_block_pruning_sample_rows_per_block=4",
        "ec_spire.leaf_block_pruning_sample_summary_prior_weight=0.8",
        "ec_spire.leaf_block_pruning_summary_radius_weight=0.25",
        "ec_spire.leaf_block_pruning_route_prior_weight=0.0"
      ],
      "log_output": "${artifact_dir}/latency-100k_b4_tr50_f8_block64_retuned_sampled.log"
    },
    {
      "kind": "spire-pipeline",
      "name": "pipeline-100k_b4_tr50_f8_block64_off",
      "tags": ["pipeline", "task121", "phase3", "100k", "retuned-sampled-pruning", "policy=off"],
      "prefix": "t121_s3_100k_b4_tr50_f8_b64",
      "sweep": [8, 16, 32, 48, 96],
      "queries_limit": 200,
      "include_query_metrics": true,
      "include_recall": true,
      "include_local_store_overlap": true,
      "include_cost_snapshot": true,
      "truth_corpus_file": "data/staged-current/ec_real_100k_corpus.tsv",
      "truth_cache_file": "${artifact_dir}/truth-cache-100k-q200-k10.json",
      "session_gucs": [
        "ec_spire.leaf_block_pruning_max_blocks_per_leaf=0",
        "ec_spire.leaf_block_pruning_max_global_blocks=0",
        "ec_spire.leaf_block_pruning_global_probe_blocks=0",
        "ec_spire.leaf_block_pruning_sample_rows_per_block=0"
      ],
      "log_output": "${artifact_dir}/pipeline-100k_b4_tr50_f8_block64_off.log"
    },
    {
      "kind": "spire-pipeline",
      "name": "pipeline-100k_b4_tr50_f8_block64_retuned_sampled",
      "tags": ["pipeline", "task121", "phase3", "100k", "retuned-sampled-pruning", "policy=retuned-sampled-global"],
      "prefix": "t121_s3_100k_b4_tr50_f8_b64",
      "sweep": [8, 16, 32, 48, 96],
      "queries_limit": 200,
      "include_query_metrics": true,
      "include_recall": true,
      "include_local_store_overlap": true,
      "include_cost_snapshot": true,
      "truth_corpus_file": "data/staged-current/ec_real_100k_corpus.tsv",
      "truth_cache_file": "${artifact_dir}/truth-cache-100k-q200-k10.json",
      "session_gucs": [
        "ec_spire.leaf_block_pruning_max_blocks_per_leaf=0",
        "ec_spire.leaf_block_pruning_max_global_blocks=4096",
        "ec_spire.leaf_block_pruning_global_probe_blocks=8192",
        "ec_spire.leaf_block_pruning_sample_rows_per_block=4",
        "ec_spire.leaf_block_pruning_sample_summary_prior_weight=0.8",
        "ec_spire.leaf_block_pruning_summary_radius_weight=0.25",
        "ec_spire.leaf_block_pruning_route_prior_weight=0.0"
