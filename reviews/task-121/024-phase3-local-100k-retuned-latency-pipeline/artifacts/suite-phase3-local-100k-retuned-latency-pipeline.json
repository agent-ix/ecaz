      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "tqvector_bench_task121",
        "--socket-dir",
        "/tmp",
        "--raw",
        "--sql",
        "LOAD 'ecaz'; SELECT now() AS captured_at, version() AS postgres_version, ecaz_build_profile() AS ecaz_build_profile; SELECT relname FROM pg_class WHERE relname IN ('t121_s3_100k_b4_tr50_f8_b64_corpus', 't121_s3_100k_b4_tr50_f8_b64_queries', 't121_s3_100k_b4_tr50_f8_b64_idx') ORDER BY relname; SELECT name, setting FROM pg_settings WHERE name IN ('ec_spire.leaf_block_rows', 'ec_spire.leaf_block_summary_representatives', 'ec_spire.leaf_block_pruning_max_blocks_per_leaf', 'ec_spire.leaf_block_pruning_max_global_blocks', 'ec_spire.leaf_block_pruning_global_probe_blocks', 'ec_spire.leaf_block_pruning_sample_rows_per_block', 'ec_spire.leaf_block_pruning_sample_summary_prior_weight', 'ec_spire.leaf_block_pruning_summary_radius_weight', 'ec_spire.leaf_block_pruning_route_prior_weight') ORDER BY name;",
        "--log-output",
        "${artifact_dir}/precheck-host.log"
      ],
      "expected_artifacts": ["${artifact_dir}/precheck-host.log"]
    },
    {
      "kind": "storage",
      "name": "storage-100k_b4_tr50_f8_block64",
      "tags": ["storage", "task121", "phase3", "100k", "retuned-sampled-pruning", "storage_format=rabitq", "leaf_block_rows=64"],
      "prefix": "t121_s3_100k_b4_tr50_f8_b64",
      "log_file": "${artifact_dir}/storage-100k_b4_tr50_f8_block64.log"
    },
    {
      "kind": "recall",
      "name": "truth-cache-100k-q200-k10",
      "tags": ["recall", "truth-cache", "task121", "phase3", "100k", "retuned-sampled-pruning"],
      "prefix": "t121_s3_100k_b4_tr50_f8_b64",
      "k": 10,
      "sweep": [96],
      "queries_limit": 200,
      "profile": "ec_spire",
      "force_index": true,
      "truth_corpus_file": "data/staged-current/ec_real_100k_corpus.tsv",
      "truth_cache_file": "${artifact_dir}/truth-cache-100k-q200-k10.json",
      "log_output": "${artifact_dir}/truth-cache-100k-q200-k10.log"
    },
    {
      "kind": "latency",
      "name": "latency-100k_b4_tr50_f8_block64_off",
