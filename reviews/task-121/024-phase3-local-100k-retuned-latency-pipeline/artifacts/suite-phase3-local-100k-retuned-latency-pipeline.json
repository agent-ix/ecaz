{
  "name": "task121-phase3-local-100k-retuned-latency-pipeline",
  "schema_version": 1,
  "artifact_dir": "reviews/task-121/024-phase3-local-100k-retuned-latency-pipeline/artifacts",
  "defaults": {
    "profile": "ec_spire",
    "bits": 4,
    "seed": 42,
    "queries_limit": 200,
    "iterations": 200,
    "force_index": true,
    "sample_backend_memory": true,
    "memory_sample_interval_ms": 25,
    "pg": 18,
    "socket_dir": "/tmp"
  },
  "thresholds": [],
  "_doc": {
    "intent": "Task 121 Phase 3 100k latency/pipeline A/B for the packet 023 recall-neutral sampled global pruning retune.",
    "scope": "Local PG18 RaBitQ b4/tr50/f8 100k block-summary index from packet 023; compare pruning off against g4096/p8192/r4 sampled pruning across low and high nprobe checkpoints.",
    "reviewer_feedback_addressed": "Packet 022 reviewer asked whether the pruning win lands at the shipped low-nprobe operating point or only in the saturated high-nprobe regime. This suite includes nprobe 8/16/32 as well as 48/96.",
    "fixture": {
      "prefix": "t121_s3_100k_b4_tr50_f8_b64",
      "index": "t121_s3_100k_b4_tr50_f8_b64_idx",
      "storage_format": "rabitq",
      "leaf_block_rows": 64,
      "leaf_block_summary_representatives": 2
    },
    "ab_policy": {
      "off": [
        "ec_spire.leaf_block_pruning_max_blocks_per_leaf=0",
        "ec_spire.leaf_block_pruning_max_global_blocks=0",
        "ec_spire.leaf_block_pruning_global_probe_blocks=0",
        "ec_spire.leaf_block_pruning_sample_rows_per_block=0"
      ],
      "retuned_sampled": [
        "ec_spire.leaf_block_pruning_max_blocks_per_leaf=0",
        "ec_spire.leaf_block_pruning_max_global_blocks=4096",
        "ec_spire.leaf_block_pruning_global_probe_blocks=8192",
        "ec_spire.leaf_block_pruning_sample_rows_per_block=4",
        "ec_spire.leaf_block_pruning_sample_summary_prior_weight=0.8",
        "ec_spire.leaf_block_pruning_summary_radius_weight=0.25",
        "ec_spire.leaf_block_pruning_route_prior_weight=0.0"
      ]
    },
    "sweep": [8, 16, 32, 48, 96]
  },
