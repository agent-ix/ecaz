{
  "name": "task180-100k-bounded-head-attribution-screen-c-caps",
  "schema_version": 1,
  "artifact_dir": "reviews/task-180/002-100k-attribution-screen/artifacts/screen-c-caps",
  "defaults": {
    "pg": 18,
    "socket_dir": "/home/peter/.pgrx"
  },
  "thresholds": [
    {
      "name": "cap-8192-topology",
      "step": "screen-c-cap-8192-100k",
      "metric": "drill_outcome",
      "filters": { "drill": "physical_topology_gate" },
      "field": "pass_numeric",
      "op": "eq",
      "value": 1
    },
    {
      "name": "cap-8192-provenance",
      "step": "screen-c-cap-8192-100k",
      "metric": "physical_benchmark_provenance",
      "field": "unanimous_numeric",
      "op": "eq",
      "value": 1
    },
    {
      "name": "cap-8192-row",
      "step": "screen-c-cap-8192-100k",
      "metric": "physical_benchmark_recall",
      "filters": { "variant": "exact-sample-cap8192-s32", "arm": "physical" },
      "field": "distinct_recall",
      "op": "gte",
      "value": 0.8
    },
    {
      "name": "cap-16384-topology",
      "step": "screen-c-cap-16384-100k",
      "metric": "drill_outcome",
      "filters": { "drill": "physical_topology_gate" },
      "field": "pass_numeric",
      "op": "eq",
      "value": 1
    },
    {
      "name": "cap-16384-provenance",
      "step": "screen-c-cap-16384-100k",
      "metric": "physical_benchmark_provenance",
      "field": "unanimous_numeric",
      "op": "eq",
      "value": 1
    },
    {
      "name": "cap-16384-row",
      "step": "screen-c-cap-16384-100k",
      "metric": "physical_benchmark_recall",
      "filters": { "variant": "exact-sample-cap16384-s32", "arm": "physical" },
      "field": "distinct_recall",
      "op": "gte",
      "value": 0.8
    }
  ],
  "steps": [
    {
      "kind": "distann-local-multinode",
      "name": "screen-c-cap-8192-100k",
      "tags": ["task180", "phase1", "screen-c", "cap-8192", "ec_real_100k"],
      "artifact_dir": "${artifact_dir}/cap-8192-100k",
      "run_dir": "target/task180-screen-c-cap8192",
      "nodes": 3,
      "base_port": 40940,
      "graph_degree": 32,
      "head_index_cap": 8192,
      "beam_width": 4,
      "hop_rounds": 100,
      "queries": 200,
      "top_k": 10,
      "physical_benchmark": true,
      "benchmark_iterations": 50,
      "benchmark_warmup_iterations": 10,
      "skip_fault_drills": true,
      "compact_artifacts": true,
      "benchmark_seed_variants": [
        {
          "name": "exact-sample-cap8192-s32",
          "seed_strategy": "head_sample_exact",
          "head_search_width": 32,
          "head_seed_count": 32,
          "neighbor_score_mode": "rabitq"
        }
      ],
      "corpus_prefix": "ec_real_100k",
      "staged_dir": "/home/peter/dev/ecaz/data/staged-current"
    },
    {
      "kind": "distann-local-multinode",
      "name": "screen-c-cap-16384-100k",
