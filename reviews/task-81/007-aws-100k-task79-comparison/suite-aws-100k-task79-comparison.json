{
  "name": "task81-aws-100k-task79-comparison",
  "schema_version": 1,
  "artifact_dir": "reviews/task-81/007-aws-100k-task79-comparison/artifacts",
  "defaults": {
    "pg": 18,
    "socket_dir": "/var/run/postgresql",
    "bits": 4,
    "seed": 42,
    "profile": "ec_spire",
    "queries_limit": 200,
    "iterations": 200,
    "force_index": true,
    "sample_backend_memory": true,
    "memory_sample_interval_ms": 25
  },
  "steps": [
    {
      "kind": "raw",
      "name": "precheck-host-inputs-and-gucs",
      "tags": ["setup", "precheck", "aws", "graviton", "task81", "task79-comparison", "rabitq", "block16", "tg256"],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "task81_aws",
        "--socket-dir",
        "/var/run/postgresql",
        "--raw",
        "--sql",
        "CREATE EXTENSION IF NOT EXISTS ecaz; SELECT now() AS captured_at, version() AS postgres_version, current_setting('shared_buffers') AS shared_buffers, current_setting('work_mem') AS work_mem, current_setting('maintenance_work_mem') AS maintenance_work_mem, current_setting('effective_cache_size') AS effective_cache_size; SELECT extname, extversion FROM pg_extension WHERE extname = 'ecaz'; SELECT amname FROM pg_am WHERE amname IN ('ec_spire', 'ec_ivf') ORDER BY amname; SELECT pg_stat_file('/var/lib/pgsql/18/datasets/staged-current/ec_real_100k_corpus.tsv') AS corpus_file, pg_stat_file('/var/lib/pgsql/18/datasets/staged-current/ec_real_100k_queries.tsv') AS queries_file, pg_stat_file('/var/lib/pgsql/18/datasets/staged-current/ec_real_100k_manifest.json') AS manifest_file; SELECT name, setting, context FROM pg_settings WHERE name IN ('ec_spire.leaf_block_rows', 'ec_spire.leaf_block_pruning_max_blocks_per_leaf', 'ec_spire.leaf_block_pruning_max_global_blocks', 'ec_spire.leaf_block_pruning_global_probe_blocks', 'ec_spire.leaf_block_pruning_sample_rows_per_block', 'ec_spire.leaf_block_pruning_sample_summary_prior_weight', 'ec_spire.leaf_block_pruning_summary_radius_weight', 'ec_spire.leaf_block_pruning_route_prior_weight', 'ec_spire.max_routing_expansions', 'ec_spire.nprobe', 'ec_spire.rerank_width') ORDER BY name;",
        "--log-output",
        "reviews/task-81/007-aws-100k-task79-comparison/artifacts/precheck-host-inputs-and-gucs.log"
      ],
      "expected_artifacts": ["reviews/task-81/007-aws-100k-task79-comparison/artifacts/precheck-host-inputs-and-gucs.log"]
    },
    {
      "kind": "load",
      "name": "load-100k-spire-rabitq-block16-tg256-b0",
      "tags": ["load", "aws", "graviton", "task81", "task79-comparison", "ec_real_100k", "spire", "rabitq", "block16", "tg256", "b0"],
      "pgoptions": "-c ec_spire.leaf_block_rows=16",
      "prefix": "task81_aws_rabitq_block16_tg256_b0",
      "profile": "ec_spire",
      "corpus_file": "/var/lib/pgsql/18/datasets/staged-current/ec_real_100k_corpus.tsv",
      "queries_file": "/var/lib/pgsql/18/datasets/staged-current/ec_real_100k_queries.tsv",
      "manifest_file": "/var/lib/pgsql/18/datasets/staged-current/ec_real_100k_manifest.json",
      "allow_manifest_mismatch": true,
      "log_file": "reviews/task-81/007-aws-100k-task79-comparison/artifacts/load-100k-spire-rabitq-block16-tg256-b0.log",
      "reloptions": [
        "nlists=128",
        "recursive_fanout=8",
        "nprobe=24",
        "rerank_width=25",
        "storage_format=rabitq",
        "boundary_replica_count=0",
        "top_graph_enabled=1",
        "top_graph_degree=32",
        "top_graph_build_list_size=100",
        "top_graph_search_list_size=256"
      ]
    },
    {
      "kind": "spire-pipeline",
      "name": "pipeline-100k-rabitq-block16-tg256-global1152-nprobe-sweep",
      "tags": ["pipeline", "latency", "recall", "aws", "graviton", "task81", "task79-comparison", "ec_real_100k", "spire", "rabitq", "block16", "tg256", "global1152"],
      "pgoptions": "-c ec_spire.leaf_block_pruning_max_blocks_per_leaf=0 -c ec_spire.leaf_block_pruning_max_global_blocks=1152 -c ec_spire.leaf_block_pruning_global_probe_blocks=0 -c ec_spire.leaf_block_pruning_sample_rows_per_block=0 -c ec_spire.leaf_block_pruning_sample_summary_prior_weight=0.8 -c ec_spire.leaf_block_pruning_summary_radius_weight=0.25 -c ec_spire.leaf_block_pruning_route_prior_weight=0.0",
      "prefix": "task81_aws_rabitq_block16_tg256_b0",
      "index": "task81_aws_rabitq_block16_tg256_b0_idx",
      "queries_limit": 200,
      "sweep": [96, 128],
      "rerank_width": 25,
      "include_local_store_overlap": true,
      "include_cost_snapshot": true,
      "include_query_metrics": true,
      "include_recall": true,
      "truth_corpus_file": "/var/lib/pgsql/18/datasets/staged-current/ec_real_100k_corpus.tsv",
      "include_production_read_profile": true,
      "query_metric_k": 10,
      "query_metric_projection_columns": ["id"],
      "log_output": "reviews/task-81/007-aws-100k-task79-comparison/artifacts/pipeline-100k-rabitq-block16-tg256-global1152-nprobe-sweep.log",
      "funnel_output": "reviews/task-81/007-aws-100k-task79-comparison/artifacts/funnel-100k-rabitq-block16-tg256-global1152-nprobe-sweep.jsonl"
    }
  ]
}
