+fn apply_leaf_block_score_contrast(
+    scored_ranges: &mut [SpireScoredLeafBlockRange],
+    contrast_weight: f64,
+) -> Result<(), String> {
+    if !contrast_weight.is_finite() || !(0.0..=4.0).contains(&contrast_weight) {
+        return Err(
+            "ec_spire.leaf_block_pruning_leaf_contrast_weight must be finite in [0, 4]"
+                .to_owned(),
+        );
+    }
+    if contrast_weight == 0.0 || scored_ranges.len() < 2 {
+        return Ok(());
+    }
+
+    let mean_ip = scored_ranges
+        .iter()
+        .map(|scored_range| f64::from(scored_range.ip))
+        .sum::<f64>()
+        / scored_ranges.len() as f64;
+    for scored_range in scored_ranges {
+        let adjusted_ip =
+            f64::from(scored_range.ip) + (f64::from(scored_range.ip) - mean_ip) * contrast_weight;
+        scored_range.ip = adjusted_ip as f32;
+        if !scored_range.ip.is_finite() {
+            return Err("ec_spire leaf block contrast produced a non-finite score".to_owned());
+        }
+    }
+
+    Ok(())
+}
