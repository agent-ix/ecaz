    {
      "kind": "raw",
      "name": "drop-task79-database",
      "tags": ["setup", "task79", "intel-local"],
      "args": ["dev", "sql", "--pg", "18", "--db", "postgres", "--socket-dir", "/home/peter/.pgrx", "--raw", "--sql", "DROP DATABASE IF EXISTS task79_spire_candidate_surface;", "--log-output", "reviews/task-79/001-candidate-surface-baseline/artifacts/drop-database.log"],
      "expected_artifacts": ["reviews/task-79/001-candidate-surface-baseline/artifacts/drop-database.log"]
    },
