      "allow_manifest_mismatch": true,
      "reloptions": ["nlists=128", "recursive_fanout=8", "nprobe=24", "rerank_width=25", "storage_format=rabitq", "boundary_replica_count=0", "top_graph_enabled=1", "top_graph_degree=32", "top_graph_build_list_size=100", "top_graph_search_list_size=96"],
      "log_file": "reviews/task-79/001-candidate-surface-baseline/artifacts/load-100k-rabitq-n128-f8-tg96.log"
    },
    {
      "kind": "spire-pipeline",
      "name": "pipeline-100k-rabitq-n128-f8-tg96",
      "tags": ["pipeline", "funnel", "task79", "intel-local", "ec_real_100k", "spire", "rabitq", "n128", "f8", "tg96", "baseline", "matched-recall"],
      "prefix": "task79_surface_100k",
      "index": "task79_surface_100k_idx",
      "queries_limit": 200,
      "sweep": [96],
      "rerank_width": 25,
      "include_local_store_overlap": true,
      "include_cost_snapshot": true,
      "include_query_metrics": true,
      "include_recall": true,
      "include_production_read_profile": true,
      "truth_corpus_file": "target/real-corpus/staged-task50/ec_real_100k_corpus.tsv",
