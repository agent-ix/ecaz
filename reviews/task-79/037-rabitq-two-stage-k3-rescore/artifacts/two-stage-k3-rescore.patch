+    fn leaf_block_summary_representative_limit_scores_prefix_only() {
+        let (_gamma, weak_payload) =
+            encode_assignment_payload(SpireAssignmentPayloadFormat::RaBitQ, &[0.0, 1.0]).unwrap();
+        let (_gamma, mid_payload) =
+            encode_assignment_payload(SpireAssignmentPayloadFormat::RaBitQ, &[0.2, 0.0]).unwrap();
+        let (_gamma, strong_payload) =
+            encode_assignment_payload(SpireAssignmentPayloadFormat::RaBitQ, &[1.0, 0.0]).unwrap();
+        let mut encoded_payload = Vec::new();
+        encoded_payload.extend_from_slice(&weak_payload);
+        encoded_payload.extend_from_slice(&mid_payload);
+        encoded_payload.extend_from_slice(&strong_payload);
+        let summary = SpireLeafBlockSummary {
+            row_base: 0,
+            row_count: 2,
+            payload_format: SpireAssignmentPayloadFormat::RaBitQ.tag(),
+            gamma: 0.0,
+            encoded_payload,
+        };
+        let scorer = SpirePreparedAssignmentScorer::prepare(
+            SpireAssignmentPayloadFormat::RaBitQ,
+            2,
+            &[1.0, 0.0],
+        )
+        .unwrap();
+
+        let first_two_ip = score_leaf_block_summary_ip_with_radius_weight_and_representative_limit(
+            &summary,
+            &scorer,
+            0.0,
+            Some(2),
+        )
+        .unwrap();
+        let full_ip = score_leaf_block_summary_ip_with_radius_weight_and_representative_limit(
+            &summary,
+            &scorer,
+            0.0,
+            None,
+        )
+        .unwrap();
+
+        assert!(full_ip > first_two_ip);
+        assert!(
+            score_leaf_block_summary_ip_with_radius_weight_and_representative_limit(
+                &summary,
+                &scorer,
+                0.0,
+                Some(0),
+            )
+            .is_err()
+        );
+    }
