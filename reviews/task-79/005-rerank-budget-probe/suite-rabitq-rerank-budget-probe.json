      "log_output": "reviews/task-79/005-rerank-budget-probe/artifacts/pipeline-100k-rabitq-n512-f16-b0-tg256-row25k-rerank100.log",
      "funnel_output": "reviews/task-79/005-rerank-budget-probe/artifacts/funnel-100k-rabitq-n512-f16-b0-tg256-row25k-rerank100.jsonl"
