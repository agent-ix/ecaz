{
  "name": "task79-rabitq-rerank-budget-probe",
  "schema_version": 1,
  "artifact_dir": "reviews/task-79/005-rerank-budget-probe/artifacts",
  "defaults": {
    "bits": 4,
    "seed": 42,
    "socket_dir": "/home/peter/.pgrx",
    "pg": 18,
    "profile": "ec_spire",
    "queries_limit": 200,
    "iterations": 200,
    "force_index": true,
    "sample_backend_memory": true,
    "memory_sample_interval_ms": 25
  },
  "steps": [
    {
      "kind": "raw",
      "name": "precheck-existing-task79-surface",
      "tags": ["setup", "precheck", "task79", "intel-local"],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "task79_spire_candidate_surface",
        "--socket-dir",
        "/home/peter/.pgrx",
        "--raw",
        "--sql",
        "CREATE EXTENSION IF NOT EXISTS ecaz; SELECT count(*) AS corpus_rows FROM task79_surface_100k_corpus; SELECT count(*) AS query_rows FROM task79_surface_100k_queries; SELECT extname, extversion FROM pg_extension WHERE extname = 'ecaz';",
        "--log-output",
        "reviews/task-79/005-rerank-budget-probe/artifacts/precheck-existing-task79-surface.log"
      ],
      "expected_artifacts": [
        "reviews/task-79/005-rerank-budget-probe/artifacts/precheck-existing-task79-surface.log"
      ]
    },
    {
      "kind": "raw",
      "name": "rebuild-100k-rabitq-n512-f16-b0-tg256",
      "tags": [
        "create-index",
        "task79",
        "intel-local",
        "ec_real_100k",
        "spire",
        "rabitq",
        "n512",
        "f16",
        "b0",
        "tg256",
        "rerank-budget-probe"
      ],
      "args": [
        "dev",
        "sql",
        "--pg",
        "18",
        "--db",
        "task79_spire_candidate_surface",
        "--socket-dir",
        "/home/peter/.pgrx",
        "--raw",
        "--sql",
        "SET client_min_messages TO notice; DROP INDEX IF EXISTS task79_surface_100k_idx; CREATE INDEX task79_surface_100k_idx ON task79_surface_100k_corpus USING ec_spire (embedding ecvector_spire_ip_ops) WITH (nlists = 512, recursive_fanout = 16, nprobe = 24, rerank_width = 25, storage_format = 'rabitq', boundary_replica_count = 0, top_graph_enabled = 1, top_graph_degree = 32, top_graph_build_list_size = 100, top_graph_search_list_size = 256);",
        "--log-output",
        "reviews/task-79/005-rerank-budget-probe/artifacts/rebuild-100k-rabitq-n512-f16-b0-tg256.log"
      ],
      "expected_artifacts": [
        "reviews/task-79/005-rerank-budget-probe/artifacts/rebuild-100k-rabitq-n512-f16-b0-tg256.log"
      ]
    },
    {
      "kind": "spire-pipeline",
      "name": "pipeline-100k-rabitq-n512-f16-b0-tg256-row24k-rerank50",
      "tags": [
        "pipeline",
        "funnel",
        "task79",
        "intel-local",
        "ec_real_100k",
        "spire",
        "rabitq",
        "n512",
        "f16",
        "b0",
        "tg256",
        "row24k",
        "rerank50"
      ],
      "prefix": "task79_surface_100k",
      "index": "task79_surface_100k_idx",
      "queries_limit": 200,
      "sweep": [160, 192],
      "rerank_width": 50,
      "max_routed_candidate_rows": 24000,
      "include_local_store_overlap": true,
      "include_cost_snapshot": true,
      "include_query_metrics": true,
      "include_recall": true,
      "include_production_read_profile": true,
      "truth_corpus_file": "target/real-corpus/staged-task50/ec_real_100k_corpus.tsv",
      "query_metric_k": 10,
      "query_metric_projection_columns": ["id"],
      "log_output": "reviews/task-79/005-rerank-budget-probe/artifacts/pipeline-100k-rabitq-n512-f16-b0-tg256-row24k-rerank50.log",
      "funnel_output": "reviews/task-79/005-rerank-budget-probe/artifacts/funnel-100k-rabitq-n512-f16-b0-tg256-row24k-rerank50.jsonl"
    },
    {
      "kind": "spire-pipeline",
      "name": "pipeline-100k-rabitq-n512-f16-b0-tg256-row24k-rerank100",
