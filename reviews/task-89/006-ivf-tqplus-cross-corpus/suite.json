{
  "name": "task89-ivf-tqplus-cross-corpus",
  "schema_version": 1,
  "artifact_dir": "reviews/task-89/006-ivf-tqplus-cross-corpus/artifacts/suite",
  "defaults": {
    "profile": "ec_ivf",
    "bits": 4,
    "seed": 42,
    "queries_limit": 200,
    "iterations": 200,
    "force_index": true,
    "sample_backend_memory": true,
    "memory_sample_interval_ms": 25
  },
  "steps": [
    {
      "kind": "raw",
      "name": "generate-synth-corpus",
      "args": [
        "corpus",
        "generate",
        "--output",
        "reviews/task-89/006-ivf-tqplus-cross-corpus/artifacts/generated/synth_corpus.tsv",
        "--n",
        "10000",
        "--dim",
        "1536",
        "--seed",
        "8906",
        "--start-id",
        "0",
        "--kind",
        "corpus"
      ],
      "expected_artifacts": [
        "reviews/task-89/006-ivf-tqplus-cross-corpus/artifacts/generated/synth_corpus.tsv"
      ]
    },
    {
      "kind": "raw",
      "name": "generate-synth-queries",
      "args": [
        "corpus",
        "generate",
        "--output",
        "reviews/task-89/006-ivf-tqplus-cross-corpus/artifacts/generated/synth_queries.tsv",
        "--n",
        "200",
        "--dim",
        "1536",
        "--seed",
        "8907",
        "--start-id",
        "1000000",
        "--kind",
        "queries"
      ],
      "expected_artifacts": [
        "reviews/task-89/006-ivf-tqplus-cross-corpus/artifacts/generated/synth_queries.tsv"
      ]
    },
    {
      "kind": "load",
      "name": "load-synth-tq",
      "prefix": "task89_synth10k_ivf_tq",
      "profile": "ec_ivf",
      "corpus_file": "reviews/task-89/006-ivf-tqplus-cross-corpus/artifacts/generated/synth_corpus.tsv",
      "queries_file": "reviews/task-89/006-ivf-tqplus-cross-corpus/artifacts/generated/synth_queries.tsv",
      "dim": 1536,
      "storage_format": "turboquant",
      "reloptions": [
        "nlists=64",
        "nprobe=48"
      ],
      "log_file": "${artifact_dir}/load-synth-tq.log"
    },
    {
      "kind": "load",
      "name": "load-synth-tqplus",
      "prefix": "task89_synth10k_ivf_tqplus",
      "profile": "ec_ivf",
      "corpus_file": "reviews/task-89/006-ivf-tqplus-cross-corpus/artifacts/generated/synth_corpus.tsv",
      "queries_file": "reviews/task-89/006-ivf-tqplus-cross-corpus/artifacts/generated/synth_queries.tsv",
      "dim": 1536,
      "storage_format": "turboquant",
      "reloptions": [
        "nlists=64",
        "nprobe=48",
        "turboquant_calibration=tqplus_experimental"
      ],
      "log_file": "${artifact_dir}/load-synth-tqplus.log"
    },
    {
      "kind": "recall",
      "name": "recall-synth-tq",
      "prefix": "task89_synth10k_ivf_tq",
      "profile": "ec_ivf",
      "k": 10,
      "sweep": [
        16,
        32,
        48,
        64
      ],
      "log_output": "${artifact_dir}/recall-synth-tq.log"
    },
    {
      "kind": "recall",
      "name": "recall-synth-tqplus",
      "prefix": "task89_synth10k_ivf_tqplus",
      "profile": "ec_ivf",
      "k": 10,
      "sweep": [
        16,
        32,
        48,
        64
      ],
      "log_output": "${artifact_dir}/recall-synth-tqplus.log"
    },
    {
      "kind": "latency",
      "name": "latency-synth-tq",
      "prefix": "task89_synth10k_ivf_tq",
      "profile": "ec_ivf",
      "k": 10,
      "concurrency": 1,
      "sweep": [
        16,
        32,
        48,
        64
      ],
      "log_output": "${artifact_dir}/latency-synth-tq.log"
    },
    {
      "kind": "latency",
      "name": "latency-synth-tqplus",
      "prefix": "task89_synth10k_ivf_tqplus",
      "profile": "ec_ivf",
      "k": 10,
      "concurrency": 1,
      "sweep": [
        16,
        32,
        48,
        64
      ],
      "log_output": "${artifact_dir}/latency-synth-tqplus.log"
    },
    {
      "kind": "storage",
      "name": "storage-synth-tq",
      "prefix": "task89_synth10k_ivf_tq",
      "log_file": "${artifact_dir}/storage-synth-tq.log"
    },
    {
      "kind": "storage",
      "name": "storage-synth-tqplus",
      "prefix": "task89_synth10k_ivf_tqplus",
      "log_file": "${artifact_dir}/storage-synth-tqplus.log"
    }
  ]
}
